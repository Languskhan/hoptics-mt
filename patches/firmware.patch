+// Hoptics MT: the kits' sensors sit inside the case and read warm. Settings > SENSORS on the screen
+// stores a correction (tenths of a degree C) in NVS "hoptics"/"envtoff". Apply it to the merged
+// reading, and work out relative humidity again for the corrected temperature (the amount of
+// moisture in the air is the same; warm air just makes it look drier).
+static void hopticsCorrectTemperature(meshtastic_EnvironmentMetrics &em)
+{
+    int16_t off = 0;
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READONLY, &h) != ESP_OK)
+        return;
+    nvs_get_i16(h, "envtoff", &off);
+    nvs_close(h);
+    if (off == 0 || !em.has_temperature)
+        return;
+    const float raw = em.temperature, t = raw + off / 10.0f;
+    if (em.has_relative_humidity && em.relative_humidity > 0) {
+        auto es = [](float c) { return 6.112f * expf(17.62f * c / (243.12f + c)); }; // saturation vapour pressure
+        float rh = em.relative_humidity * es(raw) / es(t);
+        em.relative_humidity = rh > 100.0f ? 100.0f : rh;
+    }
+    em.temperature = t;
+}
+#endif
