--- a/src/Power.cpp
+++ b/src/Power.cpp
@@ -371,6 +371,78 @@ static void battery_adcDisable()
  * A simple battery level sensor that assumes the battery voltage is attached
  * via a voltage-divider to an analog input
  */
+#if defined(HOPTICS_UI) && (defined(HELTEC_V4) || defined(HELTEC_V4_R8) || defined(T_DECK)) && !defined(EXT_PWR_DETECT) &&    \
+    !defined(USB_HOST_PWR_DETECT) && defined(ARDUINO_USB_CDC_ON_BOOT) && ARDUINO_USB_CDC_ON_BOOT
+#define HOPTICS_SMART_VBUS 1
+#include <algorithm>
+#include "HWCDC.h"
+// Hoptics MT: the V4 boards and the T-Deck have no USB-sense pin, so stock firmware says "on USB" whenever the battery
+// reads above full-charge voltage - which a freshly charged cell (or an ADC reading a little high) keeps
+// doing long after the cable is pulled. Instead: a computer on the USB port is seen directly (start-of-frame
+// packets), and its cable being pulled ends "external power" at once. Without a computer only a clear,
+// lasting voltage change counts. Transmitting (LoRa, Wi-Fi) only ever pulls single readings *down*, so the
+// level used is the second-highest of the last 7 readings (one per >= 4 s): it must rise 120 mV above its
+// lowest point for three readings in a row to call it a charger, and fall 60 mV below its highest point to
+// call the charger gone.
+// A wall charger on an already-full battery may therefore show as battery 100% - the safe way round.
+static bool hopticsExternalPower(float mv, float fullMv)
+{
+    (void)fullMv;
+    static bool ext = false, host = false;
+    static float ring[7];
+    static uint8_t count = 0, head = 0, rises = 0;
+    static uint32_t lastPush = 0;
+    static float lowBase = 0, highBase = 0;
+    if (mv <= 0)
+        return ext;
+    if (HWCDC::isPlugged()) {
+        host = true;
+        ext = true;
+        count = 0;
+        return true;
+    }
+    if (host) { // the computer went away: on battery from here
+        host = false;
+        ext = false;
+        count = head = rises = 0;
+        lowBase = highBase = 0;
+    }
+    const uint32_t now = millis();
+    if (count == 0 || now - lastPush >= 4000) {
+        lastPush = now;
+        ring[head] = mv;
+        head = (uint8_t)((head + 1) % 7);
+        if (count < 7)
+            count++;
+        if (count >= 3) {
+            float s[7];
+            for (uint8_t i = 0; i < count; i++)
+                s[i] = ring[i];
+            std::sort(s, s + count);
+            const float base = s[count - 2]; // second-highest: dips are ignored, one odd spike too
+            if (!ext) {
+                if (lowBase == 0 || base < lowBase)
+                    lowBase = base;
+                rises = (base >= lowBase + 120) ? (uint8_t)(rises + 1) : 0;
+                if (rises >= 3) { // held well above where it was: a charger is filling it
+                    ext = true;
+                    highBase = base;
+                    rises = 0;
+                }
+            } else {
+                if (base > highBase)
+                    highBase = base;
+                if (base < highBase - 60) { // sagging from where the charger held it: unplugged
+                    ext = false;
+                    lowBase = base;
+                }
+            }
+        }
+    }
+    return ext;
+}
+#endif
