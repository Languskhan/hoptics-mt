+
+#if defined(HOPTICS_UI)
+static void hopticsSecurityHeaders(HTTPResponse *res)
+{
+    res->setHeader("Cache-Control", "no-store");
+    res->setHeader("X-Content-Type-Options", "nosniff");
+    res->setHeader("X-Frame-Options", "DENY");
+    res->setHeader("Referrer-Policy", "no-referrer");
+}
+
+static void handleHopticsPage(HTTPRequest *req, HTTPResponse *res)
+{
+    if (webServerThread)
+        webServerThread->markActivity();
+    hopticsSecurityHeaders(res);
+    // the page only talks to this node; inline code is ours and renders data with textContent only
+    res->setHeader("Content-Security-Policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
+                                              "connect-src 'self'; img-src 'self' data:; base-uri 'none'; "
+                                              "form-action 'none'; frame-ancestors 'none'");
+    res->setHeader("Content-Type", "text/html; charset=utf-8");
+    res->write((const uint8_t *)HOPTICS_WEB_PAGE, strlen(HOPTICS_WEB_PAGE));
+}
+
+static void handleHopticsJson(HTTPRequest *req, HTTPResponse *res)
+{
+    if (webServerThread)
+        webServerThread->markActivity();
+    hopticsSecurityHeaders(res);
+    std::string snap;
+    if (!hoptics_copy_snapshot(snap)) {
+        res->setStatusCode(503);
+        res->setHeader("Content-Type", "application/json");
+        res->print("{\"error\":\"starting\"}");
+        return;
+    }
+    // deliberately no Access-Control-Allow-Origin: other websites cannot read this from your browser
+    res->setHeader("Content-Type", "application/json");
+    res->write((const uint8_t *)snap.data(), snap.size());
+}
+#endif
