--- a/src/Power.cpp
+++ b/src/Power.cpp
@@ -371,6 +371,52 @@ static void battery_adcDisable()
  * A simple battery level sensor that assumes the battery voltage is attached
  * via a voltage-divider to an analog input
  */
+#if defined(HOPTICS_UI) && (defined(HELTEC_V4) || defined(HELTEC_V4_R8)) && !defined(EXT_PWR_DETECT) &&                       \
+    !defined(USB_HOST_PWR_DETECT) && defined(ARDUINO_USB_CDC_ON_BOOT) && ARDUINO_USB_CDC_ON_BOOT
+#define HOPTICS_SMART_VBUS 1
+#include <algorithm>
+#include "HWCDC.h"
+// Hoptics MT: the V4 boards have no USB-sense pin, so stock firmware says "on USB" whenever the battery
+// reads above full-charge voltage - which a freshly charged cell (or an ADC reading a little high) keeps
+// doing long after the cable is pulled. Instead: a computer on the USB port is seen directly, and its
+// cable being pulled ends "external power" at once; otherwise the voltage trend decides - on a charger it
+// holds or climbs, on battery it sags under load.
+static bool hopticsExternalPower(float mv, float fullMv)
+{
+    static bool started = false, ext = false, hostSeen = false;
+    static float peak = 0, trough = 0;
+    if (mv <= 0)
+        return ext;
+    const bool host = HWCDC::isPlugged();
+    if (host) {
+        hostSeen = true;
+        ext = true;
+        peak = trough = mv;
+    } else if (!started) {
+        ext = mv > fullMv; // first reading: the old rule
+        peak = trough = mv;
+    } else if (hostSeen) {
+        hostSeen = false; // the computer went away
+        ext = false;
+        peak = trough = mv;
+    } else if (ext) {
+        peak = std::max(peak, mv);
+        if (mv < peak - 40) { // fell 40 mV from where the charger held it: unplugged
+            ext = false;
+            trough = mv;
+        }
+    } else {
+        trough = std::min(trough, mv);
+        if (mv > trough + 60) { // rose 60 mV: a charger is filling it
+            ext = true;
+            peak = mv;
+        }
+    }
+    started = true;
+    return ext;
+}
+#endif
+
 class AnalogBatteryLevel : public HasBatteryLevel
 {
   public:
@@ -605,6 +651,9 @@ class AnalogBatteryLevel : public HasBatteryLevel
         // sends no SOF and reads as unplugged. Boards that must spot dumb chargers need a real
         // EXT_PWR_DETECT pin.
         return HWCDC::isPlugged();
+#endif
+#ifdef HOPTICS_SMART_VBUS
+        return hopticsExternalPower(getBattVoltage(), chargingVolt);
 #endif
         return getBattVoltage() > chargingVolt;
     }
