+    if (!hoptics_copy_snapshot(snap)) {
+        res->setStatusCode(503);
+        res->setHeader("Content-Type", "application/json");
+        res->print("{\"error\":\"starting\"}");
+        return;
+    }
+    // deliberately no Access-Control-Allow-Origin: other websites cannot read this from your browser
+    res->setHeader("Content-Type", "application/json");
+    res->write((const uint8_t *)snap.data(), snap.size());
+}
+
+static void handleHopticsRoot(HTTPRequest *req, HTTPResponse *res)
+{
+    hopticsSecurityHeaders(res);
+    res->setStatusCode(302);
+    res->setHeader("Location", "/hoptics");
+    res->setHeader("Content-Type", "text/plain");
+    res->print("Hoptics MT dashboard: /hoptics");
+}
+
+// Dashboard-only server for the colour UI: the page, its JSON and a redirect from "/". Nothing that
+// can change the radio (no /api/v1, no uploads, no reboot), so the radio is safe on a shared network.
+void registerHopticsHandlers(HTTPServer *server)
+{
+    server->registerNode(new ResourceNode("/hoptics", "GET", &handleHopticsPage));
+    server->registerNode(new ResourceNode("/json/hoptics", "GET", &handleHopticsJson));
+    server->registerNode(new ResourceNode("/", "GET", &handleHopticsRoot));
+}
+#endif
