+void HopticsUI::openSettings(void)
+{
+    settingsLoading = true;
+    lv_slider_set_value(setBright, brightness, LV_ANIM_OFF);
+    uint32_t ti = 2;
+    for (uint32_t i = 0; i < sizeof(TIMEOUTS) / sizeof(TIMEOUTS[0]); i++)
+        if (TIMEOUTS[i] == screenTimeout)
+            ti = i;
+    lv_dropdown_set_selected(setTimeout, ti);
+    if (bannerOn)
+        lv_obj_add_state(setBanner, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setBanner, LV_STATE_CHECKED);
+    if (!hasBluetooth)
+        lv_obj_add_state(setBt, LV_STATE_DISABLED);
+    lv_dropdown_set_selected(setThemeDd, (uint32_t)themeIdx);
+    if (webChat)
+        lv_obj_add_state(setWebChatSw, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setWebChatSw, LV_STATE_CHECKED);
+    lv_label_set_text(setBtPin, hasBluetooth ? "Off while you use the touch screen" : "No Bluetooth on this device");
+    lv_dropdown_set_selected(setRegionDd, optIndex(REGIONS, region));
+    lv_dropdown_set_selected(setPresetDd, optIndex(PRESETS, preset));
+    lv_dropdown_set_selected(setRoleDd, optIndex(ROLES, role));
+    const Node *me = findNode(myNode);
+    lv_textarea_set_text(setShort, me ? me->shortName : "");
+    lv_textarea_set_text(setLong, me ? me->longName : "");
+    if (!canShutdown)
+        lv_obj_add_flag(setShutdownBtn, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_remove_flag(setShutdownBtn, LV_OBJ_FLAG_HIDDEN);
+
+    char buf[260], ipbuf[48];
+    if (wifiOn && wifiUp && ipAddr)
+        snprintf(ipbuf, sizeof(ipbuf), "%u.%u.%u.%u", (unsigned)(ipAddr & 0xff), (unsigned)((ipAddr >> 8) & 0xff),
+                 (unsigned)((ipAddr >> 16) & 0xff), (unsigned)(ipAddr >> 24));
+    else
+        snprintf(ipbuf, sizeof(ipbuf), "%s", wifiOn ? "connecting..." : "Wi-Fi off");
+    snprintf(buf, sizeof(buf),
+             "Node: !%08x\nFirmware: Meshtastic %s\nUI: " HOPTICS_NAME " v" HOPTICS_VERSION "\nIP: %s%s\nBattery: %s",
+             (unsigned)myNode, fwVersion[0] ? fwVersion : "?", ipbuf, mqttUp ? "  (MQTT up)" : "",
+             myBattery <= 100 ? (std::to_string(myBattery) + "%  (" + std::to_string(myVoltage).substr(0, 4) + " V)").c_str()
+                              : (myBattery == 101 ? "external power" : "unknown"));
+    lv_label_set_text(setInfo, buf);
+    settingsLoading = false;
+
+    lv_obj_scroll_to_y(lv_obj_get_child(setOv, 1), 0, LV_ANIM_OFF);
+    lv_obj_remove_flag(setOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(setOv, -1);
+    lv_obj_move_to_index(toast, -1);
+}
