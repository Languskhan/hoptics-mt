+// ================================================================= SETTINGS
+void HopticsUI::buildSettingsOverlay(void)
+{
+    setOv = overlayPanel("Settings", nullptr, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->closeSettings(); });
+    lv_obj_t *body = plain(setOv);
+    lv_obj_set_width(body, LV_PCT(100));
+    lv_obj_set_flex_grow(body, 1);
+    lv_obj_add_flag(body, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(body, LV_DIR_VER);
+    lv_obj_set_style_pad_all(body, PAD, 0);
+    column(body, PAD);
+
+    // display
+    lv_obj_t *cd = card(body, "DISPLAY");
+    lv_obj_t *r = settingsRow(cd, "Color theme");
+    setThemeDd = lv_dropdown_create(r);
+    lv_obj_set_width(setThemeDd, LV_PCT(100));
+    lv_dropdown_set_options(setThemeDd, "Midnight (dark)\nDaylight (sunlight)\nNight Red (night vision)\nAmber terminal");
+    styleDropdown(setThemeDd);
+    lv_obj_add_event_cb(
+        setThemeDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int t = (int)lv_dropdown_get_selected(ui->setThemeDd);
+            if (ui->cbs.setTheme)
+                ui->cbs.setTheme(t);
+            // rebuild after this event returns (we are inside a widget that is about to be deleted)
+            lv_async_call([](void *u) { HopticsUI *x = (HopticsUI *)u; x->setTheme(x->pendingTheme); }, ui);
+            ui->pendingTheme = t;
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    r = settingsRow(cd, "Brightness");
+    setBright = lv_slider_create(r);
+    lv_obj_set_width(setBright, LV_PCT(94));
+    lv_obj_set_style_margin_hor(setBright, 6, 0);
+    lv_slider_set_range(setBright, 10, 255);
+    lv_obj_set_style_bg_color(setBright, C_CARD2, LV_PART_MAIN);
+    lv_obj_set_style_bg_color(setBright, C_CYAN, LV_PART_INDICATOR);
+    lv_obj_set_style_bg_color(setBright, C_TEXT, LV_PART_KNOB);
+    lv_obj_add_event_cb(
+        setBright,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->brightness = (uint8_t)lv_slider_get_value(ui->setBright);
+            if (ui->cbs.setBrightness)
+                ui->cbs.setBrightness(ui->brightness);
+        },
+        LV_EVENT_RELEASED, this);
+
+    r = settingsRow(cd, "Screen off after");
+    setTimeout = lv_dropdown_create(r);
+    lv_obj_set_width(setTimeout, LV_PCT(100));
+    lv_dropdown_set_options(setTimeout, TIMEOUT_OPTS);
+    styleDropdown(setTimeout);
+    lv_obj_add_event_cb(
+        setTimeout,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->screenTimeout = TIMEOUTS[lv_dropdown_get_selected(ui->setTimeout)];
+            if (ui->cbs.setScreenTimeout)
+                ui->cbs.setScreenTimeout(ui->screenTimeout);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    lv_obj_t *br = plain(cd);
+    lv_obj_set_size(br, LV_PCT(100), 30);
+    row(br, 6);
+    lv_obj_t *bl = label(br, &F14, C_TEXT, "Message pop-ups");
+    lv_obj_set_flex_grow(bl, 1);
+    setBanner = lv_switch_create(br);
+    lv_obj_set_style_bg_color(setBanner, C_CYAN, (lv_style_selector_t)LV_PART_INDICATOR | LV_STATE_CHECKED);
+    lv_obj_add_event_cb(
+        setBanner,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->bannerOn = lv_obj_has_state(ui->setBanner, LV_STATE_CHECKED);
+            if (ui->cbs.setBanner)
+                ui->cbs.setBanner(ui->bannerOn);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    // identity
+    lv_obj_t *ci = card(body, "IDENTITY");
+    r = settingsRow(ci, "Short name (4 max)");
+    setShort = lv_textarea_create(r);
+    lv_textarea_set_one_line(setShort, true);
+    lv_textarea_set_max_length(setShort, 4);
+    lv_obj_set_width(setShort, LV_PCT(100));
+    styleTextarea(setShort);
+    r = settingsRow(ci, "Long name");
+    setLong = lv_textarea_create(r);
+    lv_textarea_set_one_line(setLong, true);
+    lv_textarea_set_max_length(setLong, 39);
+    lv_obj_set_width(setLong, LV_PCT(100));
+    styleTextarea(setLong);
+    for (lv_obj_t *ta : {setShort, setLong}) {
+        lv_obj_add_event_cb(
+            ta,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                ui->showKeyboard((lv_obj_t *)lv_event_get_current_target(e));
+            },
+            LV_EVENT_CLICKED, this);
+        lv_obj_add_event_cb(
+            ta, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->hideKeyboard(); }, LV_EVENT_READY, this);
+    }
+    lv_obj_t *save = flatButton(ci, LV_SYMBOL_SAVE " Save names", C_CYAN, LV_PCT(100), 34);
+    lv_obj_add_event_cb(
+        save,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            ui->hideKeyboard();
+            const char *s = lv_textarea_get_text(ui->setShort);
+            const char *l = lv_textarea_get_text(ui->setLong);
+            if (!s[0] || !l[0]) {
+                ui->showToast(LV_SYMBOL_WARNING " Both names are needed");
+                return;
+            }
+            if (ui->cbs.saveUser)
+                ui->cbs.saveUser(s, l);
+            ui->showToast(LV_SYMBOL_OK " Names saved");
+        },
+        LV_EVENT_CLICKED, this);
+
+    // radio
+    lv_obj_t *cr = card(body, "RADIO  -  changes reboot the node");
+    r = settingsRow(cr, "Region");
+    setRegionDd = lv_dropdown_create(r);
+    lv_obj_set_width(setRegionDd, LV_PCT(100));
+    lv_dropdown_set_options(setRegionDd, optString(REGIONS).c_str());
+    styleDropdown(setRegionDd);
+    r = settingsRow(cr, "Modem preset");
+    setPresetDd = lv_dropdown_create(r);
+    lv_obj_set_width(setPresetDd, LV_PCT(100));
+    lv_dropdown_set_options(setPresetDd, optString(PRESETS).c_str());
+    styleDropdown(setPresetDd);
+    r = settingsRow(cr, "Device role");
+    setRoleDd = lv_dropdown_create(r);
+    lv_obj_set_width(setRoleDd, LV_PCT(100));
+    lv_dropdown_set_options(setRoleDd, optString(ROLES).c_str());
+    styleDropdown(setRoleDd);
+    lv_obj_add_event_cb(
+        setRegionDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int v = REGIONS[lv_dropdown_get_selected(ui->setRegionDd)].value;
+            if (v != ui->region && ui->cbs.setRegion) {
+                ui->cbs.setRegion(v);
+                ui->showToast(LV_SYMBOL_REFRESH " Region set - rebooting");
+            }
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+    lv_obj_add_event_cb(
+        setPresetDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int v = PRESETS[lv_dropdown_get_selected(ui->setPresetDd)].value;
+            if (v != ui->preset && ui->cbs.setPreset) {
+                ui->cbs.setPreset(v);
+                ui->showToast(LV_SYMBOL_REFRESH " Preset set - rebooting");
+            }
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+    lv_obj_add_event_cb(
+        setRoleDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int v = ROLES[lv_dropdown_get_selected(ui->setRoleDd)].value;
+            if (v != ui->role && ui->cbs.setRole) {
+                ui->cbs.setRole(v);
+                ui->showToast(LV_SYMBOL_REFRESH " Role set - rebooting");
+            }
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    // phone app
+    lv_obj_t *cp = card(body, "PHONE APP");
+    lv_obj_t *btr = plain(cp);
+    lv_obj_set_size(btr, LV_PCT(100), 30);
+    row(btr, 6);
+    lv_obj_t *btl = label(btr, &F14, C_TEXT, LV_SYMBOL_BLUETOOTH " Bluetooth");
+    lv_obj_set_flex_grow(btl, 1);
+    oneLine(btl);
+    // Bluetooth and this screen cannot run together (the firmware hands the radio to the app), so this is a
+    // mode switch with a confirm, not an on/off toggle that silently freezes the screen
+    setBt = flatButton(btr, "Phone mode", C_BLUE, 110, 30);
+    lv_obj_add_event_cb(
+        setBt,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            lv_obj_t *b = (lv_obj_t *)lv_event_get_current_target(e);
+            if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                if (ui->cbs.enterPhoneMode)
+                    ui->cbs.enterPhoneMode();
+                return;
+            }
+            lv_obj_add_state(b, LV_STATE_USER_1);
+            setButtonText(b, "Tap again");
+            lv_timer_t *t = lv_timer_create(
+                [](lv_timer_t *t) {
+                    lv_obj_t *btn = (lv_obj_t *)lv_timer_get_user_data(t);
+                    lv_obj_remove_state(btn, LV_STATE_USER_1);
+                    setButtonText(btn, "Phone mode");
+                },
+                3000, b);
+            lv_timer_set_repeat_count(t, 1);
+        },
+        LV_EVENT_CLICKED, this);
+    setBtPin = label(cp, &F12, C_DIM, "");
+    lv_obj_t *bth = label(cp, FSMALL, C_DIM,
+                          "Phone mode turns Bluetooth on for the Meshtastic app and restarts. The touch screen pauses "
+                          "and shows a PIN; tap Back to touch screen to return. Turns Wi-Fi off.");
+    lv_obj_set_width(bth, LV_PCT(100));
+    lv_label_set_long_mode(bth, LV_LABEL_LONG_MODE_WRAP);
+
+    lv_obj_t *cw = card(body, "WEB PAGE  -  http://<node IP>/hoptics");
+    lv_obj_t *wr = plain(cw);
+    lv_obj_set_size(wr, LV_PCT(100), 30);
+    row(wr, 6);
+    lv_obj_t *wl = label(wr, &F14, C_TEXT, "Show channel chat on web");
+    lv_obj_set_flex_grow(wl, 1);
+    setWebChatSw = lv_switch_create(wr);
+    lv_obj_set_style_bg_color(setWebChatSw, C_CYAN, (lv_style_selector_t)LV_PART_INDICATOR | LV_STATE_CHECKED);
+    lv_obj_add_event_cb(
+        setWebChatSw,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->webChat = lv_obj_has_state(ui->setWebChatSw, LV_STATE_CHECKED);
+            if (ui->cbs.setWebChat)
+                ui->cbs.setWebChat(ui->webChat);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+    lv_obj_t *wh = label(cw, FSMALL, C_DIM,
+                         "Off by default. Direct messages are never shared. The page is read-only and only works on your "
+                         "Wi-Fi; anyone on that network can open it.");
+    lv_obj_set_width(wh, LV_PCT(100));
+    lv_label_set_long_mode(wh, LV_LABEL_LONG_MODE_WRAP);
+
+    // device
+    lv_obj_t *cdv = card(body, "DEVICE");
+    setInfo = label(cdv, &F12, C_TEXT, "");
+    lv_obj_set_width(setInfo, LV_PCT(100));
+    lv_obj_t *acts = plain(cdv);
+    lv_obj_set_size(acts, LV_PCT(100), LV_SIZE_CONTENT);
+    row(acts, PAD);
+    int32_t bw = (W() - 2 * PAD - 16 - PAD) / 2;
+    lv_obj_t *rb = flatButton(acts, LV_SYMBOL_REFRESH " Reboot", C_AMBER, bw, 36);
+    setShutdownBtn = flatButton(acts, LV_SYMBOL_POWER " Off", C_RED, bw, 36);
+    // two-tap confirm: first tap arms the button for 3 s
+    lv_obj_add_event_cb(
+        rb,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            lv_obj_t *b = (lv_obj_t *)lv_event_get_current_target(e);
+            if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                if (ui->cbs.reboot)
+                    ui->cbs.reboot();
+                setButtonText(b, "Rebooting...");
+                return;
+            }
+            lv_obj_add_state(b, LV_STATE_USER_1);
+            setButtonText(b, "Tap again");
+            lv_timer_t *t = lv_timer_create(
+                [](lv_timer_t *t) {
+                    lv_obj_t *btn = (lv_obj_t *)lv_timer_get_user_data(t);
+                    lv_obj_remove_state(btn, LV_STATE_USER_1);
+                    setButtonText(btn, LV_SYMBOL_REFRESH " Reboot");
+                },
+                3000, b);
+            lv_timer_set_repeat_count(t, 1);
+        },
+        LV_EVENT_CLICKED, this);
+    lv_obj_add_event_cb(
+        setShutdownBtn,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            lv_obj_t *b = (lv_obj_t *)lv_event_get_current_target(e);
+            if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                if (ui->cbs.shutdown)
+                    ui->cbs.shutdown();
+                setButtonText(b, "Bye...");
+                return;
+            }
+            lv_obj_add_state(b, LV_STATE_USER_1);
+            setButtonText(b, "Tap again");
+            lv_timer_t *t = lv_timer_create(
+                [](lv_timer_t *t) {
+                    lv_obj_t *btn = (lv_obj_t *)lv_timer_get_user_data(t);
+                    lv_obj_remove_state(btn, LV_STATE_USER_1);
+                    setButtonText(btn, LV_SYMBOL_POWER " Off");
+                },
+                3000, b);
+            lv_timer_set_repeat_count(t, 1);
+        },
+        LV_EVENT_CLICKED, this);
+
+    lv_obj_t *about = label(body, FSMALL, C_DIM, HOPTICS_NAME " v" HOPTICS_VERSION "  -  GPL-3.0\nBuilt on Meshtastic device-ui");
+    lv_obj_set_width(about, LV_PCT(100));
+    lv_obj_set_style_text_align(about, LV_TEXT_ALIGN_CENTER, 0);
+}
