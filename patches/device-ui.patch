+// ================================================================= PROBLEM REPORTS
+// A QR code that opens a GitHub bug report with the firmware, board, crash summary and memory
+// numbers filled in. Nothing is sent from the radio: the person scans it and decides.
+void HopticsUI::buildReportOverlay(void)
+{
+    repOv = overlayPanel("Report a problem", &repTitle,
+                         [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->closeReport(); });
+    lv_obj_t *body = plain(repOv);
+    lv_obj_set_width(body, LV_PCT(100));
+    lv_obj_set_flex_grow(body, 1);
+    // portrait: code on top, text under it, all scrolling. Landscape: the code needs the full screen height
+    // to keep 3 px squares (version 14 is 73 squares), so the header goes and the code fills the left side;
+    // back button, title and text share the narrow column on the right, which scrolls.
+    lv_obj_t *col = body;
+    if (LAND) {
+        lv_obj_add_flag(lv_obj_get_child(repOv, 0), LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_flex_flow(body, LV_FLEX_FLOW_ROW);
+    } else {
+        lv_obj_add_flag(body, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_scroll_dir(body, LV_DIR_VER);
+        lv_obj_set_style_pad_bottom(body, PAD, 0);
+        column(body, PAD);
+    }
+
+    // the code itself: always black on white, full width, so phones read it in every theme
+    lv_obj_t *qbox = plain(body);
+    lv_obj_set_size(qbox, LAND ? H() - 4 : LV_PCT(100), LAND ? H() : W()); // the code keeps a white margin all round
+    if (!LAND)
+        stop(qbox); // read-only stops: keys scroll from the code down to the text
+    lv_obj_set_style_bg_color(qbox, lv_color_white(), 0);
+    lv_obj_set_style_bg_opa(qbox, LV_OPA_COVER, 0);
+    repQr = lv_qrcode_create(qbox);
+    lv_qrcode_set_size(repQr, (LAND ? H() : W()) - 18); // 3 px squares up to version 14 (~360 bytes)
+    lv_qrcode_set_dark_color(repQr, lv_color_black());
+    lv_qrcode_set_light_color(repQr, lv_color_white());
+    lv_obj_center(repQr);
+    if (LAND) {
+        col = plain(body);
+        lv_obj_set_height(col, LV_PCT(100));
+        lv_obj_set_flex_grow(col, 1);
+        lv_obj_add_flag(col, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_scroll_dir(col, LV_DIR_VER);
+        lv_obj_set_style_pad_all(col, PAD, 0);
+        column(col, PAD);
+        lv_obj_t *back = flatButton(col, LV_SYMBOL_LEFT " Back", C_CYAN, LV_PCT(100), 30);
+        stop(back);
+        lv_obj_add_event_cb(
+            back, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->closeReport(); }, LV_EVENT_CLICKED, this);
+        repTitle = label(col, &F12, C_TEXT, "Report a problem");
+        lv_obj_set_width(repTitle, LV_PCT(100));
+        lv_label_set_long_mode(repTitle, LV_LABEL_LONG_MODE_WRAP);
+    }
+    repScroll = col;
+
+    // what happened, right under the code (only when there is a crash on record)
+    repBanner = plain(col);
+    lv_obj_set_size(repBanner, LV_PCT(100), LV_SIZE_CONTENT);
+    lv_obj_set_style_bg_color(repBanner, C_RED, 0);
+    lv_obj_set_style_bg_opa(repBanner, LV_OPA_20, 0);
+    lv_obj_set_style_border_side(repBanner, LV_BORDER_SIDE_LEFT, 0);
+    lv_obj_set_style_border_width(repBanner, 4, 0);
+    lv_obj_set_style_border_color(repBanner, C_RED, 0);
+    lv_obj_set_style_pad_all(repBanner, LAND ? 4 : 6, 0);
+    lv_obj_set_style_pad_left(repBanner, LAND ? 6 : 9, 0);
+    repBannerText = label(repBanner, LAND ? FSMALL : &F12, C_TEXT, ""); // landscape: the column is narrow
+    lv_obj_set_width(repBannerText, LV_PCT(100));
+    lv_label_set_long_mode(repBannerText, LV_LABEL_LONG_MODE_WRAP);
+
+    lv_obj_t *tb = plain(col);
+    stop(tb);
+    lv_obj_set_size(tb, LV_PCT(100), LV_SIZE_CONTENT);
+    lv_obj_set_style_pad_hor(tb, LAND ? 0 : PAD + 2, 0);
+    column(tb, PAD);
+    lv_obj_t *how = label(tb, LAND ? FSMALL : &F12, C_TEXT,
+                          "Point your phone camera at the code. It opens a bug report on GitHub with these details "
+                          "filled in. Add what you were doing, then submit.");
+    lv_obj_set_width(how, LV_PCT(100));
+    lv_label_set_long_mode(how, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_t *alt = label(tb, LAND ? FSMALL : &F12, C_MUTED,
+                          "No GitHub account? Take a photo of this screen and send it to whoever gave you the firmware.");
+    lv_obj_set_width(alt, LV_PCT(100));
+    lv_label_set_long_mode(alt, LV_LABEL_LONG_MODE_WRAP);
+    repText = label(tb, FSMALL, C_MUTED, "");
+    lv_obj_set_width(repText, LV_PCT(100));
+    lv_label_set_long_mode(repText, LV_LABEL_LONG_MODE_WRAP);
+    repClearBtn = flatButton(tb, LAND ? LV_SYMBOL_TRASH " Clear" : LV_SYMBOL_TRASH " Clear crash record", C_AMBER,
+                             LAND ? LV_PCT(100) : W() - 2 * PAD - 4, 34);
+    stop(repClearBtn);
+    lv_obj_add_event_cb(
+        repClearBtn,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            hoptics::Report::get().clearCrash();
+            ui->openReport(false);
+            ui->showToast("Crash record cleared");
+        },
+        LV_EVENT_CLICKED, this);
+}
