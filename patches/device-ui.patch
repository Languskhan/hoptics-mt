+            r.row,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                uint32_t num = (uint32_t)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                if (num)
+                    ui->openNode(num);
+            },
+            LV_EVENT_CLICKED, this);
+        lv_obj_add_flag(r.row, LV_OBJ_FLAG_HIDDEN);
