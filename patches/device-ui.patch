+void HopticsUI::showCrashReportIfAny(void)
+{
+    if (crashShown || !repOv || !hoptics::Report::get().freshCrash())
+        return;
+    if (wizOv && !lv_obj_has_flag(wizOv, LV_OBJ_FLAG_HIDDEN))
+        return; // first-time setup comes first; the crash stays under Settings > DEVICE
+    crashShown = true;
+    openReport(true);
+}
+
+// ================================================================= KEYS
+// Keyboard and trackball navigation: T-Deck Plus (keyboard + trackball), ThinkNode M9 (keyboard), and any
+// board with an LVGL keypad or encoder input device. Everything a finger can do, keys can do.
+//
+// What Hoptics does with the LVGL keys it receives:
+//   NEXT / PREV ............ next / previous control (LVGL moves the focus; the M9 input policy sends
+//                            these for DOWN / UP unless setKeyContext says otherwise)
+//   UP / DOWN .............. previous / next control; scroll a focused message list; move in an open list
+//   LEFT / RIGHT ........... main screen: previous / next tab. On a screen on top (chat, node, settings...):
+//                            LEFT goes back; in the setup wizard LEFT / RIGHT step back / forward.
+//                            Text fields move the cursor, sliders change, a panning map moves.
+//   ENTER .................. press the focused control (open a row, toggle a switch, open a list, send)
+//   ESC, BACKSPACE outside a text field ... back: close the screen on top, or go to Home
+//   letters on the main screen: h l m c n s = Home Live Map Chat Nodes Stats; in a chat: start typing
+// Encoders (the T-Deck trackball): turning (trackball up/down) moves the focus, press is ENTER. The stock
+// T-Deck trackball driver sends left/right as LV_KEY_DOWN / LV_KEY_UP keys, so from an encoder those two
+// mean LEFT / RIGHT here. Lists, sliders, text fields and the message list use LVGL's edit mode (press,
+// turn, press again); in the message field that second press sends.
+// Map: focus it and press ENTER to pan (arrows / trackball; + and - zoom); ENTER or ESC stops.
+// Dedicated keys (M9 Home / Chat / Map / Preset) arrive through keyCommand().
+//
+// The group only ever holds the controls of what is on top (keyScope), so focus can't wander behind an
+// overlay. Focus shows as a ring in the theme's text colour in LV_STATE_FOCUS_KEY, which LVGL sets only
+// when a keypad or encoder moved the focus, so touch never shows it; amber while editing (applyFocusStyles).
+bool HopticsUI::hasKeypad(void) const
+{
+    return anyIndev(LV_INDEV_TYPE_KEYPAD);
+}
+
+void HopticsUI::keysInit(void)
+{
+    bool keys = false;
+    for (lv_indev_t *in = lv_indev_get_next(nullptr); in; in = lv_indev_get_next(in))
+        keys |= isKeyIndev(in);
+    touchInput = !keys || anyIndev(LV_INDEV_TYPE_POINTER);
+    if (!keys)
+        return; // touch only: LVGL's group handling stays exactly as it was
+    if (!keysOn) {
+        keysOn = true;
+        keyGroup = lv_group_get_default(); // the input drivers usually made it already
+        if (!keyGroup) {
+            keyGroup = lv_group_create();
+            lv_group_set_default(keyGroup);
+        }
+        lv_group_set_wrap(keyGroup, true);
+        lv_group_set_user_data(keyGroup, this);
+        lv_group_set_focus_cb(keyGroup, [](lv_group_t *g) { ((HopticsUI *)lv_group_get_user_data(g))->updateKeyContext(); });
+    }
+    applyFocusStyles();
+    attachKeyInputs();
+}
+
+void HopticsUI::attachKeyInputs(void)
+{
+    for (lv_indev_t *in = lv_indev_get_next(nullptr); in; in = lv_indev_get_next(in)) {
+        // whatever order the input drivers and the UI start in, every keypad and encoder ends up on our group
+        if (isKeyIndev(in) && lv_indev_get_group(in) != keyGroup)
+            lv_indev_set_group(in, keyGroup);
+        // a touch (T-Deck Plus) means keys are not in use any more: the ring goes until the next key
+        if (lv_indev_get_type(in) == LV_INDEV_TYPE_POINTER && std::find(touchHooked.begin(), touchHooked.end(), in) == touchHooked.end()) {
+            touchHooked.push_back(in);
+            lv_indev_add_event_cb(
+                in,
+                [](lv_event_t *e) {
+                    HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                    ui->keyActive = false;
+                    if (lv_obj_t *f = ui->keyGroup ? lv_group_get_focused(ui->keyGroup) : nullptr)
+                        lv_obj_remove_state(f, LV_STATE_FOCUS_KEY);
+                },
+                LV_EVENT_PRESSED, this);
+        }
+    }
+}
+
+void HopticsUI::inputDevicesChanged(void)
+{
+    const bool was = keysOn;
+    keysInit();
+    if (keysOn && !was) {
+        focusMemo.clear();
+        scopeStops.clear();
+        keyScope();
+    } else if (keysOn)
+        attachKeyInputs();
+}
+
+void HopticsUI::stop(lv_obj_t *o)
+{
+    lv_obj_add_flag(o, F_STOP);
+}
+
+void HopticsUI::wireStop(lv_obj_t *o)
+{
+    if (lv_obj_has_flag(o, F_WIRED))
+        return;
+    lv_obj_add_flag(o, F_WIRED);
+    lv_obj_add_flag(o, LV_OBJ_FLAG_SCROLL_ON_FOCUS); // buttons have it; rows and read-only cards need it too
+    if (lv_obj_check_type(o, &lv_slider_class)) {
+        lv_obj_add_style(o, &ST_FOCUS_OUT, (lv_style_selector_t)LV_PART_KNOB | LV_STATE_FOCUS_KEY);
+        lv_obj_add_style(o, &ST_EDIT_OUT, (lv_style_selector_t)LV_PART_KNOB | LV_STATE_EDITED);
+        lv_obj_set_style_outline_width(o, 0, LV_STATE_FOCUS_KEY); // not the theme's ring round the track as well
+        lv_obj_set_style_outline_width(o, 0, LV_STATE_EDITED);
+        // the knob is drawn in the text colour too: leave a gap so the ring reads as a ring
+        lv_obj_set_style_outline_pad(o, 2, (lv_style_selector_t)LV_PART_KNOB | LV_STATE_FOCUS_KEY);
+        lv_obj_set_style_outline_pad(o, 2, (lv_style_selector_t)LV_PART_KNOB | LV_STATE_EDITED);
+    } else {
+        const bool out = lv_obj_check_type(o, &lv_switch_class);
+        lv_obj_add_style(o, out ? &ST_FOCUS_OUT : &ST_FOCUS, LV_STATE_FOCUS_KEY);
+        lv_obj_add_style(o, out ? &ST_EDIT_OUT : &ST_EDIT, LV_STATE_EDITED);
+    }
+    // the ring can reach outside the control: make sure LVGL redraws that margin when the focus comes and goes
+    lv_obj_add_event_cb(
+        o, [](lv_event_t *e) { lv_obj_refresh_ext_draw_size((lv_obj_t *)lv_event_get_current_target(e)); },
+        LV_EVENT_STATE_CHANGED, nullptr);
+    // before the widget's own key handling, so back / tab keys win over e.g. a switch toggling on LEFT
+    lv_obj_add_event_cb(
+        o, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->onKey(e); },
+        (lv_event_code_t)(LV_EVENT_KEY | LV_EVENT_PREPROCESS), this);
+    if (lv_obj_check_type(o, &lv_dropdown_class)) {
+        // an open list wants UP / DOWN for itself
+        auto ctx = [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->updateKeyContext(); };
+        lv_obj_add_event_cb(o, ctx, LV_EVENT_READY, this);
+        lv_obj_add_event_cb(o, ctx, LV_EVENT_CANCEL, this);
+    }
+}
+
+lv_obj_t *HopticsUI::topOverlay(void) const
+{
+    if (!mainScreen)
+        return nullptr;
+    // the overlays are children of the main screen; the visible one nearest the top wins
+    for (int32_t i = (int32_t)lv_obj_get_child_count(mainScreen) - 1; i >= 0; i--) {
+        lv_obj_t *c = lv_obj_get_child(mainScreen, i);
+        if (lv_obj_has_flag(c, LV_OBJ_FLAG_HIDDEN))
+            continue;
+        if (c == chatOv || c == nodeOv || c == envOv || c == setOv || c == repOv || c == wizOv)
+            return c;
+    }
+    return nullptr;
+}
+
+void HopticsUI::keyFocus(lv_obj_t *o, bool ring)
+{
+    if (!o)
+        return;
+    lv_group_focus_obj(o);
+    // focus moved by the program (not inside a key event): keep the ring if keys were in use
+    if ((ring || keyActive) && !lv_obj_has_state(o, LV_STATE_FOCUS_KEY))
+        lv_obj_add_state(o, LV_STATE_FOCUS_KEY);
+}
+
+void HopticsUI::keyScope(lv_obj_t *prefer)
+{
+    if (!keysOn || !keyGroup)
+        return;
+    attachKeyInputs();
+    std::vector<lv_obj_t *> stops, last;
+    lv_obj_t *root = nullptr;
+    if (phoneScreen && lv_screen_active() == phoneScreen) {
+        root = phoneScreen;
+        collectStops(phoneScreen, stops, last);
+    } else if (mainScreen) {
+        lv_obj_t *ov = topOverlay();
+        if (keyboard && !lv_obj_has_flag(keyboard, LV_OBJ_FLAG_HIDDEN)) {
+            root = keyboard; // on-screen keyboard (only shown without a hardware keyboard)
+            stops.push_back(keyboard);
+        } else if (ov) {
+            root = ov;
+            collectStops(ov, stops, last);
+        } else {
+            // main screen: the page first, then the settings gear, then the tabs
+            root = pages[activeTab];
+            collectStops(pages[activeTab], stops, last);
+            if (statusGear)
+                stops.push_back(statusGear);
+            collectStops(navBar, stops, last);
+        }
+    }
+    stops.insert(stops.end(), last.begin(), last.end());
+
+    lv_obj_t *old = lv_group_get_focused(keyGroup);
+    const bool ring = old && lv_obj_has_state(old, LV_STATE_FOCUS_KEY);
+    auto has = [&](lv_obj_t *o) { return o && std::find(stops.begin(), stops.end(), o) != stops.end(); };
+
+    if (stops != scopeStops || lv_group_get_obj_count(keyGroup) != stops.size()) {
+        if (old && scopeRoot) {
+            // remember where we were, to come back to it
+            auto m = std::find_if(focusMemo.begin(), focusMemo.end(), [&](const auto &p) { return p.first == scopeRoot; });
+            if (m != focusMemo.end())
+                m->second = old;
+            else
+                focusMemo.emplace_back(scopeRoot, old);
+        }
+        lv_group_set_editing(keyGroup, false);
+        lv_group_remove_all_objs(keyGroup);
+        lv_group_focus_freeze(keyGroup, true); // adding must not focus (and scroll to) the first control
+        for (lv_obj_t *o : stops) {
+            wireStop(o);
+            lv_group_add_obj(keyGroup, o);
+        }
+        lv_group_focus_freeze(keyGroup, false);
+        scopeStops = stops;
+    } else if (!prefer && root == scopeRoot) {
+        updateKeyContext(); // same controls, focus stays where it is
+        return;
+    }
+
+    // where the focus goes: the caller's pick; else, on the same screen, where it was; else where it was
+    // when this screen was last left; else its first control
+    lv_obj_t *target = nullptr;
+    if (has(prefer) && shown(prefer))
+        target = prefer;
+    if (!target && root == scopeRoot && has(old) && shown(old))
+        target = old;
+    if (!target && root != scopeRoot)
+        for (const auto &m : focusMemo)
+            if (m.first == root && has(m.second) && shown(m.second))
+                target = m.second;
+    for (size_t i = 0; !target && i < stops.size(); i++)
+        if (shown(stops[i]))
+            target = stops[i];
+    scopeRoot = root;
+    if (target)
+        keyFocus(target, ring);
+    updateKeyContext();
+}
+
+void HopticsUI::keyNext(void)
+{
+    if (!keysOn || !keyGroup)
+        return;
+    lv_group_focus_next(keyGroup);
+    // this runs on the key press: the release must not click the control that has the focus now
+    if (lv_indev_t *in = lv_indev_active())
+        lv_indev_wait_release(in);
+}
+
+void HopticsUI::updateKeyContext(void)
+{
+    if (!keyGroup)
+        return;
+    if (lv_indev_t *in = lv_indev_active())
+        keyActive = isKeyIndev(in); // the focus just moved: by a key or trackball, or by a touch
+    lv_obj_t *f = lv_group_get_focused(keyGroup);
+    int c = KC_NAVIGATE;
+    if (f && lv_obj_check_type(f, &lv_dropdown_class) && lv_dropdown_is_open(f))
+        c = KC_LIST_OPEN;
+    else if (f && f == mapArea && mapPan)
+        c = KC_MAP;
+    else if (f && f == chatMsgs)
+        c = KC_SCROLL;
+    if (f != mapArea && mapPan)
+        setMapPan(false);
+    if (c != keyCtx) {
+        keyCtx = c;
+        if (cbs.setKeyContext)
+            cbs.setKeyContext(c);
+    }
+}
+
+void HopticsUI::goBack(void)
+{
+    if (keyboard && !lv_obj_has_flag(keyboard, LV_OBJ_FLAG_HIDDEN)) {
+        hideKeyboard();
+        keyScope();
+        return;
+    }
+    lv_obj_t *ov = topOverlay();
+    if (ov == chatOv)
+        closeChat();
+    else if (ov == nodeOv)
+        closeNode();
+    else if (ov == envOv)
+        closeEnv();
+    else if (ov == setOv)
+        closeSettings();
+    else if (ov == repOv)
+        closeReport();
+    else if (ov == wizOv) {
+        if (wizStep > 0)
+            wizardStep(wizStep - 1); // the wizard is only left with Skip or Finish
+    } else if (activeTab != T_HOME)
+        selectTab(T_HOME);
+}
+
+void HopticsUI::stepTab(int dir)
+{
+    lv_obj_t *f = keyGroup ? lv_group_get_focused(keyGroup) : nullptr;
+    const bool onTabs = f && lv_obj_get_parent(f) == navBar;
+    const Tab t = (Tab)((activeTab + dir + T_COUNT) % T_COUNT);
+    selectTab(t);
+    if (onTabs)
+        keyScope(navBtns[t]); // browsing the tabs: stay on them
+}
+
+void HopticsUI::keyCommand(KeyCommand c)
+{
+    if (!mainScreen || inPhoneMode())
+        return;
+    if (c == KEY_BACK) {
+        goBack();
+        return;
+    }
+    if (wizOv && !lv_obj_has_flag(wizOv, LV_OBJ_FLAG_HIDDEN))
+        return; // first-time setup is finished (or skipped) on its own page
+    // jump straight there from anywhere
+    hideKeyboard();
+    if (!lv_obj_has_flag(chatOv, LV_OBJ_FLAG_HIDDEN) && c != KEY_COMPOSE)
+        closeChat();
+    if (!lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN))
+        closeNode();
+    closeEnv();
+    if (!lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN))
+        closeSettings();
+    if (repOv && !lv_obj_has_flag(repOv, LV_OBJ_FLAG_HIDDEN))
+        closeReport();
+    switch (c) {
+    case KEY_CHATS:
+        selectTab(T_CHAT);
+        break;
+    case KEY_MAP:
+        selectTab(T_MAP);
+        break;
+    case KEY_COMPOSE: // write on the primary channel
+        selectTab(T_CHAT);
+        openChat(0);
+        keyScope(chatInput);
+        break;
+    default:
+        selectTab(T_HOME);
+        break;
+    }
+}
+
+void HopticsUI::onKey(lv_event_t *e)
+{
+    lv_obj_t *obj = (lv_obj_t *)lv_event_get_current_target(e);
+    const uint32_t raw = lv_event_get_key(e);
+    uint32_t k = raw;
+    lv_indev_t *in = lv_indev_active();
+    const bool enc = in && lv_indev_get_type(in) == LV_INDEV_TYPE_ENCODER;
+    const bool editing = keyGroup && lv_group_get_editing(keyGroup);
+    const bool isText = lv_obj_check_type(obj, &lv_textarea_class);
+    const bool isSlider = lv_obj_check_type(obj, &lv_slider_class);
+    const bool isScroll = obj == chatMsgs;
+    const bool onMain = !topOverlay() && (!keyboard || lv_obj_has_flag(keyboard, LV_OBJ_FLAG_HIDDEN)) && !inPhoneMode();
+    auto done = [&]() { lv_event_stop_processing(e); };
+
+    if (obj == mapArea && mapPan) {
+        if (k == LV_KEY_ESC || k == LV_KEY_BACKSPACE || (k == LV_KEY_ENTER && !enc)) {
+            setMapPan(false);
+            if (k == LV_KEY_ENTER && in)
+                lv_indev_wait_release(in); // or the release would click it straight back into panning
+        } else
+            mapPanKey(k, enc);
+        done();
+        return;
+    }
+    if (lv_obj_check_type(obj, &lv_dropdown_class) && lv_dropdown_is_open(obj))
+        return; // an open list: UP / DOWN / ENTER / ESC belong to it
+    if (enc && editing)
+        return; // trackball edit mode: turns and keys belong to the widget
+    if (enc) {  // trackball left / right (see the key map above)
+        if (k == LV_KEY_UP)
+            k = LV_KEY_RIGHT;
+        else if (k == LV_KEY_DOWN)
+            k = LV_KEY_LEFT;
+    }
+
+    switch (k) {
+    case LV_KEY_ENTER:
+        return;
+    case LV_KEY_ESC:
+        goBack();
+        done();
+        return;
+    case LV_KEY_BACKSPACE:
+        if (isText)
+            return;
+        goBack();
+        done();
+        return;
+    case LV_KEY_UP:
+    case LV_KEY_DOWN: // keypad only (an encoder's were turned into LEFT / RIGHT above)
+        if (isScroll && (k == LV_KEY_UP ? lv_obj_get_scroll_top(obj) > 0 : lv_obj_get_scroll_bottom(obj) > 0))
+            return; // LVGL scrolls it; at the end the keys move on
+        if (k == LV_KEY_UP)
+            lv_group_focus_prev(keyGroup);
+        else
+            lv_group_focus_next(keyGroup);
+        done();
+        return;
+    case LV_KEY_LEFT:
+    case LV_KEY_RIGHT:
+        if (isText) {
+            if (enc) { // the widget would read the trackball's UP / DOWN as line moves
+                if (k == LV_KEY_LEFT)
+                    lv_textarea_cursor_left(obj);
+                else
+                    lv_textarea_cursor_right(obj);
+                done();
+            }
+            return;
+        }
+        if (isSlider)
+            return; // LVGL changes the value (keypad LEFT / RIGHT, trackball UP / DOWN)
+        if (onMain)
+            stepTab(k == LV_KEY_LEFT ? -1 : 1);
+        else if (topOverlay() == wizOv) {
+            if (k == LV_KEY_LEFT && wizStep > 0)
+                wizardStep(wizStep - 1);
+            else if (k == LV_KEY_RIGHT && wizStep < 2)
+                wizardStep(wizStep + 1); // Finish stays a deliberate press
+        } else if (k == LV_KEY_LEFT)
+            goBack();
+        done(); // never let a stray LEFT / RIGHT toggle a switch
+        return;
+    default:
+        break;
+    }
+    // typed characters
+    if (isText || k < 0x20 || k == 0x7f || (k >= 0x100 && k < 0x200))
+        return;
+    if (topOverlay() == chatOv) { // start typing the message from anywhere in the chat
+        lv_group_focus_obj(chatInput);
+        lv_textarea_add_char(chatInput, raw);
+        done();
+        return;
+    }
+    if (onMain) {
+        static const char keys[T_COUNT] = {'h', 'l', 'm', 'c', 'n', 's'};
+        for (int i = 0; i < T_COUNT; i++)
+            if ((k | 0x20) == (uint32_t)keys[i]) {
+                selectTab((Tab)i);
+                done();
+                return;
+            }
+    }
+}
+
+void HopticsUI::setMapPan(bool on)
+{
+    if (mapPan == on)
+        return;
+    mapPan = on;
+    // edit mode: amber ring, and the trackball's turns become keys for the map
+    if (keyGroup && lv_group_get_focused(keyGroup) == mapArea)
+        lv_group_set_editing(keyGroup, on);
+    refreshMap(); // the bar above the map says so while panning
+    updateKeyContext();
+}
+
+void HopticsUI::mapPanKey(uint32_t k, bool encoder)
+{
+    if (encoder) { // edit mode: turning sends LEFT / RIGHT, trackball left / right send DOWN / UP
+        switch (k) {
+        case LV_KEY_LEFT:
+            k = LV_KEY_UP;
+            break;
+        case LV_KEY_RIGHT:
+            k = LV_KEY_DOWN;
+            break;
+        case LV_KEY_DOWN:
+            k = LV_KEY_LEFT;
+            break;
+        case LV_KEY_UP:
+            k = LV_KEY_RIGHT;
+            break;
+        default:
+            break;
+        }
+    }
+    // a quarter of the view per press; the view moves the opposite way to a finger drag
+    const int32_t sx = std::max<int32_t>(16, mapW / 4), sy = std::max<int32_t>(16, mapH / 4);
+    switch (k) {
+    case LV_KEY_LEFT:
+        mapCommitPan(sx, 0);
+        break;
+    case LV_KEY_RIGHT:
+        mapCommitPan(-sx, 0);
+        break;
+    case LV_KEY_UP:
+        mapCommitPan(0, sy);
+        break;
+    case LV_KEY_DOWN:
+        mapCommitPan(0, -sy);
+        break;
+    case '+':
+    case '=':
+        mapZoom(1);
+        break;
+    case '-':
+    case '_':
+        mapZoom(-1);
+        break;
+    default:
+        break;
+    }
+}
