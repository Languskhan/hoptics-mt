+        lv_obj_set_style_bg_color(b, C_CARD, 0);
+        lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(b, i == 2 ? C_VIOLET : C_ME, LV_STATE_CHECKED);
+        lv_obj_t *l = label(b, &F12, C_MUTED, chips[i]);
+        lv_obj_set_style_text_color(l, C_ON_ME, LV_STATE_CHECKED);
+        lv_obj_add_flag(l, LV_OBJ_FLAG_EVENT_BUBBLE);
+        lv_obj_center(l);
+        lv_obj_set_user_data(b, (void *)(intptr_t)i);
+        lv_obj_add_event_cb(
+            b,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                ui->liveFilter = (LiveFilter)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                ui->refreshLive();
+            },
+            LV_EVENT_CLICKED, this);
+        liveChips[i] = b;
+    }
+    liveEmpty = label(p, &F14, C_MUTED, "Listening...\nPackets will appear here as they arrive.");
+    lv_obj_set_width(liveEmpty, LV_PCT(100));
+    lv_obj_set_style_text_align(liveEmpty, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_pad_top(liveEmpty, 60, 0);
