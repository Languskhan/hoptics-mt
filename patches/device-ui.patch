+// ================================================================= MAP
+// A tile-free "radar" map: nodes that share GPS are plotted around you, range rings give scale,
+// direct RF neighbours get a link line coloured by SNR, and every packet heard makes its sender
+// ping - so you can watch where traffic is coming from in real time. MQTT traffic pings violet.
+namespace
+{
+constexpr double KM_PER_DEG_LAT = 110.574;
+constexpr double KM_PER_DEG_LON = 111.320;
+float niceStep(float km)
+{
+    static const float steps[] = {0.1f, 0.2f, 0.5f, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000};
+    for (float st : steps)
+        if (st >= km)
+            return st;
+    return 2000;
+}
+} // namespace
+
+void HopticsUI::buildMap(lv_obj_t *p)
+{
+    lv_obj_remove_flag(p, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_pad_row(p, 4, 0);
+
+    lv_obj_t *bar = plain(p);
+    lv_obj_set_size(bar, LV_PCT(100), 26);
+    row(bar, 4);
+    struct B {
+        const char *t;
+        int id;
+    } btns[] = {{LV_SYMBOL_REFRESH " Fit", 0}, {LV_SYMBOL_MINUS, 1}, {LV_SYMBOL_PLUS, 2}};
+    for (auto &b : btns) {
+        lv_obj_t *o = flatButton(bar, b.t, C_CYAN, b.id == 0 ? 56 : 34, 24);
+        lv_obj_set_user_data(o, (void *)(intptr_t)b.id);
+        lv_obj_add_event_cb(
+            o,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                int id = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                if (id == 0) {
+                    ui->mapUserZoom = false;
+                    ui->mapFit();
+                } else {
+                    ui->mapUserZoom = true;
+                    ui->mapKmPerPx *= (id == 1) ? 1.6f : 1 / 1.6f;
+                    ui->mapKmPerPx = std::max(0.002f, std::min(50.0f, ui->mapKmPerPx));
+                }
+                ui->refreshMap();
+            },
+            LV_EVENT_CLICKED, this);
+    }
+    mapRange = label(bar, FSMALL, C_MUTED, "");
+    lv_obj_set_flex_grow(mapRange, 1);
+    lv_obj_set_style_text_align(mapRange, LV_TEXT_ALIGN_RIGHT, 0);
+
+    mapArea = plain(p);
+    lv_obj_set_width(mapArea, LV_PCT(100));
+    lv_obj_set_flex_grow(mapArea, 1);
+    lv_obj_set_style_bg_color(mapArea, C_CARD, 0);
+    lv_obj_set_style_bg_opa(mapArea, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(mapArea, 10, 0);
+    lv_obj_set_style_clip_corner(mapArea, true, 0);
+    if (T_BORDERS) {
+        lv_obj_set_style_border_width(mapArea, 1, 0);
+        lv_obj_set_style_border_color(mapArea, C_LINE, 0);
+    }
+
+    for (int i = 0; i < 3; i++) {
+        mapRings[i] = plain(mapArea);
+        lv_obj_set_style_radius(mapRings[i], LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_border_width(mapRings[i], 1, 0);
+        lv_obj_set_style_border_color(mapRings[i], C_LINE, 0);
+        lv_obj_remove_flag(mapRings[i], LV_OBJ_FLAG_CLICKABLE);
+        mapRingLbl[i] = label(mapArea, FSMALL, C_DIM, "");
+    }
+    for (int i = 0; i < HOPTICS_MAP_MARKERS; i++) {
+        mapLinks[i] = lv_line_create(mapArea);
+        lv_obj_set_style_line_width(mapLinks[i], 2, 0);
+        lv_obj_set_style_line_opa(mapLinks[i], LV_OPA_50, 0);
+        lv_obj_set_style_line_rounded(mapLinks[i], true, 0);
+        lv_obj_add_flag(mapLinks[i], LV_OBJ_FLAG_HIDDEN);
+        lv_obj_remove_flag(mapLinks[i], LV_OBJ_FLAG_CLICKABLE);
+    }
+    for (int i = 0; i < HOPTICS_MAP_MARKERS; i++) {
+        lv_obj_t *d = plain(mapArea);
+        lv_obj_set_size(d, 10, 10);
+        lv_obj_set_style_radius(d, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_bg_opa(d, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(d, 1, 0);
+        lv_obj_set_style_border_color(d, C_BG, 0);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
+        lv_obj_set_ext_click_area(d, 10);
+        lv_obj_t *l = label(d, FSMALL, C_MUTED, "");
+        lv_obj_set_pos(l, 12, -3);
+        lv_obj_add_event_cb(
+            d,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                uint32_t num = (uint32_t)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                if (num)
+                    ui->openNode(num);
+            },
+            LV_EVENT_CLICKED, this);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_HIDDEN);
+        mapDots[i] = d;
+    }
+    mapMe = plain(mapArea);
+    lv_obj_set_size(mapMe, 14, 14);
+    lv_obj_set_style_radius(mapMe, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(mapMe, C_CYAN, 0);
+    lv_obj_set_style_bg_opa(mapMe, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(mapMe, 2, 0);
+    lv_obj_set_style_border_color(mapMe, C_BG, 0);
+    lv_obj_set_style_shadow_color(mapMe, C_CYAN, 0);
+    lv_obj_set_style_shadow_width(mapMe, 14, 0);
+    lv_obj_set_style_shadow_opa(mapMe, LV_OPA_60, 0);
+    lv_obj_add_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+
+    mapEmpty = label(mapArea, &F12, C_MUTED, "No positions yet.\nNodes appear here once they share GPS.");
+    lv_obj_set_width(mapEmpty, LV_PCT(90));
+    lv_label_set_long_mode(mapEmpty, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_style_text_align(mapEmpty, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_center(mapEmpty);
+}
+
+bool HopticsUI::mapProject(int32_t lat, int32_t lon, int32_t &x, int32_t &y) const
+{
+    const int32_t w = lv_obj_get_content_width(mapArea), h = lv_obj_get_content_height(mapArea);
+    double clatRad = (mapCLat / 1e7) * M_PI / 180.0;
+    double dx = ((lon - mapCLon) / 1e7) * KM_PER_DEG_LON * cos(clatRad);
+    double dy = ((lat - mapCLat) / 1e7) * KM_PER_DEG_LAT;
+    x = w / 2 + (int32_t)lround(dx / mapKmPerPx);
+    y = h / 2 - (int32_t)lround(dy / mapKmPerPx);
+    return x >= -6 && y >= -6 && x <= w + 6 && y <= h + 6;
+}
+
+void HopticsUI::mapFit(void)
+{
+    if (!mapArea)
+        return;
+    lv_obj_update_layout(mapArea);
+    const Node *me = findNode(myNode);
+    // centre on our own fix, otherwise on the middle of everyone we know about
+    if (me && me->hasPos) {
+        mapCLat = me->lat;
+        mapCLon = me->lon;
+        mapHaveCenter = true;
+    } else {
+        double sLat = 0, sLon = 0;
+        int n = 0;
+        for (const auto &nd : nodes)
+            if (nd.hasPos) {
+                sLat += nd.lat;
+                sLon += nd.lon;
+                n++;
+            }
+        mapHaveCenter = n > 0;
+        if (n) {
+            mapCLat = (int32_t)(sLat / n);
+            mapCLon = (int32_t)(sLon / n);
+        }
+    }
+    // zoom so the farthest recently-heard node fits (ignore stale nodes far away)
+    double maxKm = 0.5;
+    Node c{};
+    c.hasPos = true;
+    c.lat = mapCLat;
+    c.lon = mapCLon;
+    for (const auto &nd : nodes) {
+        if (!nd.hasPos || nd.num == myNode)
+            continue;
+        bool recent = nd.lastHeard && nd.lastHeard <= nowTs + 60 && nowTs - std::min(nowTs, nd.lastHeard) < 24 * 3600;
+        if (!recent && clockValid)
+            continue;
+        double d = distanceKm(c, nd);
+        if (d < 400) // a node reporting a position on another continent shouldn't zoom us out to nothing
+            maxKm = std::max(maxKm, d);
+    }
+    const int32_t w = lv_obj_get_content_width(mapArea), h = lv_obj_get_content_height(mapArea);
+    float radiusPx = std::max<int32_t>(20, std::min(w, h) / 2 - 14);
+    mapKmPerPx = (float)(maxKm * 1.08 / radiusPx);
+    dirtyMap = true;
+}
+
+void HopticsUI::refreshMap(void)
+{
+    if (!mainScreen || !mapArea)
+        return;
+    dirtyMap = false;
+    lv_obj_update_layout(mapArea);
+    if (!mapHaveCenter)
+        mapFit();
+    const int32_t w = lv_obj_get_content_width(mapArea), h = lv_obj_get_content_height(mapArea);
+
+    // range rings
+    float viewKm = mapKmPerPx * std::min(w, h) / 2;
+    float step = niceStep(viewKm / 3);
+    for (int i = 0; i < 3; i++) {
+        float km = step * (i + 1);
+        int32_t r = (int32_t)(km / mapKmPerPx);
+        lv_obj_set_size(mapRings[i], r * 2, r * 2);
+        lv_obj_set_pos(mapRings[i], w / 2 - r, h / 2 - r);
+        char b[16];
+        if (km < 1)
+            snprintf(b, sizeof(b), "%.0f m", km * 1000);
+        else
+            snprintf(b, sizeof(b), "%g km", km);
+        lv_label_set_text(mapRingLbl[i], b);
+        lv_obj_set_pos(mapRingLbl[i], w / 2 + 3, h / 2 - r + 1);
+        bool vis = r > 8 && r < std::max(w, h);
+        if (vis) {
+            lv_obj_remove_flag(mapRings[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_remove_flag(mapRingLbl[i], LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(mapRings[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_add_flag(mapRingLbl[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    const Node *me = findNode(myNode);
+    int32_t mx = w / 2, my = h / 2;
+    bool meOn = me && me->hasPos;
+    if (meOn) {
+        mapProject(me->lat, me->lon, mx, my);
+        lv_obj_set_pos(mapMe, mx - 7, my - 7);
+        lv_obj_remove_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+    } else
+        lv_obj_add_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+
+    // newest first, so the most relevant nodes win when there are more than we can draw
+    std::vector<const Node *> pos;
+    for (const auto &nd : nodes)
+        if (nd.hasPos && nd.num != myNode)
+            pos.push_back(&nd);
+    std::sort(pos.begin(), pos.end(), [](const Node *a, const Node *b) { return a->lastHeard > b->lastHeard; });
+
+    int shown = 0, offscreen = 0;
+    for (const Node *nd : pos) {
+        if (shown >= HOPTICS_MAP_MARKERS)
+            break;
+        int32_t x, y;
+        if (!mapProject(nd->lat, nd->lon, x, y)) {
+            offscreen++;
+            continue;
+        }
+        lv_obj_t *d = mapDots[shown];
+        bool online = nd->lastHeard && nd->lastHeard <= nowTs + 60 && nowTs - std::min(nowTs, nd->lastHeard) <= kOnlineSecs;
+        lv_obj_set_style_bg_color(d, nodeColor(nd->num), 0);
+        lv_obj_set_style_opa(d, online ? LV_OPA_COVER : LV_OPA_40, 0);
+        lv_obj_set_pos(d, x - 5, y - 5);
+        lv_obj_set_user_data(d, (void *)(uintptr_t)nd->num);
+        lv_label_set_text(lv_obj_get_child(d, 0), nd->shortName);
+        lv_obj_remove_flag(d, LV_OBJ_FLAG_HIDDEN);
+
+        lv_obj_t *ln = mapLinks[shown];
+        if (meOn && nd->hops == 0 && nd->hasSignal && !nd->viaMqtt) {
+            mapLinkPts[shown][0] = {(lv_value_precise_t)mx, (lv_value_precise_t)my};
+            mapLinkPts[shown][1] = {(lv_value_precise_t)x, (lv_value_precise_t)y};
+            lv_line_set_points(ln, mapLinkPts[shown], 2);
+            lv_obj_set_style_line_color(ln, snrColor(nd->snr), 0);
+            lv_obj_remove_flag(ln, LV_OBJ_FLAG_HIDDEN);
+        } else
+            lv_obj_add_flag(ln, LV_OBJ_FLAG_HIDDEN);
+        shown++;
+    }
+    for (int i = shown; i < HOPTICS_MAP_MARKERS; i++) {
+        lv_obj_add_flag(mapDots[i], LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(mapLinks[i], LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_obj_move_to_index(mapMe, -1);
+
+    if (pos.empty() && !meOn)
+        lv_obj_remove_flag(mapEmpty, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_add_flag(mapEmpty, LV_OBJ_FLAG_HIDDEN);
+
+    char b[64];
+    if (!meOn && !pos.empty())
+        snprintf(b, sizeof(b), "no GPS fix - centred on mesh");
+    else if (offscreen)
+        snprintf(b, sizeof(b), "%d shown, %d off map", shown, offscreen);
+    else
+        snprintf(b, sizeof(b), "%d nodes with GPS", shown);
+    lv_label_set_text(mapRange, b);
+}
+
+void HopticsUI::mapPing(uint32_t num, uint16_t port, bool viaMqtt, int8_t hops)
+{
+    if (!mainScreen || activeTab != T_MAP || mapPings >= 12 || !lv_obj_has_flag(chatOv, LV_OBJ_FLAG_HIDDEN) ||
+        !lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN) || !lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN))
+        return;
+    const Node *n = findNode(num);
+    if (!n || !n->hasPos)
+        return;
+    int32_t x, y;
+    if (!mapProject(n->lat, n->lon, x, y))
+        return;
+    lv_color_t col = viaMqtt ? C_VIOLET : portColor(port);
+
+    // expanding ring at the sender
+    lv_obj_t *ring = plain(mapArea);
+    lv_obj_set_style_radius(ring, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_border_width(ring, viaMqtt ? 1 : 2, 0);
+    lv_obj_set_style_border_color(ring, col, 0);
+    lv_obj_remove_flag(ring, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(ring, x, y);
+    lv_obj_set_size(ring, 1, 1);
+    mapPings++;
+
+    lv_anim_t a;
+    lv_anim_init(&a);
+    lv_anim_set_var(&a, ring);
+    lv_anim_set_values(&a, 4, 46);
+    lv_anim_set_duration(&a, 1300);
+    lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
+    lv_obj_set_user_data(ring, (void *)(intptr_t)(((x & 0xffff) << 16) | (y & 0xffff)));
+    lv_anim_set_user_data(&a, ring);
+    lv_anim_set_exec_cb(&a, [](void *obj, int32_t v) {
+        lv_obj_t *o = (lv_obj_t *)obj;
+        intptr_t packed = (intptr_t)lv_obj_get_user_data(o);
+        int32_t cx = (int16_t)((packed >> 16) & 0xffff), cy = (int16_t)(packed & 0xffff);
+        lv_obj_set_size(o, v, v);
+        lv_obj_set_pos(o, cx - v / 2, cy - v / 2);
+        lv_obj_set_style_opa(o, (lv_opa_t)(255 - (v - 4) * 255 / 42), 0);
+    });
+    lv_anim_set_completed_cb(&a, [](lv_anim_t *an) { lv_obj_delete_async((lv_obj_t *)lv_anim_get_user_data(an)); });
+    lv_anim_start(&a);
+    // decrement the in-flight counter when the ring is gone
+    lv_obj_add_event_cb(
+        ring, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->mapPings--; }, LV_EVENT_DELETE, this);
+
+    // a direct RF packet also flashes a beam to us
+    const Node *me = findNode(myNode);
+    if (hops == 0 && !viaMqtt && me && me->hasPos) {
+        int32_t mx, my;
+        mapProject(me->lat, me->lon, mx, my);
+        lv_point_precise_t *pts = (lv_point_precise_t *)lv_malloc(sizeof(lv_point_precise_t) * 2);
+        if (!pts)
+            return;
+        pts[0] = {(lv_value_precise_t)x, (lv_value_precise_t)y};
+        pts[1] = {(lv_value_precise_t)mx, (lv_value_precise_t)my};
+        lv_obj_t *beam = lv_line_create(mapArea);
+        lv_line_set_points(beam, pts, 2);
+        lv_obj_set_style_line_width(beam, 3, 0);
+        lv_obj_set_style_line_color(beam, col, 0);
+        lv_obj_set_style_line_rounded(beam, true, 0);
+        lv_obj_remove_flag(beam, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_user_data(beam, pts);
+        lv_obj_add_event_cb(
+            beam, [](lv_event_t *e) { lv_free(lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e))); },
+            LV_EVENT_DELETE, nullptr);
+        lv_anim_t b;
+        lv_anim_init(&b);
+        lv_anim_set_var(&b, beam);
+        lv_anim_set_values(&b, 255, 0);
+        lv_anim_set_duration(&b, 900);
+        lv_anim_set_user_data(&b, beam);
+        lv_anim_set_exec_cb(&b, [](void *obj, int32_t v) { lv_obj_set_style_line_opa((lv_obj_t *)obj, (lv_opa_t)v, 0); });
+        lv_anim_set_completed_cb(&b, [](lv_anim_t *an) { lv_obj_delete_async((lv_obj_t *)lv_anim_get_user_data(an)); });
+        lv_anim_start(&b);
+        lv_obj_move_to_index(mapMe, -1);
+    }
+}
