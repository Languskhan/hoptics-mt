+HopticsUI::Node *HopticsUI::nodePtr(uint32_t num)
+{
+    for (auto &n : nodes)
+        if (n.num == num)
+            return &n;
+    return nullptr;
+}
+
+const HopticsUI::Node *HopticsUI::findNode(uint32_t num) const
+{
+    for (const auto &n : nodes)
+        if (n.num == num)
+            return &n;
+    return nullptr;
+}
+
+HopticsUI::Node &HopticsUI::nodeRef(uint32_t num)
+{
+    Node *n = nodePtr(num);
+    if (n)
+        return *n;
+    if (nodes.size() >= HOPTICS_MAX_NODES) {
+        // evict the stalest node (never ourselves)
+        auto it = std::min_element(nodes.begin(), nodes.end(), [this](const Node &a, const Node &b) {
+            if (a.num == myNode)
+                return false;
+            if (b.num == myNode)
+                return true;
+            return a.lastHeard < b.lastHeard;
+        });
+        *it = Node{};
+        it->num = num;
+        snprintf(it->shortName, sizeof(it->shortName), "%04x", (unsigned)(num & 0xffff));
+        return *it;
+    }
+    nodes.emplace_back();
+    Node &nn = nodes.back();
+    nn.num = num;
+    snprintf(nn.shortName, sizeof(nn.shortName), "%04x", (unsigned)(num & 0xffff));
+    return nn;
+}
+
+HopticsUI::Conv *HopticsUI::convPtr(uint32_t key)
+{
+    for (auto &c : convs)
+        if (c.key == key)
+            return &c;
+    return nullptr;
+}
+
+HopticsUI::Conv &HopticsUI::convRef(uint32_t key)
+{
+    Conv *c = convPtr(key);
+    if (c)
+        return *c;
+    if (key >= kMaxChannels) {
+        // bound memory: keep the most recent DM conversations, drop the oldest one that isn't open
+        size_t dms = 0;
+        for (const auto &cv : convs)
+            dms += cv.key >= kMaxChannels;
+        if (dms >= HOPTICS_MAX_DM_CONVS) {
+            auto victim = convs.end();
+            for (auto it = convs.begin(); it != convs.end(); ++it)
+                if (it->key >= kMaxChannels && it->key != chatKey && (victim == convs.end() || it->lastTime < victim->lastTime))
+                    victim = it;
+            if (victim != convs.end())
+                convs.erase(victim);
+        }
+    }
+    convs.push_back(Conv{key, {}, 0, 0});
+    return convs.back();
+}
+
+const char *HopticsUI::nodeShort(uint32_t num, char *buf, size_t len)
+{
+    const Node *n = findNode(num);
+    if (n && n->shortName[0])
+        snprintf(buf, len, "%s", n->shortName);
+    else
+        snprintf(buf, len, "%04x", (unsigned)(num & 0xffff));
+    return buf;
+}
+
+const char *HopticsUI::nodeLong(uint32_t num, char *buf, size_t len)
+{
+    const Node *n = findNode(num);
+    if (n && n->longName[0])
+        snprintf(buf, len, "%s", n->longName);
+    else
+        snprintf(buf, len, "!%08x", (unsigned)num);
+    return buf;
+}
+
+const char *HopticsUI::convTitle(uint32_t key, char *buf, size_t len)
+{
+    if (key < kMaxChannels) {
+        if (channelNames[key][0])
+            snprintf(buf, len, "# %s", channelNames[key]);
+        else
+            snprintf(buf, len, "# %s", key == 0 ? "Primary" : "Channel");
+        return buf;
+    }
+    return nodeLong(key, buf, len);
+}
+
+void HopticsUI::agoString(uint32_t t, char *buf, size_t len) const
+{
+    if (t == 0 || t > nowTs + 60) {
+        snprintf(buf, len, "-");
+        return;
+    }
+    uint32_t d = nowTs > t ? nowTs - t : 0;
+    if (d < 60)
+        snprintf(buf, len, "%us", (unsigned)d);
+    else if (d < 3600)
+        snprintf(buf, len, "%um", (unsigned)(d / 60));
+    else if (d < 86400)
+        snprintf(buf, len, "%uh", (unsigned)(d / 3600));
+    else
+        snprintf(buf, len, "%ud", (unsigned)(d / 86400));
+}
+
+void HopticsUI::setBadge(lv_obj_t *badge, uint32_t num)
+{
+    char buf[12];
+    nodeShort(num, buf, sizeof(buf));
+    lv_label_set_text(badge, buf);
+    lv_color_t c = nodeColor(num);
+    lv_obj_set_style_bg_color(badge, c, 0);
+    lv_obj_set_style_text_color(badge, lv_color_luminance(c) > 140 ? lv_color_hex(0x05090F) : lv_color_white(), 0);
+}
+
+uint32_t HopticsUI::onlineCount(void) const
+{
+    uint32_t n = 0;
+    for (const auto &nd : nodes) {
+        if (nd.num == myNode || nd.lastHeard == 0 || nd.lastHeard > nowTs + 60)
+            continue;
+        if (nowTs - std::min(nowTs, nd.lastHeard) <= kOnlineSecs)
+            n++;
+    }
+    return n;
+}
+
+double HopticsUI::distanceKm(const Node &a, const Node &b) const
+{
+    if (!a.hasPos || !b.hasPos)
+        return -1;
+    const double k = M_PI / 180.0 / 1e7;
+    double la1 = a.lat * k, la2 = b.lat * k, dla = la2 - la1, dlo = (b.lon - a.lon) * k;
+    double h = sin(dla / 2) * sin(dla / 2) + cos(la1) * cos(la2) * sin(dlo / 2) * sin(dlo / 2);
+    return 6371.0 * 2 * atan2(sqrt(h), sqrt(1 - h));
+}
