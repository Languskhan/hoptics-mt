+// ================================================================= STATS
+void HopticsUI::buildStats(lv_obj_t *p)
+{
+    // channel load
+    lv_obj_t *c1 = card(p, "CHANNEL LOAD  -  % per minute");
+    statUtilChart = makeChart(c1, 80, LV_CHART_TYPE_LINE, HOPTICS_HISTORY);
+    lv_chart_set_axis_range(statUtilChart, LV_CHART_AXIS_PRIMARY_Y, 0, 40);
+    serChUtil = lv_chart_add_series(statUtilChart, C_AMBER, LV_CHART_AXIS_PRIMARY_Y);
+    serAirUtil = lv_chart_add_series(statUtilChart, C_VIOLET, LV_CHART_AXIS_PRIMARY_Y);
+    lv_chart_set_all_values(statUtilChart, serChUtil, LV_CHART_POINT_NONE);
+    lv_chart_set_all_values(statUtilChart, serAirUtil, LV_CHART_POINT_NONE);
+    lv_obj_t *lg = plain(c1);
