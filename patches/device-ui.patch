+// ================================================================= ENVIRONMENT
+// Both kits carry sensors on the expansion board (BME280: temperature, humidity, pressure; GXHTC3:
+// temperature, humidity). The firmware reads them about once a minute and hands each reading to the
+// screen; it only goes out on the mesh when sharing is on (Settings > SENSORS).
+namespace
+{
+constexpr int16_t ENV_NONE = INT16_MIN;
+constexpr uint8_t ENV_STEP_MIN = 5; // minutes per history row
+const uint32_t ENV_SHARE_SECS[] = {1800, 3600, 7200, 21600, 43200};
+const char *const ENV_SHARE_OPTS = "30 minutes\n1 hour\n2 hours\n6 hours\n12 hours";
+const char *const ENV_TITLES[3] = {"TEMPERATURE", "HUMIDITY", "PRESSURE"};
+
+// dew point (Magnus formula), deg C
+float dewPointC(float t, float rh)
+{
+    if (std::isnan(t) || std::isnan(rh) || rh <= 0)
+        return NAN;
+    const float a = 17.62f, b = 243.12f;
+    float g = logf(rh / 100.0f) + a * t / (b + t);
+    return b * g / (a - g);
+}
+
+const char *shareEveryText(uint32_t secs)
+{
+    static char b[24];
+    if (secs == 0)
+        secs = 1800;
+    if (secs % 3600 == 0)
+        snprintf(b, sizeof(b), "%u hour%s", (unsigned)(secs / 3600), secs == 3600 ? "" : "s");
+    else
+        snprintf(b, sizeof(b), "%u minutes", (unsigned)(secs / 60));
+    return b;
+}
+} // namespace
+
+bool HopticsUI::tempF(void) const
+{
+    if (envUnitF >= 0)
+        return envUnitF != 0;
+    return envRadioF || region == 1; // not picked yet: Fahrenheit in the US
+}
+
+bool HopticsUI::pressInHg(void) const
+{
+    if (envUnitInHg >= 0)
+        return envUnitInHg != 0;
+    return tempF();
+}
+
+void HopticsUI::fmtTemp(char *buf, size_t len, float c, bool unit) const
+{
+    if (std::isnan(c)) {
+        snprintf(buf, len, "--");
+        return;
+    }
+    bool f = tempF();
+    float v = f ? c * 9.0f / 5.0f + 32.0f : c;
+    if (unit)
+        snprintf(buf, len, "%.1f\xC2\xB0%c", v, f ? 'F' : 'C');
+    else
+        snprintf(buf, len, "%.1f", v);
+}
+
+void HopticsUI::fmtPress(char *buf, size_t len, float hPa, bool unit) const
+{
+    if (std::isnan(hPa)) {
+        snprintf(buf, len, "--");
+        return;
+    }
+    if (pressInHg())
+        snprintf(buf, len, unit ? "%.2f inHg" : "%.2f", hPa * 0.0295300f);
+    else
+        snprintf(buf, len, unit ? "%.0f hPa" : "%.0f", hPa);
+}
+
+void HopticsUI::updateEnvironment(uint32_t num, const EnvReading &in)
+{
+    if (num == 0)
+        return;
+    EnvReading r = in;
+    // drop values no real sensor reports (a missing or failing sensor can send zeros or garbage)
+    if (!(r.temp > -60.0f && r.temp < 90.0f))
+        r.temp = NAN;
+    if (!(r.hum > 0.0f && r.hum <= 100.5f))
+        r.hum = NAN;
+    if (!(r.press > 300.0f && r.press < 1200.0f))
+        r.press = NAN;
+    if (!(r.lux >= 0.0f))
+        r.lux = NAN;
+    if (r.iaq < 0 || r.iaq > 500)
+        r.iaq = -1;
+    if (std::isnan(r.temp) && std::isnan(r.hum) && std::isnan(r.press) && std::isnan(r.lux) && r.iaq < 0)
+        return; // e.g. a power-monitor-only report
+    Node &n = nodeRef(num);
+    n.envTemp = r.temp;
+    n.envHum = r.hum;
+    n.envPress = r.press;
+    n.envLux = r.lux;
+    n.envIaq = (int16_t)r.iaq;
+    n.envTime = nowTs;
+    if (num == myNode) {
+        envNow = r;
+        envNowTime = nowTs;
+        float v[3] = {r.temp, r.hum, r.press};
+        if (envHistCount == 0) {
+            envPush(v); // first reading: start the graphs right away
+            envMinute = 0;
+        } else {
+            for (int k = 0; k < 3; k++)
+                if (!std::isnan(v[k])) {
+                    envSum[k] += v[k];
+                    envSumN[k]++;
+                }
+        }
+        dirtyHome = true;
+    }
+    if (num == nodeOvNum)
+        dirtyNodeOv = true;
+    envDirty |= 2;
+}
+
+void HopticsUI::setEnvConfig(bool share, uint32_t intervalSecs, bool fahrenheit)
+{
+    envShare = share;
+    envShareSecs = intervalSecs;
+    envRadioF = fahrenheit;
+    envCfgKnown = true;
+    envDirty = 0xff;
+    dirtyHome = true;
+}
+
+void HopticsUI::envPush(const float v[3])
+{
+    if (!envHist)
+        return;
+    for (int k = 0; k < 3; k++) {
+        int16_t *h = envHist + k * HOPTICS_ENV_HISTORY;
+        memmove(h, h + 1, sizeof(int16_t) * (HOPTICS_ENV_HISTORY - 1));
+        h[HOPTICS_ENV_HISTORY - 1] = std::isnan(v[k]) ? ENV_NONE : (int16_t)lroundf(v[k] * 10.0f);
+    }
+    if (envHistCount < HOPTICS_ENV_HISTORY)
+        envHistCount++;
+    envDirty = 0xff;
+}
+
+void HopticsUI::envBucket(void)
+{
+    if (++envMinute < ENV_STEP_MIN)
+        return;
+    envMinute = 0;
+    if (envHistCount == 0)
+        return; // no reading yet: don't start the graphs with gaps
+    float v[3];
+    for (int k = 0; k < 3; k++) {
+        v[k] = envSumN[k] ? envSum[k] / envSumN[k] : NAN;
+        envSum[k] = 0;
+        envSumN[k] = 0;
+    }
+    envPush(v);
+}
+
+const char *HopticsUI::pressTrend(void) const
+{
+    // change over the last ~3 hours, scaled to hPa per 3 h (weather-station convention)
+    if (!envHist || envHistCount < 12)
+        return nullptr;
+    const int16_t *h = envHist + 2 * HOPTICS_ENV_HISTORY;
+    int first = HOPTICS_ENV_HISTORY - envHistCount;
+    int last = HOPTICS_ENV_HISTORY - 1;
+    while (last > first && h[last] == ENV_NONE)
+        last--;
+    int lo = std::max(first, last - 36);
+    while (lo < last && h[lo] == ENV_NONE)
+        lo++;
+    if (last - lo < 12)
+        return nullptr;
+    float d = (h[last] - h[lo]) / 10.0f * 36.0f / (float)(last - lo);
+    if (d >= 3.0f)
+        return LV_SYMBOL_UP " rising fast";
+    if (d >= 1.0f)
+        return LV_SYMBOL_UP " rising";
+    if (d <= -3.0f)
+        return LV_SYMBOL_DOWN " falling fast";
+    if (d <= -1.0f)
+        return LV_SYMBOL_DOWN " falling";
+    return "steady";
+}
+
+void HopticsUI::fillEnvChart(lv_obj_t *chart, lv_chart_series_t *ser, int k, lv_obj_t *cap)
+{
+    if (!chart || !ser)
+        return;
+    // window grows with the data so a fresh start still fills the graph: 1, 3, 6, 12, 24 h
+    static const uint32_t steps[] = {12, 36, 72, 144, 288};
+    uint32_t n = HOPTICS_ENV_HISTORY;
+    for (uint32_t s : steps)
+        if (envHistCount <= s) {
+            n = std::min<uint32_t>(s, HOPTICS_ENV_HISTORY);
+            break;
+        }
+    if (lv_chart_get_point_count(chart) != n)
+        lv_chart_set_point_count(chart, n);
+    const int16_t *h = envHist ? envHist + k * HOPTICS_ENV_HISTORY : nullptr;
+    const float scale = (k == 2 && pressInHg()) ? 1000.0f : 100.0f; // chart works in integers
+    int32_t lo = INT32_MAX, hi = INT32_MIN;
+    for (uint32_t i = 0; i < n; i++) {
+        int16_t raw = h ? h[HOPTICS_ENV_HISTORY - n + i] : ENV_NONE;
+        int32_t v = LV_CHART_POINT_NONE;
+        if (raw != ENV_NONE) {
+            float f = raw / 10.0f;
+            if (k == 0 && tempF())
+                f = f * 9.0f / 5.0f + 32.0f;
+            else if (k == 2 && pressInHg())
+                f *= 0.0295300f;
+            v = (int32_t)lroundf(f * scale);
+            lo = std::min(lo, v);
+            hi = std::max(hi, v);
+        }
+        lv_chart_set_series_value_by_id(chart, ser, i, v);
+    }
+    if (lo > hi) {
+        lv_chart_set_axis_range(chart, LV_CHART_AXIS_PRIMARY_Y, 0, 100);
+        if (cap)
+            lv_label_set_text(cap, "No readings yet");
+    } else {
+        // keep small wiggles small: a minimum visible span per quantity
+        int32_t minSpan = k == 0 ? 400 : k == 1 ? 1000 : (pressInHg() ? 60 : 200);
+        int32_t span = std::max(hi - lo, minSpan);
+        int32_t mid = (hi + lo) / 2;
+        lv_chart_set_axis_range(chart, LV_CHART_AXIS_PRIMARY_Y, mid - span * 6 / 10, mid + span * 6 / 10);
+        if (cap) {
+            char a[16], b[16], w[16];
+            const char *fmt = k == 1 ? "%.0f%%" : (k == 2 && pressInHg()) ? "%.2f" : k == 2 ? "%.0f" : "%.1f\xC2\xB0";
+            snprintf(a, sizeof(a), fmt, lo / scale);
+            snprintf(b, sizeof(b), fmt, hi / scale);
+            uint32_t mins = n * ENV_STEP_MIN;
+            snprintf(w, sizeof(w), "%u h", (unsigned)(mins / 60));
+            lv_label_set_text_fmt(cap, "low %s   high %s   -   last %s", a, b, w);
+        }
+    }
+    lv_chart_refresh(chart);
+}
+
+// Settings > SENSORS temperature correction: shown in the chosen unit, whole degrees F or half degrees C
+void HopticsUI::refreshEnvCorr(void)
+{
+    if (!setEnvCorr)
+        return;
+    char b[24], now[24];
+    if (tempF())
+        snprintf(b, sizeof(b), "%+ld\xC2\xB0" "F", lroundf(envTempOff * 9.0f / 50.0f));
+    else
+        snprintf(b, sizeof(b), "%+.1f\xC2\xB0" "C", envTempOff / 10.0f);
+    lv_label_set_text(setEnvCorr, envTempOff ? b : "None");
+    fmtTemp(now, sizeof(now), envNow.temp);
+    lv_label_set_text_fmt(setEnvCorrNote,
+                          "Reads %s now. %s - or + until it matches a thermometer in the room: the sensors sit inside "
+                          "the case and read warm. Humidity is corrected to match.",
+                          now, touchInput ? "Tap" : "Press");
+}
+
+void HopticsUI::stepEnvCorr(int dir)
+{
+    int16_t old = envTempOff;
+    if (tempF()) {
+        long f = lroundf(envTempOff * 9.0f / 50.0f) + dir; // whole degrees F
+        envTempOff = (int16_t)lroundf(f * 50.0f / 9.0f);
+    } else
+        envTempOff = (int16_t)(envTempOff + dir * 5); // half degrees C
+    envTempOff = std::max<int16_t>(-250, std::min<int16_t>(100, envTempOff));
+    if (envTempOff == old)
+        return;
+    saveEnvTempOff(envTempOff);
+    // show it right away; the next reading from the radio (within a minute) already has it applied
+    float d = (envTempOff - old) / 10.0f;
+    if (!std::isnan(envNow.temp)) {
+        float raw = envNow.temp, t = raw + d;
+        if (!std::isnan(envNow.hum)) {
+            auto es = [](float c) { return 6.112f * expf(17.62f * c / (243.12f + c)); };
+            envNow.hum = std::min(100.0f, envNow.hum * es(raw) / es(t));
+        }
+        envNow.temp = t;
+        if (Node *me = nodePtr(myNode)) {
+            me->envTemp = envNow.temp;
+            me->envHum = envNow.hum;
+        }
+    }
+    envDirty = 0xff;
+    dirtyHome = dirtyNodeOv = true;
+    refreshEnvCorr();
+}
+
+std::string HopticsUI::envLine(const Node &n) const
+{
+    char b[32];
+    std::string s;
+    if (!std::isnan(n.envTemp)) {
+        fmtTemp(b, sizeof(b), n.envTemp);
+        s += std::string("Temperature: ") + b + "\n";
+    }
+    if (!std::isnan(n.envHum)) {
+        snprintf(b, sizeof(b), "%.0f%%", n.envHum);
+        s += std::string("Humidity: ") + b + "\n";
+    }
+    if (!std::isnan(n.envPress)) {
+        fmtPress(b, sizeof(b), n.envPress);
+        s += std::string("Pressure: ") + b + "\n";
+    }
+    if (!std::isnan(n.envLux)) {
+        snprintf(b, sizeof(b), "%.0f lux", n.envLux);
+        s += std::string("Light: ") + b + "\n";
+    }
+    if (n.envIaq >= 0) {
+        snprintf(b, sizeof(b), "%d", (int)n.envIaq);
+        s += std::string("Air quality (IAQ): ") + b + "\n";
+    }
+    char ago[12];
+    agoString(n.envTime, ago, sizeof(ago));
+    s += std::string("Updated ") + ago + " ago";
+    return s;
+}
+
+void HopticsUI::refreshHomeEnv(void)
+{
+    if (!homeEnv)
+        return;
+    char b[40], c[96], ago[12];
+    // the big reading's row: hidden while a board without sensor slots has nothing of its own to show
+    lv_obj_t *nowRow = lv_obj_get_parent(lv_obj_get_parent(homeEnvTemp));
+    if (!envHasData() && !hoptics::board::kSensorSlots) {
+        uint32_t sharing = 0;
+        for (const auto &n : nodes)
+            sharing += n.envTime && n.num != myNode;
+        lv_obj_add_flag(nowRow, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(homeEnvChart, LV_OBJ_FLAG_HIDDEN);
+        if (sharing)
+            snprintf(c, sizeof(c), "No sensor on this radio. %u node%s on the mesh share readings - open for the list.",
+                     (unsigned)sharing, sharing == 1 ? "" : "s");
+        else
+            snprintf(c, sizeof(c), "No sensor on this radio. Readings other nodes share on the mesh show up here.");
+        lv_label_set_text(homeEnvSub, c);
+        return;
+    }
+    if (!hoptics::board::kSensorSlots)
+        lv_obj_remove_flag(nowRow, LV_OBJ_FLAG_HIDDEN);
+    if (!envHasData()) {
+        lv_label_set_text(homeEnvTemp, "--");
+        lv_label_set_text(homeEnvUnit, "");
+        lv_label_set_text(homeEnvHum, "");
+        lv_label_set_text(homeEnvPress, "");
+        lv_label_set_text(homeEnvSub, minutesUp >= 5 ? (touchInput ? "No sensor readings yet. Is the sensor board seated? Tap for more."
+                                                                   : "No sensor readings yet. Is the sensor board seated? Open for more.")
+                                                     : "Starting the sensors - the first reading comes in about a minute.");
+        lv_obj_add_flag(homeEnvChart, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+    fmtTemp(b, sizeof(b), envNow.temp, false);
+    lv_label_set_text(homeEnvTemp, b);
+    lv_label_set_text(homeEnvUnit, std::isnan(envNow.temp) ? "" : (tempF() ? "\xC2\xB0" "F" : "\xC2\xB0" "C"));
+    if (std::isnan(envNow.hum))
+        lv_label_set_text(homeEnvHum, "");
+    else
+        lv_label_set_text_fmt(homeEnvHum, "%.0f%% humidity", envNow.hum);
+    if (std::isnan(envNow.press))
+        lv_label_set_text(homeEnvPress, "");
+    else {
+        fmtPress(b, sizeof(b), envNow.press);
+        const char *tr = pressTrend(); // Home shows just the arrow
+        const char *arrow = "";
+        if (tr && strncmp(tr, LV_SYMBOL_UP, strlen(LV_SYMBOL_UP)) == 0)
+            arrow = " " LV_SYMBOL_UP;
+        else if (tr && strncmp(tr, LV_SYMBOL_DOWN, strlen(LV_SYMBOL_DOWN)) == 0)
+            arrow = " " LV_SYMBOL_DOWN;
+        snprintf(c, sizeof(c), "%s%s", b, arrow);
+        lv_label_set_text(homeEnvPress, c);
+    }
+    agoString(envNowTime, ago, sizeof(ago));
+    if (!std::isnan(envNow.hum) && !std::isnan(envNow.temp)) {
+        fmtTemp(c, sizeof(c), dewPointC(envNow.temp, envNow.hum));
+        lv_label_set_text_fmt(homeEnvSub, "Dew point %s   -   updated %s ago   " LV_SYMBOL_RIGHT, c, ago);
+    } else
+        lv_label_set_text_fmt(homeEnvSub, "Updated %s ago   " LV_SYMBOL_RIGHT, ago);
+    lv_obj_remove_flag(homeEnvChart, LV_OBJ_FLAG_HIDDEN);
+    if (envDirty & 1) {
+        envDirty &= ~1;
+        int k = std::isnan(envNow.temp) ? 1 : 0;
+        lv_chart_set_series_color(homeEnvChart, homeEnvSer, k == 0 ? C_AMBER : C_BLUE);
+        fillEnvChart(homeEnvChart, homeEnvSer, k, nullptr);
+    }
+}
