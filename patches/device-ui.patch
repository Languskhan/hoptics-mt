+// ================================================================= main
+void HopticsUI::buildMainScreen(void)
+{
+    if (mainScreen)
+        return;
+    initFonts();
+    applyPalette(themeIdx);
+    mainScreen = lv_obj_create(NULL);
+    lv_obj_remove_flag(mainScreen, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(mainScreen, C_BG, 0);
