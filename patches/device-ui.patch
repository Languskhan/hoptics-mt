+void HopticsUI::refreshStatusBar(void)
+{
+    if (!mainScreen)
+        return;
+    char buf[48];
+    const Node *me = findNode(myNode);
+    if (me && me->longName[0])
+        snprintf(buf, sizeof(buf), "%s", me->shortName);
+    else
+        snprintf(buf, sizeof(buf), HOPTICS_NAME);
+    lv_label_set_text(statusName, buf);
+
+    if (clockValid) {
+        time_t t = nowTs;
+        struct tm tmv;
+        localtime_r(&t, &tmv);
+        snprintf(buf, sizeof(buf), "%02d:%02d", tmv.tm_hour, tmv.tm_min);
+    } else
+        snprintf(buf, sizeof(buf), "--:--");
+    lv_label_set_text(statusTime, buf);
+
+    const char *sym = LV_SYMBOL_BATTERY_EMPTY;
+    lv_color_t col = C_MUTED;
+    if (myBattery == 101) {
+        sym = LV_SYMBOL_CHARGE;
+        col = C_GREEN;
+        snprintf(buf, sizeof(buf), "%s USB", sym);
+    } else if (myBattery <= 100) {
+        sym = myBattery > 80 ? LV_SYMBOL_BATTERY_FULL
+                             : myBattery > 55 ? LV_SYMBOL_BATTERY_3
+                                              : myBattery > 30 ? LV_SYMBOL_BATTERY_2
+                                                               : myBattery > 10 ? LV_SYMBOL_BATTERY_1 : LV_SYMBOL_BATTERY_EMPTY;
+        col = myBattery > 30 ? C_GREEN : myBattery > 10 ? C_AMBER : C_RED;
+        snprintf(buf, sizeof(buf), "%s %u%%", sym, myBattery);
+    } else
+        snprintf(buf, sizeof(buf), "%s", sym);
+    lv_label_set_text(statusBatt, buf);
+    lv_obj_set_style_text_color(statusBatt, col, 0);
+
+    if (wifiOn) {
+        lv_obj_remove_flag(statusLink, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_set_style_text_color(statusLink, wifiUp ? C_GREEN : C_RED, 0);
+    } else
+        lv_obj_add_flag(statusLink, LV_OBJ_FLAG_HIDDEN);
+    if (mqttUp)
+        lv_obj_remove_flag(statusMqtt, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_add_flag(statusMqtt, LV_OBJ_FLAG_HIDDEN);
+    if (bluetoothOn && !wifiOn)
+        lv_obj_remove_flag(statusBt, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_add_flag(statusBt, LV_OBJ_FLAG_HIDDEN);
+    if (!connected)
+        lv_obj_set_style_text_color(statusName, C_RED, 0);
+    else
+        lv_obj_set_style_text_color(statusName, C_TEXT, 0);
+
+    uint32_t unread = 0;
+    for (const auto &c : convs)
+        unread += c.unread;
+    if (unread) {
+        lv_label_set_text(statusMsg, ""); // unread count lives on the Chat tab badge
+        snprintf(buf, sizeof(buf), "%u", (unsigned)std::min<uint32_t>(unread, 99));
+        lv_label_set_text(navBadge, buf);
+        lv_obj_remove_flag(navBadge, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_label_set_text(statusMsg, "");
+        lv_obj_add_flag(navBadge, LV_OBJ_FLAG_HIDDEN);
+    }
+}
