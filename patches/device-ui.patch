+
+void HopticsUI::refreshChatList(void)
+{
+    if (!mainScreen)
+        return;
+    dirtyChats = false;
+    lv_obj_clean(chatList);
+
+    std::vector<uint32_t> keys;
+    for (uint32_t i = 0; i < kMaxChannels; i++)
+        if (channelEnabled[i] || convPtr(i))
+            keys.push_back(i);
+    std::vector<const Conv *> dms;
+    for (const auto &c : convs)
+        if (c.key >= kMaxChannels)
+            dms.push_back(&c);
+    std::sort(dms.begin(), dms.end(), [](const Conv *a, const Conv *b) { return a->lastTime > b->lastTime; });
+    for (auto *c : dms)
+        keys.push_back(c->key);
+
+    if (keys.empty()) {
+        lv_obj_t *l = label(chatList, &F14, C_MUTED, "No channels yet.\nWaiting for the radio config...");
+        lv_obj_set_width(l, LV_PCT(100));
+        lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_style_pad_top(l, 60, 0);
+        return;
+    }
+
+    bool dmHeader = false;
+    char buf[64], ago[12];
+    for (uint32_t key : keys) {
+        if (key >= kMaxChannels && !dmHeader) {
+            lv_obj_t *h = label(chatList, FSMALL, C_MUTED, "DIRECT MESSAGES");
+            lv_obj_set_style_pad_top(h, 4, 0);
+            dmHeader = true;
+        } else if (key == keys.front() && key < kMaxChannels) {
+            label(chatList, FSMALL, C_MUTED, "CHANNELS");
+        }
+        const Conv *c = convPtr(key);
+        lv_obj_t *r = plain(chatList);
+        lv_obj_set_size(r, LV_PCT(100), 46);
+        lv_obj_set_style_bg_color(r, C_CARD, 0);
+        lv_obj_set_style_bg_opa(r, LV_OPA_COVER, 0);
+        lv_obj_set_style_bg_color(r, C_CARD2, LV_STATE_PRESSED);
+        lv_obj_set_style_radius(r, 8, 0);
+        lv_obj_add_flag(r, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_user_data(r, (void *)(uintptr_t)key);
+        lv_obj_add_event_cb(
+            r,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                ui->openChat((uint32_t)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e)));
+            },
+            LV_EVENT_CLICKED, this);
+
+        lv_obj_t *icon;
+        if (key < kMaxChannels) {
+            icon = makeBadge(r, 34, 34, &F20);
+            lv_label_set_text(icon, "#");
+            lv_obj_set_style_bg_color(icon, key == 0 ? C_ME : C_CARD2, 0);
+            lv_obj_set_style_text_color(icon, C_CYAN, 0);
+            lv_obj_set_style_radius(icon, 17, 0);
+        } else {
+            icon = makeBadge(r, 34, 34, &F12);
+            setBadge(icon, key);
+            lv_obj_set_style_radius(icon, 17, 0);
+        }
+        lv_obj_align(icon, LV_ALIGN_LEFT_MID, 6, 0);
+
+        lv_obj_t *t = label(r, &F14, C_TEXT, convTitle(key, buf, sizeof(buf)));
+        oneLine(t);
+        lv_obj_set_width(t, W() - 2 * PAD - 48 - 50);
+        lv_obj_set_pos(t, 48, 5);
+
+        const char *preview = "No messages yet";
+        std::string pv;
+        if (c && !c->msgs.empty()) {
+            const Msg &m = c->msgs.back();
+            char who[12];
+            if (m.from == myNode)
+                pv = "You: ";
+            else if (key < kMaxChannels)
+                pv = std::string(nodeShort(m.from, who, sizeof(who))) + ": ";
+            pv += m.text;
+            for (auto &ch : pv)
+                if (ch == '\n')
+                    ch = ' ';
+            preview = pv.c_str();
+        }
+        lv_obj_t *pl = label(r, &F12, C_MUTED, preview);
+        oneLine(pl);
+        lv_obj_set_width(pl, W() - 2 * PAD - 48 - 36);
+        lv_obj_set_pos(pl, 48, 25);
+
+        if (c && c->lastTime) {
+            agoString(c->lastTime, ago, sizeof(ago));
+            lv_obj_t *a = label(r, FSMALL, C_DIM, ago);
+            lv_obj_align(a, LV_ALIGN_TOP_RIGHT, -6, 6);
+        }
+        if (c && c->unread) {
+            lv_obj_t *u = label(r, FSMALL, lv_color_white(), "");
+            lv_label_set_text_fmt(u, "%u", (unsigned)c->unread);
+            lv_obj_set_style_bg_color(u, C_CYAN, 0);
+            lv_obj_set_style_text_color(u, C_ON_ACCENT, 0);
+            lv_obj_set_style_bg_opa(u, LV_OPA_COVER, 0);
+            lv_obj_set_style_radius(u, 8, 0);
+            lv_obj_set_style_pad_hor(u, 5, 0);
+            lv_obj_set_style_pad_ver(u, 1, 0);
+            lv_obj_align(u, LV_ALIGN_BOTTOM_RIGHT, -6, -6);
+        }
+    }
+}
