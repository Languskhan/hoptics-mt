+void HopticsUI::refreshNodes(void)
+{
+    if (!mainScreen)
+        return;
+    dirtyNodes = false;
+    lastNodesRefresh = nowTs;
+    for (int i = 0; i < 4; i++) {
+        if (i == sortMode)
+            lv_obj_add_state(sortBtns[i], LV_STATE_CHECKED);
+        else
+            lv_obj_remove_state(sortBtns[i], LV_STATE_CHECKED);
+        lv_obj_t *l = lv_obj_get_child(sortBtns[i], 0);
+        if (i == sortMode)
+            lv_obj_add_state(l, LV_STATE_CHECKED);
+        else
+            lv_obj_remove_state(l, LV_STATE_CHECKED);
+    }
+
+    sortedNodes.clear();
+    for (const auto &n : nodes)
+        if (n.num != myNode)
+            sortedNodes.push_back(n.num);
+
+    auto recency = [this](const Node *n) -> uint32_t { return (n->lastHeard > nowTs + 60) ? 0 : n->lastHeard; };
+    std::sort(sortedNodes.begin(), sortedNodes.end(), [&](uint32_t a, uint32_t b) {
+        const Node *na = findNode(a), *nb = findNode(b);
+        switch (sortMode) {
+        case S_SIGNAL: {
+            float sa = na->hasSignal ? na->snr : -999, sb = nb->hasSignal ? nb->snr : -999;
+            if (sa != sb)
+                return sa > sb;
+            return recency(na) > recency(nb);
+        }
+        case S_HOPS: {
+            int ha = na->hops < 0 ? 99 : na->hops, hb = nb->hops < 0 ? 99 : nb->hops;
+            if (ha != hb)
+                return ha < hb;
+            return recency(na) > recency(nb);
+        }
+        case S_NAME:
+            return strcasecmp(na->longName[0] ? na->longName : na->shortName, nb->longName[0] ? nb->longName : nb->shortName) <
+                   0;
+        default:
+            return recency(na) > recency(nb);
+        }
+    });
+
+    const Node *me = findNode(myNode);
+    char buf[96], ago[12];
+    size_t shown = std::min<size_t>(sortedNodes.size(), HOPTICS_NODE_ROWS);
+    for (size_t i = 0; i < HOPTICS_NODE_ROWS; i++) {
+        NodeRow &r = nodeRows[i];
+        if (i >= shown) {
+            lv_obj_add_flag(r.row, LV_OBJ_FLAG_HIDDEN);
+            continue;
+        }
+        const Node *n = findNode(sortedNodes[i]);
+        setBadge(r.badge, n->num);
+        lv_label_set_text(r.name, n->longName[0] ? n->longName : n->shortName);
+
+        std::string sub = roleName(n->role);
+        if (n->viaMqtt)
+            sub += "  -  MQTT";
+        else if (n->hops == 0)
+            sub += "  -  direct";
+        else if (n->hops > 0) {
+            snprintf(buf, sizeof(buf), "  -  %d hop%s", n->hops, n->hops == 1 ? "" : "s");
+            sub += buf;
+        }
+        if (me) {
+            double d = distanceKm(*me, *n);
+            if (d >= 0) {
+                snprintf(buf, sizeof(buf), d < 10 ? "  -  %.1f km" : "  -  %.0f km", d);
+                sub += buf;
+            }
+        }
+        if (n->battery <= 100) {
+            snprintf(buf, sizeof(buf), "  -  %u%%", n->battery);
+            sub += buf;
+        }
+        lv_label_set_text(r.sub, sub.c_str());
+
+        if (n->hasSignal) {
+            snprintf(buf, sizeof(buf), "%+.1f dB", n->snr);
+            lv_obj_set_style_text_color(r.sig, snrColor(n->snr), 0);
+        } else
+            buf[0] = 0;
+        lv_label_set_text(r.sig, buf);
+        lv_obj_align(r.sig, LV_ALIGN_TOP_RIGHT, -6, 5);
+        agoString(recency(n), ago, sizeof(ago));
+        lv_label_set_text(r.ago, ago);
+        lv_obj_align(r.ago, LV_ALIGN_BOTTOM_RIGHT, -6, -6);
+        bool online = recency(n) && nowTs - std::min(nowTs, n->lastHeard) <= kOnlineSecs;
+        lv_obj_set_style_text_color(r.name, online ? C_TEXT : C_MUTED, 0);
+        lv_obj_set_user_data(r.row, (void *)(uintptr_t)n->num);
+        lv_obj_remove_flag(r.row, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (sortedNodes.size() > shown)
+        lv_label_set_text_fmt(nodesMore, "+ %u more nodes", (unsigned)(sortedNodes.size() - shown));
+    else if (sortedNodes.empty())
+        lv_label_set_text(nodesMore, "No nodes heard yet");
+    else
+        lv_label_set_text_fmt(nodesMore, "%u nodes", (unsigned)sortedNodes.size());
+}
