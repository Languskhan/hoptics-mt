+// ================================================================= city locator
+namespace
+{
+// nearest city to a position. Table is sorted by latitude, so binary-search a latitude band and only scan
+// that (a few hundred entries) instead of all ~50k.
+int32_t nearestCity(int32_t lat7, int32_t lon7, float &km, uint16_t &bearing)
+{
+#if HOPTICS_HAVE_CITIES
+    const int32_t lat = lat7 / 1000, lon = lon7 / 1000; // 1e-4 degrees, like the table
+    const double coslat = cos(lat7 / 1e7 * M_PI / 180.0);
+    int32_t best = -1;
+    double bestD = 1e18, bdx = 0, bdy = 0;
+    for (int32_t win : {5000, 20000, 60000}) { // +-0.5, 2, 6 degrees
+        int32_t lo = 0, hi = HOPTICS_CITY_COUNT;
+        while (lo < hi) {
+            int32_t mid = (lo + hi) / 2;
+            if (HOPTICS_CITIES[mid].lat < lat - win)
+                lo = mid + 1;
+            else
+                hi = mid;
+        }
+        for (int32_t i = lo; i < HOPTICS_CITY_COUNT && HOPTICS_CITIES[i].lat <= lat + win; i++) {
+            int32_t dlon = HOPTICS_CITIES[i].lon - lon;
+            if (dlon > 1800000)
+                dlon -= 3600000;
+            else if (dlon < -1800000)
+                dlon += 3600000;
+            double dx = dlon / 1e4 * 111.32 * coslat, dy = (HOPTICS_CITIES[i].lat - lat) / 1e4 * 110.574;
+            double d = dx * dx + dy * dy;
+            if (d < bestD) {
+                bestD = d;
+                best = i;
+                bdx = dx;
+                bdy = dy;
+            }
+        }
+        // the band guarantees nothing closer exists outside it once the best is nearer than the band edge
+        if (best >= 0 && sqrt(bestD) <= win / 1e4 * 110.574)
+            break;
+    }
+    if (best < 0)
+        return -1;
+    km = (float)sqrt(bestD);
+    if (km > 150)
+        return -1; // middle of nowhere / ocean: don't claim a far-away town
+    // direction of the position as seen from the city
+    double deg = atan2(-bdx, -bdy) * 180.0 / M_PI;
+    if (deg < 0)
+        deg += 360;
+    bearing = (uint16_t)deg;
+    return best;
+#else
+    (void)lat7;
+    (void)lon7;
+    (void)km;
+    (void)bearing;
+    return -1;
+#endif
+}
+
+const char *cityName(int32_t idx)
+{
+#if HOPTICS_HAVE_CITIES
+    return idx >= 0 ? HOPTICS_CITY_NAMES + HOPTICS_CITIES[idx].name : "";
+#else
+    (void)idx;
+    return "";
+#endif
+}
