+// ================================================================= TICK
+void HopticsUI::minuteSample(void)
+{
+    minutesUp++;
+    envBucket();
+    auto shift = [](int32_t *arr, int32_t v) {
+        memmove(arr, arr + 1, sizeof(int32_t) * (HOPTICS_HISTORY - 1));
+        arr[HOPTICS_HISTORY - 1] = v;
+    };
+    int32_t rate = (int32_t)std::min<uint32_t>(pktThisMinute, 30000);
+    int32_t cu = lastChUtil >= 0 ? (int32_t)lroundf(lastChUtil) : LV_CHART_POINT_NONE;
+    int32_t au = lastAirUtil >= 0 ? (int32_t)lroundf(lastAirUtil) : LV_CHART_POINT_NONE;
+    shift(histPktRate, rate);
+    shift(histChUtil, cu);
+    shift(histAirUtil, au);
+    pktThisMinute = 0;
+    if (!mainScreen)
+        return;
+    lv_chart_set_next_value(statRateChart, serRate, rate);
+    lv_chart_set_next_value(statUtilChart, serChUtil, cu);
+    lv_chart_set_next_value(statUtilChart, serAirUtil, au);
+    lv_chart_set_next_value(homeChart, homeSeries, rate);
+    int32_t mx = 5;
+    for (int i = HOPTICS_HISTORY - 30; i < HOPTICS_HISTORY; i++)
+        if (i >= 0 && histPktRate[i] != LV_CHART_POINT_NONE)
+            mx = std::max(mx, histPktRate[i]);
+    lv_chart_set_axis_range(homeChart, LV_CHART_AXIS_PRIMARY_Y, 0, ((mx + 4) / 5) * 5);
+    dirtyStats = dirtyHome = true;
+}
+
+void HopticsUI::tick(uint32_t now)
+{
+    setTime(now);
+    if (lastMinute == 0)
+        lastMinute = now;
+    if (now >= lastMinute + 60) {
+        lastMinute = now;
+        minuteSample();
+    } else if (now + 120 < lastMinute) { // clock jumped backwards (time sync)
+        lastMinute = now;
+    }
+    if (!mainScreen)
+        return;
+    refreshStatusBar();
+    if (!keysOn)
+        inputDevicesChanged(); // a keyboard or trackball that came up after the screen was built
+
+    // overlays first
+    if (!lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN)) {
+        if (dirtyNodeOv)
+            refreshNodeOverlay();
+        return;
+    }
+    if (envOv && !lv_obj_has_flag(envOv, LV_OBJ_FLAG_HIDDEN)) {
+        if ((envDirty & 2) || now % 10 == 0)
+            refreshEnvOverlay();
+        return;
+    }
+    if (!lv_obj_has_flag(chatOv, LV_OBJ_FLAG_HIDDEN) || !lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN))
+        return;
+
+    switch (activeTab) {
+    case T_HOME:
+        refreshHome(); // cheap; also keeps "ago" texts fresh
+        break;
+    case T_LIVE:
+        if (dirtyLive || now % 5 == 0)
+            refreshLive();
+        break;
+    case T_MAP:
+        if (dirtyMap || now % 10 == 0)
+            refreshMap();
+        break;
+    case T_CHAT:
+        if (dirtyChats)
+            refreshChatList();
+        break;
+    case T_NODES:
+        if ((dirtyNodes && now >= lastNodesRefresh + 2) || now >= lastNodesRefresh + 30)
+            refreshNodes();
+        break;
+    case T_STATS:
+        if (dirtyStats)
+            refreshStats();
+        break;
+    default:
+        break;
+    }
+}
