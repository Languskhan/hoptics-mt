+void HopticsView::init(IClientBase *client)
+{
+    ILOG_INFO("Hoptics MT " HOPTICS_VERSION " init");
+    hoptics::Report::get().begin(); // why did we restart? (reads the crash summary once)
+    MeshtasticView::init(client);
+    hoptics::Input::begin(displaydriver); // keyboard / trackball, if the board has them (T-Deck, M9)
+    wireCallbacks();
+    ui.createBootScreen(firmware_version);
+    bootStart = (uint32_t)time(nullptr);
+    state = eBooting;
+}
+
+// ---------------------------------------------------------------- lifecycle
+void HopticsView::task_handler(void)
+{
+    hoptics::Input::service(); // keys go to the UI's current default group (before LVGL reads them)
+    MeshtasticView::task_handler();
+    time_t now = time(nullptr);
+
+    // keep the splash up briefly, then let the controller start the config download
+    if (state == eBooting && (uint32_t)now - bootStart >= 1) {
+        state = eBootScreenDone;
+        ui.setBootStatus("Connecting to radio...");
+    }
+    if (!mainShown && state >= eSetupUIConfig && nodeCountSeen > 0) {
+        char b[48];
+        snprintf(b, sizeof(b), "Syncing nodes... %u", (unsigned)nodeCountSeen);
+        ui.setBootStatus(b);
+    }
+
+    if (now != lastTick) {
+        lastTick = now;
+        ui.tick((uint32_t)now);
+        hoptics::Report::get().tick();
+    }
+    ui.service(); // street map tiles finished by the background worker
+
+#if defined(ARDUINO_ARCH_ESP32)
+    // one line a minute so memory headroom can be read from the serial log
+    static time_t lastMemLog = 0;
+    if (now - lastMemLog >= 60) {
+        lastMemLog = now;
+        lv_mem_monitor_t mon;
+        lv_mem_monitor(&mon);
+        ILOG_INFO("Hoptics mem: heap %u free (min %u), PSRAM %u free (largest %u), LVGL %u/%u KB used",
+                  (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL), (unsigned)heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL),
+                  (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM), (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM),
+                  (unsigned)((mon.total_size - mon.free_size) / 1024), (unsigned)(mon.total_size / 1024));
+    }
+#endif
+
+    // Wi-Fi / MQTT state is only sent when asked (the stock UI asks every 10 s too); without this the
+    // settings page would say "connecting..." forever and never show the IP or "MQTT up"
+    if (mainShown && haveNetwork && (network.wifi_enabled || mqttEnabled) && now - lastConnPoll >= 10) {
+        lastConnPoll = now;
+        controller->requestDeviceConnectionStatus();
+    }
+    // refresh the web snapshot every 3 s (built here, on the UI task, so no locking of UI state is needed)
+    if (mainShown && now - lastSnapshot >= 3) {
+        lastSnapshot = now;
+        std::string s;
+        ui.buildSnapshotJson(s);
+        std::lock_guard<std::mutex> lk(snapMutex);
+        snapshot.swap(s);
+    }
+}
+
+bool HopticsView::copySnapshot(std::string &out)
+{
+    std::lock_guard<std::mutex> lk(snapMutex);
+    if (snapshot.empty())
+        return false;
+    out = snapshot;
+    return true;
+}
