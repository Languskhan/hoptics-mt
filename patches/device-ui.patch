+// ================================================================= MAP
+// Live map: nodes that share GPS are plotted around you, on an OpenStreetMap street map when that is
+// on (tiles come from hoptics::TileMap, see HopticsTiles.h). Range rings give scale, direct RF
+// neighbours get a link line coloured by SNR, and every packet heard makes its sender ping - MQTT
+// traffic pings violet. Drag to look around; Fit comes back to your position.
+namespace
+{
+constexpr double kEarthKm = 40075.016686;
+
+float niceStep(float km)
+{
+    static const float steps[] = {0.05f, 0.1f, 0.2f, 0.5f, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000};
+    for (float st : steps)
+        if (st >= km)
+            return st;
+    return 2000;
+}
+
+// Web Mercator with 256 px tiles: the world is (256 << z) pixels square
+void geoToWorld(double lat, double lon, int z, double &x, double &y)
+{
+    lat = std::max(-85.05112878, std::min(85.05112878, lat));
+    const double n = 256.0 * (double)(1u << z), s = sin(lat * M_PI / 180.0);
+    x = (lon + 180.0) / 360.0 * n;
+    y = (0.5 - log((1 + s) / (1 - s)) / (4 * M_PI)) * n;
+}
+
+double worldLat(double y, int z)
+{
+    const double n = 256.0 * (double)(1u << z);
+    return atan(sinh(M_PI * (1 - 2 * y / n))) * 180.0 / M_PI;
+}
+
+double kmPerPx(double lat, int z)
+{
+    return kEarthKm * cos(lat * M_PI / 180.0) / (256.0 * (double)(1u << z));
+}
+
+// street map on/off survives reboots (NVS, next to the boot-art counter)
+bool loadMapPref(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    uint8_t v = 1;
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READONLY, &h) == ESP_OK) {
+        nvs_get_u8(h, "maptiles", &v);
+        nvs_close(h);
+    }
+    return v != 0;
+#else
+    return true;
+#endif
+}
+
+void saveMapPref(bool on)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READWRITE, &h) == ESP_OK) {
+        nvs_set_u8(h, "maptiles", on ? 1 : 0);
+        nvs_commit(h);
+        nvs_close(h);
+    }
+#else
+    (void)on;
+#endif
+}
+} // namespace
