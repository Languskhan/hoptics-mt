+void HopticsUI::refreshHome(void)
+{
+    if (!mainScreen)
+        return;
+    dirtyHome = false;
+    char buf[64];
+    uint32_t online = onlineCount();
+    lv_label_set_text_fmt(homeOnline, "%u", (unsigned)online);
+    lv_label_set_text_fmt(homeOnlineSub, "of %u", (unsigned)(nodes.size() > 0 ? nodes.size() - (findNode(myNode) ? 1 : 0) : 0));
+
+    if (lastChUtil >= 0) {
+        lv_label_set_text_fmt(homeChUtil, "%d%%", (int)lroundf(lastChUtil));
+        lv_obj_set_style_text_color(homeChUtil, lastChUtil < 25 ? C_GREEN : lastChUtil < 50 ? C_AMBER : C_RED, 0);
+        lv_label_set_text(homeChUtilSub, lastChUtil < 25 ? "quiet" : lastChUtil < 50 ? "busy" : "congested");
+    }
+    if (lastAirUtil >= 0) {
+        snprintf(buf, sizeof(buf), "%.1f%%", lastAirUtil);
+        lv_label_set_text(homeAir, buf);
+        lv_label_set_text(homeAirSub, "last hour");
+    }
+    lv_label_set_text_fmt(homeRate, "%u", (unsigned)pktThisMinute);
+
+    {
+        const Node *me = findNode(myNode);
+        if (me && me->hasPos) {
+            char cb[80];
+            if (cityLabel(myNode, cb, sizeof(cb)))
+                lv_label_set_text_fmt(homeLocCity, LV_SYMBOL_GPS "  %s", cb);
+            else
+                lv_label_set_text(homeLocCity, LV_SYMBOL_GPS "  Position fixed");
+            snprintf(buf, sizeof(buf), "%.5f, %.5f%s", me->lat / 1e7, me->lon / 1e7, me->alt ? "" : "");
+            if (me->alt)
+                lv_label_set_text_fmt(homeLocSub, "%s  -  %d m", buf, (int)me->alt);
+            else
+                lv_label_set_text(homeLocSub, buf);
+            lv_obj_remove_flag(homeLoc, LV_OBJ_FLAG_HIDDEN);
+        } else
+            lv_obj_add_flag(homeLoc, LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_label_set_text_fmt(homeRateSub, "%u total", (unsigned)pktTotal);
+
+    snprintf(buf, sizeof(buf), "%s  -  %s", regionName, presetName);
+    char buf2[160];
+    if (freqMHz > 0)
+        snprintf(buf2, sizeof(buf2), "%s\n%.3f MHz  -  %u hops  -  %d dBm", buf, freqMHz, hopLimit, txPower);
+    else
+        snprintf(buf2, sizeof(buf2), "%s\n%u hops  -  %d dBm", buf, hopLimit, txPower);
+    lv_label_set_text(homeRadio, buf2);
+
+    // last heard: 3 most recent live entries with distinct senders
+    int shown = 0;
+    uint32_t seen[3] = {0};
+    for (uint32_t i = 0; i < liveCount && shown < 3; i++) {
+        const LiveEntry &le = live[(liveHead + HOPTICS_LIVE_ROWS - 1 - i) % HOPTICS_LIVE_ROWS];
+        if (le.from == seen[0] || le.from == seen[1] || le.from == seen[2] || le.from == myNode)
+            continue;
+        seen[shown] = le.from;
+        setBadge(homeLastBadge[shown], le.from);
+        lv_label_set_text(homeLastName[shown], nodeLong(le.from, buf, sizeof(buf)));
+        char ago[12];
+        agoString(le.time, ago, sizeof(ago));
+        if (le.hops == 0 && le.rssi != 0)
+            snprintf(buf2, sizeof(buf2), "%.1fdB  %s", le.snr, ago);
+        else if (le.hops > 0)
+            snprintf(buf2, sizeof(buf2), "%dhop  %s", le.hops, ago);
+        else
+            snprintf(buf2, sizeof(buf2), "%s", ago);
+        lv_label_set_text(homeLastInfo[shown], buf2);
+        lv_obj_set_user_data(homeLast[shown], (void *)(uintptr_t)le.from);
+        lv_obj_remove_flag(homeLast[shown], LV_OBJ_FLAG_HIDDEN);
+        shown++;
+    }
+    for (int i = shown; i < 3; i++)
+        lv_obj_add_flag(homeLast[i], LV_OBJ_FLAG_HIDDEN);
+}
