+void HopticsView::addOrUpdateNode(uint32_t nodeNum, uint8_t channel, uint32_t lastHeard, const meshtastic_User &cfg)
+{
+    nodes[nodeNum] = nullptr; // lets the base class know this node exists
+    nodeChannels[nodeNum] = channel;
+    nodeHasKey[nodeNum] = cfg.public_key.size == 32;
+    if (nodeNum == ownNode)
+        myUser = cfg;
+    ui.upsertNode(nodeNum, channel, lastHeard, cfg.short_name, cfg.long_name, (uint8_t)cfg.role, cfg.public_key.size == 32,
+                  false, (uint16_t)cfg.hw_model);
+    nodeCount = nodes.size();
+    nodeCountSeen = nodeCount;
+}
