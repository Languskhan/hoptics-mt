+    column(chatMsgs, 6);
+    lv_obj_set_style_width(chatMsgs, 3, LV_PART_SCROLLBAR);
+    lv_obj_set_style_bg_color(chatMsgs, C_CYAN, LV_PART_SCROLLBAR);
+    stop(chatMsgs); // keys scroll the conversation when it has the focus
+    // trackball: the first press starts scrolling (LVGL edit mode), the next press ends it
