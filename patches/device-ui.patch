+void HopticsUI::buildMap(lv_obj_t *p)
+{
+    static bool prefLoaded = false;
+    if (!prefLoaded) {
+        prefLoaded = true;
+        mapTiles = loadMapPref();
+        hoptics::TileMap::get().setAllocator(lv_malloc, lv_free); // view buffer + decoder live in the LVGL pool
+        hoptics::TileMap::get().setEnabled(mapTiles);
+    }
+    lv_obj_remove_flag(p, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_pad_row(p, 4, 0);
+
+    lv_obj_t *bar = plain(p);
+    lv_obj_set_size(bar, LV_PCT(100), 26);
+    row(bar, 4);
+    struct B {
+        const char *t;
+        int id;
+    } btns[] = {{LV_SYMBOL_REFRESH " Fit", 0}, {LV_SYMBOL_MINUS, 1}, {LV_SYMBOL_PLUS, 2}};
+    for (auto &b : btns) {
+        lv_obj_t *o = flatButton(bar, b.t, C_CYAN, b.id == 0 ? 56 : 34, 24);
+        lv_obj_set_user_data(o, (void *)(intptr_t)b.id);
+        stop(o);
+        lv_obj_add_event_cb(
+            o,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                int id = (int)(intptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                ui->mapZoom(id == 0 ? 0 : id == 2 ? 1 : -1);
+            },
+            LV_EVENT_CLICKED, this);
+    }
+    mapRange = label(bar, FSMALL, C_MUTED, "");
+    lv_obj_set_flex_grow(mapRange, 1);
+    lv_obj_set_style_text_align(mapRange, LV_TEXT_ALIGN_RIGHT, 0);
+    oneLine(mapRange);
+
+    mapArea = plain(p);
+    lv_obj_set_width(mapArea, LV_PCT(100));
+    lv_obj_set_flex_grow(mapArea, 1);
+    lv_obj_set_style_bg_color(mapArea, C_CARD, 0);
+    lv_obj_set_style_bg_opa(mapArea, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(mapArea, 10, 0);
+    lv_obj_set_style_clip_corner(mapArea, true, 0);
+    if (T_BORDERS) {
+        lv_obj_set_style_border_width(mapArea, 1, 0);
+        lv_obj_set_style_border_color(mapArea, C_LINE, 0);
+    }
+    // drag anywhere on the map (dots included) to move it
+    lv_obj_add_flag(mapArea, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_event_cb(
+        mapArea, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->mapTouch(e); }, LV_EVENT_ALL, this);
+    // keys: Enter on the focused map starts / stops panning with the arrows or trackball
+    stop(mapArea);
+    lv_obj_add_event_cb(
+        mapArea,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (isKeyIndev(lv_indev_active()))
+                ui->setMapPan(!ui->mapPan);
+        },
+        LV_EVENT_CLICKED, this);
+
+    // everything that moves with the map sits on one layer, so a drag is a single position change
+    mapLayer = plain(mapArea);
+    lv_obj_remove_flag(mapLayer, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(mapLayer, LV_OBJ_FLAG_EVENT_BUBBLE);
+    lv_obj_set_size(mapLayer, LV_PCT(100), LV_PCT(100));
+
+    mapImg = lv_image_create(mapLayer);
+    lv_obj_remove_flag(mapImg, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(mapImg, 0, 0);
+    if (mapDsc.data)
+        lv_image_set_src(mapImg, &mapDsc); // the picture survives a theme switch; it is redrawn in the new style
+    else
+        lv_obj_add_flag(mapImg, LV_OBJ_FLAG_HIDDEN);
+
+    for (int i = 0; i < 3; i++) {
+        mapRings[i] = plain(mapLayer);
+        lv_obj_set_style_radius(mapRings[i], LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_border_width(mapRings[i], 1, 0);
+        lv_obj_remove_flag(mapRings[i], LV_OBJ_FLAG_CLICKABLE);
+        mapRingLbl[i] = label(mapLayer, FSMALL, C_DIM, "");
+    }
+    for (int i = 0; i < HOPTICS_MAP_MARKERS; i++) {
+        mapLinks[i] = lv_line_create(mapLayer);
+        lv_obj_set_style_line_width(mapLinks[i], 2, 0);
+        lv_obj_set_style_line_opa(mapLinks[i], LV_OPA_50, 0);
+        lv_obj_set_style_line_rounded(mapLinks[i], true, 0);
+        lv_obj_add_flag(mapLinks[i], LV_OBJ_FLAG_HIDDEN);
+        lv_obj_remove_flag(mapLinks[i], LV_OBJ_FLAG_CLICKABLE);
+    }
+    for (int i = 0; i < HOPTICS_MAP_MARKERS; i++) {
+        lv_obj_t *d = plain(mapLayer);
+        lv_obj_set_size(d, 10, 10);
+        lv_obj_set_style_radius(d, LV_RADIUS_CIRCLE, 0);
+        lv_obj_set_style_bg_opa(d, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(d, 1, 0);
+        lv_obj_set_style_border_color(d, C_BG, 0);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_EVENT_BUBBLE); // a drag that starts on a dot still moves the map
+        lv_obj_add_flag(d, LV_OBJ_FLAG_OVERFLOW_VISIBLE);
+        lv_obj_set_ext_click_area(d, 10);
+        lv_obj_t *l = label(d, FSMALL, C_MUTED, "");
+        lv_obj_set_pos(l, 12, -4);
+        // a little backing so names stay readable over streets
+        lv_obj_set_style_bg_color(l, C_BG, 0);
+        lv_obj_set_style_bg_opa(l, LV_OPA_60, 0);
+        lv_obj_set_style_pad_hor(l, 2, 0);
+        lv_obj_set_style_radius(l, 3, 0);
+        lv_obj_add_event_cb(
+            d,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                if (ui->mapJustDragged)
+                    return; // the press was a drag, not a tap
+                uint32_t num = (uint32_t)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                if (num)
+                    ui->openNode(num);
+            },
+            LV_EVENT_CLICKED, this);
+        lv_obj_add_flag(d, LV_OBJ_FLAG_HIDDEN);
+        mapDots[i] = d;
+    }
+    mapMe = plain(mapLayer);
+    lv_obj_set_size(mapMe, 14, 14);
+    lv_obj_set_style_radius(mapMe, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(mapMe, C_CYAN, 0);
+    lv_obj_set_style_bg_opa(mapMe, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_width(mapMe, 2, 0);
+    lv_obj_set_style_border_color(mapMe, C_BG, 0);
+    lv_obj_set_style_shadow_color(mapMe, C_CYAN, 0);
+    lv_obj_set_style_shadow_width(mapMe, 14, 0);
+    lv_obj_set_style_shadow_opa(mapMe, LV_OPA_60, 0);
+    lv_obj_remove_flag(mapMe, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_add_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+
+    mapEmpty = label(mapArea, &F12, C_MUTED, "No positions yet.\nNodes appear here once they share GPS.");
+    lv_obj_set_width(mapEmpty, LV_PCT(90));
+    lv_label_set_long_mode(mapEmpty, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_style_text_align(mapEmpty, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_center(mapEmpty);
+
+    // fixed overlays: tile credit (required by OpenStreetMap) and what the map is waiting for
+    auto pill = [this](lv_obj_t *l) {
+        lv_obj_set_style_bg_color(l, C_BG, 0);
+        lv_obj_set_style_bg_opa(l, LV_OPA_70, 0);
+        lv_obj_set_style_pad_hor(l, 4, 0);
+        lv_obj_set_style_pad_ver(l, 1, 0);
+        lv_obj_set_style_radius(l, 4, 0);
+        lv_obj_remove_flag(l, LV_OBJ_FLAG_CLICKABLE);
+    };
+    mapAttr = label(mapArea, &F12, C_MUTED, "\xC2\xA9 OpenStreetMap");
+    pill(mapAttr);
+    lv_obj_align(mapAttr, LV_ALIGN_BOTTOM_RIGHT, -3, -3);
+    lv_obj_add_flag(mapAttr, LV_OBJ_FLAG_HIDDEN);
+    mapNote = label(mapArea, FSMALL, C_TEXT, "");
+    pill(mapNote);
+    lv_obj_align(mapNote, LV_ALIGN_TOP_LEFT, 4, 4);
+    lv_obj_add_flag(mapNote, LV_OBJ_FLAG_HIDDEN);
+    mapPan = false;
+}
