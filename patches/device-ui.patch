+// ================================================================= basics
+namespace
+{
+// temperature / pressure units picked in Settings > SENSORS (NVS "hoptics"; -1 = not picked yet)
+void loadEnvUnits(int8_t &f, int8_t &inhg)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READONLY, &h) == ESP_OK) {
+        int8_t v;
+        if (nvs_get_i8(h, "envf", &v) == ESP_OK)
+            f = v;
+        if (nvs_get_i8(h, "envinhg", &v) == ESP_OK)
+            inhg = v;
+        nvs_close(h);
+    }
+#else
+    (void)f;
+    (void)inhg;
+#endif
+}
+
+// temperature correction (tenths of a degree C): the firmware reads the same key when it reads the sensors
+int16_t loadEnvTempOff(void)
+{
+    int16_t v = 0;
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READONLY, &h) == ESP_OK) {
+        nvs_get_i16(h, "envtoff", &v);
+        nvs_close(h);
+    }
+#endif
+    return v;
+}
+
+void saveEnvTempOff(int16_t v)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READWRITE, &h) == ESP_OK) {
+        nvs_set_i16(h, "envtoff", v);
+        nvs_commit(h);
+        nvs_close(h);
+    }
+#else
+    (void)v;
+#endif
+}
+
+void saveEnvUnits(int8_t f, int8_t inhg)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READWRITE, &h) == ESP_OK) {
+        nvs_set_i8(h, "envf", f);
+        nvs_set_i8(h, "envinhg", inhg);
+        nvs_commit(h);
+        nvs_close(h);
+    }
+#else
+    (void)f;
+    (void)inhg;
+#endif
+}
+
+// sensor history lives in PSRAM when the board has some (internal RAM is the scarce kind)
+int16_t *allocEnvHistory(size_t n)
+{
+    size_t bytes = n * sizeof(int16_t);
+#if defined(ARDUINO_ARCH_ESP32)
+    int16_t *p = (int16_t *)heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!p)
+        p = (int16_t *)malloc(bytes);
+#else
+    int16_t *p = (int16_t *)malloc(bytes);
+#endif
+    if (p)
+        for (size_t i = 0; i < n; i++)
+            p[i] = INT16_MIN;
+    return p;
+}
+} // namespace
+
+HopticsUI::HopticsUI(void)
+{
+    envHist = allocEnvHistory(3 * HOPTICS_ENV_HISTORY);
+    for (uint32_t i = 0; i < kMaxChannels; i++) {
+        channelNames[i][0] = 0;
+        channelEnabled[i] = false;
