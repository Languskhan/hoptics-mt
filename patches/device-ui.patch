+void HopticsUI::onPacket(uint32_t from, uint32_t to, uint16_t port, int8_t hops, int16_t rssi, float snr, uint32_t time, bool viaMqtt)
+{
+    if (from == myNode)
+        return;
+    uint32_t t = time ? time : nowTs;
+    Node &n = nodeRef(from);
+    n.packets++;
+    if (t > n.lastHeard)
+        n.lastHeard = t;
+    if (viaMqtt)
+        n.viaMqtt = true;
+
+    LiveEntry &le = live[liveHead];
+    le.from = from;
+    le.to = to;
+    le.port = port;
+    le.hops = hops;
+    le.rssi = rssi;
+    le.snr = snr;
+    le.time = t;
+    le.viaMqtt = viaMqtt;
+    liveHead = (liveHead + 1) % HOPTICS_LIVE_ROWS;
+    if (liveCount < HOPTICS_LIVE_ROWS)
+        liveCount++;
+
+    pktTotal++;
+    pktThisMinute++;
+    if (viaMqtt) {
+        pktMqtt++;
+        portCounts[7]++;
+    } else if (hops == 0)
+        pktDirect++;
+    int cat;
+    switch (port) {
+    case P_TEXT:
+    case P_TEXT_COMP:
+        cat = 0;
+        break;
+    case P_POSITION:
+        cat = 1;
+        break;
+    case P_NODEINFO:
+        cat = 2;
+        break;
+    case P_TELEMETRY:
+        cat = 3;
+        break;
+    case P_ROUTING:
+        cat = 4;
+        break;
+    case P_TRACE:
+    case P_NEIGHBOR:
+        cat = 5;
+        break;
+    default:
+        cat = 6;
+    }
+    portCounts[cat]++;
+
+    if (rssi != 0 && !viaMqtt) {
+        memmove(sigRssi, sigRssi + 1, sizeof(int32_t) * (HOPTICS_SIGNAL_HISTORY - 1));
+        memmove(sigSnr, sigSnr + 1, sizeof(int32_t) * (HOPTICS_SIGNAL_HISTORY - 1));
+        sigRssi[HOPTICS_SIGNAL_HISTORY - 1] = rssi;
+        sigSnr[HOPTICS_SIGNAL_HISTORY - 1] = (int32_t)lroundf(snr);
+        if (mainScreen) {
+            lv_chart_set_next_value(statSigChart, serRssi, rssi);
+            lv_chart_set_next_value(statSigChart, serSnr, (int32_t)lroundf(snr));
+        }
+    }
+    mapPing(from, port, viaMqtt, hops);
+    dirtyLive = dirtyHome = dirtyStats = dirtyNodes = true;
+    if (from == nodeOvNum)
+        dirtyNodeOv = true;
+}
+
+void HopticsUI::addMessage(uint32_t key, uint32_t from, uint32_t time, const char *text, uint32_t requestId, uint8_t status,
+                           bool restoring)
+{
+    Conv &c = convRef(key);
+    if (c.msgs.size() >= HOPTICS_MSGS_PER_CONV)
+        c.msgs.erase(c.msgs.begin());
+    c.msgs.push_back(Msg{from, time ? time : nowTs, requestId, status, text ? text : ""});
+    c.lastTime = c.msgs.back().time;
+    const bool open = mainScreen && chatKey == key && !lv_obj_has_flag(chatOv, LV_OBJ_FLAG_HIDDEN);
+    if (from != myNode && !open && (!restoring || status == eUnread))
+        c.unread++;
+    dirtyChats = true;
+    if (open) {
+        if (c.msgs.size() == 1)
+            rebuildChatMessages();
+        else {
+            appendBubble(c.msgs.back());
+            lv_obj_update_layout(chatMsgs);
+            lv_obj_scroll_to_y(chatMsgs, LV_COORD_MAX, LV_ANIM_ON);
+        }
+    }
+    if (!restoring && from != myNode && !open && bannerOn && mainScreen) {
+        char who[48], title[64];
+        nodeLong(from, who, sizeof(who));
+        std::string t;
+        if (key < kMaxChannels)
+            t = std::string(LV_SYMBOL_ENVELOPE " ") + who + "  " + convTitle(key, title, sizeof(title)) + "\n" + (text ? text : "");
+        else
+            t = std::string(LV_SYMBOL_ENVELOPE " ") + who + "\n" + (text ? text : "");
+        showToast(t.c_str(), 5000);
+        lv_obj_set_user_data(toast, (void *)(uintptr_t)(key + 1));
+    }
+    refreshStatusBar();
+}
