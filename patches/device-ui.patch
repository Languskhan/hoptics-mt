+    lv_obj_set_flex_grow(body, 1);
+    lv_obj_add_flag(body, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(body, LV_DIR_VER);
+    lv_obj_set_style_pad_all(body, PAD, 0);
+    column(body, PAD);
+
+    lv_obj_t *nc = card(body, "NOW  -  this radio's sensors");
+    stop(nc);
+    envOvNow = label(nc, &F20, C_TEXT, "");
+    lv_obj_set_width(envOvNow, LV_PCT(100));
+    lv_label_set_long_mode(envOvNow, LV_LABEL_LONG_MODE_WRAP);
+    envOvMeta = label(nc, &F12, C_MUTED, "");
+    lv_obj_set_width(envOvMeta, LV_PCT(100));
+    lv_label_set_long_mode(envOvMeta, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_style_text_line_space(envOvMeta, 3, 0);
+
+    const lv_color_t cols[3] = {C_AMBER, C_BLUE, C_VIOLET};
+    for (int k = 0; k < 3; k++) {
+        lv_obj_t *c = card(body, ENV_TITLES[k]);
+        stop(c);
+        envOvChart[k] = makeChart(c, LAND ? 56 : 72, LV_CHART_TYPE_LINE, 12);
+        envOvSer[k] = lv_chart_add_series(envOvChart[k], cols[k], LV_CHART_AXIS_PRIMARY_Y);
+        envOvCap[k] = label(c, FSMALL, C_MUTED, "");
+    }
+
+    envOvNearbyCard = card(body, "SENSORS ON THE MESH");
+    stop(envOvNearbyCard);
+    envOvNearby = plain(envOvNearbyCard);
+    lv_obj_set_size(envOvNearby, LV_PCT(100), LV_SIZE_CONTENT);
+    column(envOvNearby, 2);
+
+    lv_obj_t *hint = label(body, FSMALL, C_DIM,
+                           "Graphs are 5-minute averages since the radio started (up to 24 h). Units and sharing: "
+                           "Settings > SENSORS.");
+    lv_obj_set_width(hint, LV_PCT(100));
+    lv_label_set_long_mode(hint, LV_LABEL_LONG_MODE_WRAP);
+}
