+void HopticsView::updateRingtone(const char rtttl[231])
+{
+    int found = -1;
+    for (int t = 0; t < HopticsUI::kToneCount && found < 0; t++) {
+        const char *name = HopticsUI::toneLibraryName(t);
+        for (int i = 0; i < numRingtones; i++)
+            if (strcmp(ringtone[i].name, name) == 0 && strncmp(ringtone[i].rtttl, rtttl, 230) == 0) {
+                found = t;
+                break;
+            }
+    }
+    if (found < 0 && strncmp(rtttl, "Silent:", 7) == 0)
+        found = 0;
+    ui.setRingtone(found); // -1 = something else, set from a phone app
+}
