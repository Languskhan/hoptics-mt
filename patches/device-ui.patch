+void HopticsUI::openSettings(void)
+{
+    settingsLoading = true;
+    lv_slider_set_value(setBright, brightness, LV_ANIM_OFF);
+    uint32_t ti = 2;
+    for (uint32_t i = 0; i < sizeof(TIMEOUTS) / sizeof(TIMEOUTS[0]); i++)
+        if (TIMEOUTS[i] == screenTimeout)
+            ti = i;
+    lv_dropdown_set_selected(setTimeout, ti);
+    if (bannerOn)
+        lv_obj_add_state(setBanner, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setBanner, LV_STATE_CHECKED);
+    if (bluetoothOn)
+        lv_obj_add_state(setBt, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setBt, LV_STATE_CHECKED);
+    if (!hasBluetooth)
+        lv_obj_add_state(setBt, LV_STATE_DISABLED);
+    lv_dropdown_set_selected(setThemeDd, (uint32_t)themeIdx);
+    if (webChat)
+        lv_obj_add_state(setWebChatSw, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setWebChatSw, LV_STATE_CHECKED);
+    if (toneIdx >= 0 && toneIdx < kToneCount)
+        lv_dropdown_set_selected(setToneDd, (uint32_t)toneIdx);
+    if (mapTiles)
+        lv_obj_add_state(setMapSw, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setMapSw, LV_STATE_CHECKED);
+    lv_dropdown_set_selected(setEnvTempDd, tempF() ? 0 : 1);
+    refreshEnvCorr();
+    lv_dropdown_set_selected(setEnvPressDd, pressInHg() ? 0 : 1);
+    if (envShare)
+        lv_obj_add_state(setEnvShareSw, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setEnvShareSw, LV_STATE_CHECKED);
+    {
+        uint32_t secs = envShareSecs ? envShareSecs : 1800, best = 0;
+        for (uint32_t i = 0; i < sizeof(ENV_SHARE_SECS) / sizeof(ENV_SHARE_SECS[0]); i++)
+            if (ENV_SHARE_SECS[i] <= secs)
+                best = i;
+        lv_dropdown_set_selected(setEnvEveryDd, best);
+    }
+    hoptics::TileMap::get().wake(); // reads the saved-tile index if the map has not been opened yet
+    mapNoteTick = 0;                // refresh the "Saved:" line right away
+    if (!hasBluetooth)
+        lv_label_set_text(setBtPin, "No Bluetooth on this device");
+    else if (bluetoothOn && btPin)
+        lv_label_set_text_fmt(setBtPin, LV_SYMBOL_BLUETOOTH "  PIN  %06u", (unsigned)btPin);
+    else
+        lv_label_set_text(setBtPin, bluetoothOn ? LV_SYMBOL_BLUETOOTH "  PIN: random (set on pairing)" : "Bluetooth is off");
+    if (wifiOn)
+        lv_obj_add_state(setWifiSw, LV_STATE_CHECKED);
+    else
+        lv_obj_remove_state(setWifiSw, LV_STATE_CHECKED);
+    lv_textarea_set_text(setSsid, wifiSsid);
+    lv_textarea_set_text(setPsk, "");
+    lv_textarea_set_placeholder_text(setPsk, wifiHasPsk ? (LAND ? "saved - blank keeps" : "saved - blank keeps it") : "network password");
+    // GPS switch: boards known to have a receiver always; others only when one is configured
+    if (gpsMode < 0 || (gpsMode == 2 && !hoptics::board::kGps)) {
+        lv_obj_add_flag(setGpsRow, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_remove_flag(setGpsRow, LV_OBJ_FLAG_HIDDEN);
+        if (gpsMode == 1)
+            lv_obj_add_state(setGpsSw, LV_STATE_CHECKED);
+        else
+            lv_obj_remove_state(setGpsSw, LV_STATE_CHECKED);
+    }
+    if (lnaMode == 2) {
+        lv_obj_add_flag(setLnaRow, LV_OBJ_FLAG_HIDDEN); // no controllable LNA on this board
+    } else {
+        lv_obj_remove_flag(setLnaRow, LV_OBJ_FLAG_HIDDEN);
+        lv_dropdown_set_selected(setLnaDd, lnaMode == 3 ? 0 : (lnaMode == 1 ? 1 : 2));
+    }
+    lv_dropdown_set_selected(setRegionDd, optIndex(REGIONS, region));
+    lv_dropdown_set_selected(setPresetDd, optIndex(PRESETS, preset));
+    lv_dropdown_set_selected(setRoleDd, optIndex(ROLES, role));
+    const Node *me = findNode(myNode);
+    lv_textarea_set_text(setShort, me ? me->shortName : "");
+    lv_textarea_set_text(setLong, me ? me->longName : "");
+    if (!canShutdown)
+        lv_obj_add_flag(setShutdownBtn, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_remove_flag(setShutdownBtn, LV_OBJ_FLAG_HIDDEN);
+
+    char buf[400], ipbuf[48];
+    if (wifiOn && wifiUp && ipAddr)
+        snprintf(ipbuf, sizeof(ipbuf), "%u.%u.%u.%u", (unsigned)(ipAddr & 0xff), (unsigned)((ipAddr >> 8) & 0xff),
+                 (unsigned)((ipAddr >> 16) & 0xff), (unsigned)(ipAddr >> 24));
+    else
+        snprintf(ipbuf, sizeof(ipbuf), "%s", wifiOn ? "connecting..." : "Wi-Fi off");
+    snprintf(buf, sizeof(buf),
+             "Node: !%08x\nFirmware: Meshtastic %s\nUI: " HOPTICS_NAME " v" HOPTICS_VERSION "\nIP: %s%s\nBattery: %s",
+             (unsigned)myNode, fwVersion[0] ? fwVersion : "?", ipbuf, mqttUp ? "  (MQTT up)" : "",
+             myBattery <= 100 ? (std::to_string(myBattery) + "%  (" + std::to_string(myVoltage).substr(0, 4) + " V)").c_str()
+                              : (myBattery == 101 ? "external power" : "unknown"));
+    {
+        hoptics::Report &rp = hoptics::Report::get();
+        size_t n = strlen(buf);
+        if (rp.hasCrash())
+            snprintf(buf + n, sizeof(buf) - n, "\nLast crash: %s (%u so far)", rp.crashLine().c_str(), (unsigned)rp.crash().count);
+        else
+            snprintf(buf + n, sizeof(buf) - n, "\nStarted by: %s", rp.lastStart());
+    }
+    lv_label_set_text(setInfo, buf);
+    settingsLoading = false;
+
+    lv_obj_scroll_to_y(lv_obj_get_child(setOv, 1), 0, LV_ANIM_OFF);
+    lv_obj_remove_flag(setOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(setOv, -1);
+    lv_obj_move_to_index(toast, -1);
+    keyScope(setThemeDd); // the first setting, at the top
+}
+
+void HopticsUI::closeSettings(void)
+{
+    hideKeyboard();
+    lv_obj_add_flag(setOv, LV_OBJ_FLAG_HIDDEN);
+    keyScope();
+}
