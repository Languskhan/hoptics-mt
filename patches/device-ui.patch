+    lv_obj_set_style_bg_color(chatInputRow, C_BAR, 0);
+    lv_obj_set_style_bg_opa(chatInputRow, LV_OPA_COVER, 0);
+    lv_obj_set_style_pad_all(chatInputRow, 4, 0);
+    row(chatInputRow, 4);
+
+    chatInput = lv_textarea_create(chatInputRow);
+    lv_textarea_set_one_line(chatInput, true);
+    lv_textarea_set_max_length(chatInput, 200);
+    lv_textarea_set_placeholder_text(chatInput, "Message");
+    lv_obj_set_height(chatInput, LAND ? 34 : 36);
+    lv_obj_set_flex_grow(chatInput, 1);
+    styleTextarea(chatInput);
+    stop(chatInput);
+    lv_obj_add_event_cb(
+        chatInput, [](lv_event_t *e) { HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e); ui->showKeyboard(ui->chatInput); },
+        LV_EVENT_CLICKED, this);
+    lv_obj_add_event_cb(
+        chatInput, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->sendFromChat(); }, LV_EVENT_READY, this);
+
+    lv_obj_t *send = lv_button_create(chatInputRow);
+    lv_obj_remove_style_all(send);
+    lv_obj_set_size(send, 40, LAND ? 34 : 36);
+    lv_obj_set_style_radius(send, LAND ? 17 : 18, 0);
+    lv_obj_set_style_bg_color(send, C_CYAN, 0);
+    lv_obj_set_style_bg_opa(send, LV_OPA_COVER, 0);
+    lv_obj_set_style_bg_color(send, C_GREEN, LV_STATE_PRESSED);
+    lv_obj_t *sl = label(send, &F16, C_ON_ACCENT, LV_SYMBOL_UPLOAD);
+    lv_obj_center(sl);
+    stop(send);
+    lv_obj_add_event_cb(
+        send, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->sendFromChat(); }, LV_EVENT_CLICKED, this);
+}
