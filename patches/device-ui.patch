+// ================================================================= FIRST-BOOT WIZARD
+// A brand-new (or freshly erased) node has no region and won't transmit. Instead of sending people to a
+// phone app, walk them through the three things that matter: region, name, look.
+void HopticsUI::buildWizard(void)
+{
+    wizOv = plain(mainScreen);
+    lv_obj_set_size(wizOv, W(), H());
+    lv_obj_set_style_bg_color(wizOv, C_BG, 0);
+    lv_obj_set_style_bg_opa(wizOv, LV_OPA_COVER, 0);
+    lv_obj_set_style_pad_all(wizOv, LAND ? 10 : 12, 0);
+    column(wizOv, LAND ? 6 : 8);
+    lv_obj_add_flag(wizOv, LV_OBJ_FLAG_HIDDEN);
+
+    lv_obj_t *hdr = plain(wizOv);
+    lv_obj_set_size(hdr, LV_PCT(100), LV_SIZE_CONTENT);
+    row(hdr, 8);
+    lv_obj_t *dot = plain(hdr);
+    lv_obj_set_size(dot, 10, 10);
+    lv_obj_set_style_radius(dot, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(dot, C_CYAN, 0);
+    lv_obj_set_style_bg_opa(dot, LV_OPA_COVER, 0);
+    lv_obj_t *t = label(hdr, &F16, C_TEXT, "Welcome to Hoptics MT");
+    lv_obj_set_flex_grow(t, 1);
+    wizDots = label(LAND ? hdr : wizOv, FSMALL, C_MUTED, ""); // landscape: step counter at the end of the title line
+
+    // page 1: region
+    wizPages[0] = plain(wizOv);
+    lv_obj_set_width(wizPages[0], LV_PCT(100));
+    lv_obj_set_flex_grow(wizPages[0], 1);
+    if (LAND)
+        lv_obj_add_flag(wizPages[0], LV_OBJ_FLAG_SCROLLABLE);
+    column(wizPages[0], LAND ? 6 : 8);
+    lv_obj_t *l = label(wizPages[0], &F20, C_TEXT, "Where are you?");
+    l = label(wizPages[0], &F12, C_MUTED,
+              "Pick your LoRa region. It sets the legal frequencies, and the radio stays silent until it's set.");
+    lv_obj_set_width(l, LV_PCT(100));
+    lv_label_set_long_mode(l, LV_LABEL_LONG_MODE_WRAP);
+    wizRegion = lv_dropdown_create(wizPages[0]);
+    lv_obj_set_width(wizRegion, LV_PCT(100));
+    lv_dropdown_set_options(wizRegion, optString(REGIONS).c_str());
+    lv_dropdown_set_selected(wizRegion, optIndex(REGIONS, 1)); // US is the most common for these kits
+    styleDropdown(wizRegion);
+    stop(wizRegion);
+    l = label(wizPages[0], FSMALL, C_DIM, "US = United States (902-928 MHz)\nEU_868 = Europe   ANZ = Australia / NZ");
+    lv_obj_set_width(l, LV_PCT(100));
+
+    // page 2: names
+    wizPages[1] = plain(wizOv);
+    lv_obj_set_width(wizPages[1], LV_PCT(100));
+    lv_obj_set_flex_grow(wizPages[1], 1);
+    if (LAND)
+        lv_obj_add_flag(wizPages[1], LV_OBJ_FLAG_SCROLLABLE);
+    column(wizPages[1], 6);
+    label(wizPages[1], &F20, C_TEXT, "Name your node");
+    label(wizPages[1], &F12, C_MUTED, "Long name");
+    wizLong = lv_textarea_create(wizPages[1]);
+    lv_textarea_set_one_line(wizLong, true);
+    lv_textarea_set_max_length(wizLong, 39);
+    lv_obj_set_width(wizLong, LV_PCT(100));
+    styleTextarea(wizLong);
+    stop(wizLong);
+    label(wizPages[1], &F12, C_MUTED, "Short name (max 4, shown on maps)");
+    wizShort = lv_textarea_create(wizPages[1]);
+    lv_textarea_set_one_line(wizShort, true);
+    lv_textarea_set_max_length(wizShort, 4);
+    lv_obj_set_width(wizShort, LV_PCT(100));
+    styleTextarea(wizShort);
+    stop(wizShort);
+    for (lv_obj_t *ta : {wizLong, wizShort}) {
+        lv_obj_add_event_cb(
+            ta,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                ui->showKeyboard((lv_obj_t *)lv_event_get_current_target(e));
+            },
+            LV_EVENT_CLICKED, this);
+        lv_obj_add_event_cb(
+            ta,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                ui->hideKeyboard();
+                ui->keyNext();
+            },
+            LV_EVENT_READY, this);
+    }
+
+    // page 3: theme swatches
+    wizPages[2] = plain(wizOv);
+    lv_obj_set_width(wizPages[2], LV_PCT(100));
+    lv_obj_set_flex_grow(wizPages[2], 1);
+    if (LAND)
+        lv_obj_add_flag(wizPages[2], LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_flex_flow(wizPages[2], LV_FLEX_FLOW_ROW_WRAP);
+    lv_obj_set_style_pad_row(wizPages[2], 8, 0);
+    lv_obj_set_style_pad_column(wizPages[2], 8, 0);
+    lv_obj_t *tl = label(wizPages[2], &F20, C_TEXT, "Pick a look");
+    lv_obj_set_width(tl, LV_PCT(100));
+    static const struct {
+        const char *name;
+        uint32_t bg, fg, accent;
+    } sw[4] = {{"Midnight", 0x0A0F14, 0xE6EDF3, 0x22D3EE},
+               {"Daylight", 0xF2F4F7, 0x05090F, 0x0369A1},
+               {"Night Red", 0x000000, 0xE23B3B, 0xFF3B30},
+               {"Amber", 0x050400, 0xFFC24A, 0xFFB000}};
+    for (int i = 0; i < 4; i++) {
+        lv_obj_t *b = lv_button_create(wizPages[2]);
+        lv_obj_remove_style_all(b);
+        lv_obj_set_size(b, (W() - (LAND ? 20 : 24) - 8) / 2, LAND ? 50 : 62);
+        lv_obj_set_style_radius(b, 10, 0);
+        lv_obj_set_style_bg_color(b, lv_color_hex(sw[i].bg), 0);
+        lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+        lv_obj_set_style_border_width(b, 1, 0);
+        lv_obj_set_style_border_color(b, C_LINE, 0);
+        lv_obj_set_style_border_width(b, 3, LV_STATE_CHECKED);
+        lv_obj_set_style_border_color(b, C_CYAN, LV_STATE_CHECKED);
+        lv_obj_t *bar = plain(b);
+        lv_obj_set_size(bar, 26, 6);
+        lv_obj_set_style_radius(bar, 3, 0);
+        lv_obj_set_style_bg_color(bar, lv_color_hex(sw[i].accent), 0);
+        lv_obj_set_style_bg_opa(bar, LV_OPA_COVER, 0);
+        lv_obj_set_pos(bar, 10, LAND ? 10 : 12);
+        lv_obj_t *nl = label(b, &F14, lv_color_hex(sw[i].fg), sw[i].name);
+        lv_obj_set_pos(nl, 10, LAND ? 24 : 30);
+        lv_obj_set_user_data(b, (void *)(intptr_t)i);
+        stop(b);
+        lv_obj_set_style_outline_color(b, lv_color_hex(sw[i].fg), LV_STATE_FOCUS_KEY); // the swatch's own text colour
+        if (i == themeIdx)
+            lv_obj_add_state(b, LV_STATE_CHECKED);
+        lv_obj_add_event_cb(
+            b,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                lv_obj_t *btn = (lv_obj_t *)lv_event_get_current_target(e);
+                ui->wizTheme = (int)(intptr_t)lv_obj_get_user_data(btn);
+                lv_obj_t *page = lv_obj_get_parent(btn);
+                for (uint32_t c = 1; c < lv_obj_get_child_count(page); c++)
+                    lv_obj_remove_state(lv_obj_get_child(page, c), LV_STATE_CHECKED);
+                lv_obj_add_state(btn, LV_STATE_CHECKED);
+            },
+            LV_EVENT_CLICKED, this);
+    }
+
+    // buttons
+    lv_obj_t *bar = plain(wizOv);
+    lv_obj_set_size(bar, LV_PCT(100), LAND ? 36 : 40);
+    row(bar, 8);
+    lv_obj_t *skip = flatButton(bar, "Skip", C_MUTED, 80, LAND ? 34 : 38);
+    lv_obj_t *sp = plain(bar);
+    lv_obj_set_flex_grow(sp, 1);
+    wizNext = flatButton(bar, "Next " LV_SYMBOL_RIGHT, C_CYAN, 110, LAND ? 34 : 38);
+    stop(wizNext);
+    stop(skip);
+    lv_obj_add_flag(skip, F_LAST); // keys reach Next before Skip
+    lv_obj_add_event_cb(
+        skip,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            ui->hideKeyboard();
+            lv_obj_add_flag(ui->wizOv, LV_OBJ_FLAG_HIDDEN);
+            ui->keyScope();
+            ui->showToast(LV_SYMBOL_WARNING " Region not set - the radio stays silent. Set it in Settings.", 5000);
+        },
+        LV_EVENT_CLICKED, this);
+    lv_obj_add_event_cb(
+        wizNext, [](lv_event_t *e) { HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e); ui->wizardStep(ui->wizStep + 1); },
+        LV_EVENT_CLICKED, this);
+}
+
+void HopticsUI::maybeShowWizard(void)
+{
+    if (!mainScreen || !wizOv || wizardShown || !regionKnown || region != 0)
+        return;
+    wizardShown = true;
+    const Node *me = findNode(myNode);
+    lv_textarea_set_text(wizLong, me ? me->longName : "");
+    lv_textarea_set_text(wizShort, me ? me->shortName : "");
+    wizTheme = themeIdx;
+    wizardStep(0);
+    lv_obj_remove_flag(wizOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(wizOv, -1);
+    keyScope(wizRegion);
+}
+
+void HopticsUI::wizardStep(int step)
+{
+    hideKeyboard();
+    if (step >= 3) {
+        // finish: names first, then theme, then region last (a region change reboots the radio)
+        const char *sn = lv_textarea_get_text(wizShort), *ln = lv_textarea_get_text(wizLong);
+        const Node *me = findNode(myNode);
+        if (sn[0] && ln[0] && (!me || strcmp(sn, me->shortName) || strcmp(ln, me->longName)) && cbs.saveUser)
+            cbs.saveUser(sn, ln);
+        int reg = REGIONS[lv_dropdown_get_selected(wizRegion)].value;
+        lv_obj_add_flag(wizOv, LV_OBJ_FLAG_HIDDEN);
+        keyScope();
+        if (cbs.setTheme)
+            cbs.setTheme(wizTheme);
+        if (reg != 0 && cbs.setRegion) {
+            cbs.setRegion(reg);
+            showToast(LV_SYMBOL_REFRESH " Saved. The radio restarts with your region...", 8000);
+        }
+        if (wizTheme != themeIdx) {
+            pendingTheme = wizTheme;
+            lv_async_call([](void *u) { HopticsUI *x = (HopticsUI *)u; x->setTheme(x->pendingTheme); }, this);
+        }
+        return;
+    }
+    wizStep = step;
+    for (int i = 0; i < 3; i++) {
+        if (i == step)
+            lv_obj_remove_flag(wizPages[i], LV_OBJ_FLAG_HIDDEN);
+        else
+            lv_obj_add_flag(wizPages[i], LV_OBJ_FLAG_HIDDEN);
+    }
+    static const char *dots[3] = {"STEP 1 OF 3  -  REGION", "STEP 2 OF 3  -  NAME", "STEP 3 OF 3  -  LOOK"};
+    static const char *shortDots[3] = {"STEP 1 OF 3", "STEP 2 OF 3", "STEP 3 OF 3"}; // landscape: on the title line
+    lv_label_set_text(wizDots, LAND ? shortDots[step] : dots[step]);
+    setButtonText(wizNext, step == 2 ? LV_SYMBOL_OK " Finish" : "Next " LV_SYMBOL_RIGHT);
+    // keys start on the step's own control (on the look page: the swatch picked now)
+    lv_obj_t *first = step == 0 ? wizRegion : step == 1 ? wizLong : lv_obj_get_child(wizPages[2], 1 + wizTheme);
+    keyScope(first);
+}
