+
+void HopticsView::updateLastHeard(uint32_t nodeNum)
+{
+    ui.touchNode(nodeNum, (uint32_t)time(nullptr));
+}
+
+void HopticsView::updateConnectionStatus(const meshtastic_DeviceConnectionStatus &s)
+{
+    bool up = s.has_wifi && s.wifi.has_status && s.wifi.status.is_connected;
+    bool mqtt = (s.has_wifi && s.wifi.has_status && s.wifi.status.is_mqtt_connected) ||
+                (s.has_ethernet && s.ethernet.has_status && s.ethernet.status.is_mqtt_connected);
+    uint32_t ip = up ? s.wifi.status.ip_address : 0;
+    ui.setNetwork(haveNetwork ? network.wifi_enabled : s.has_wifi, up, ip, mqtt, s.has_wifi ? s.wifi.rssi : 0);
+}
+
+void HopticsView::updateChannelConfig(const meshtastic_Channel &ch)
+{
+    if (ch.index == 0 && ch.has_settings)
+        strncpy(channel0Name, ch.settings.name, sizeof(channel0Name) - 1);
+    ui.setChannel((uint8_t)ch.index, ch.has_settings ? ch.settings.name : "", ch.role != meshtastic_Channel_Role_DISABLED);
+    if (ch.index == 0)
+        pushRadioInfo();
+}
+
+void HopticsView::updateDeviceConfig(const meshtastic_Config_DeviceConfig &cfg)
+{
+    device = cfg;
+    haveDevice = true;
+    ui.setDeviceRole((int)cfg.role);
+}
+
+void HopticsView::updateLoRaConfig(const meshtastic_Config_LoRaConfig &cfg)
+{
+    lora = cfg;
+    haveLora = true;
+    pushRadioInfo();
+}
+
+void HopticsView::pushRadioInfo(void)
+{
+    if (!haveLora)
+        return;
+    float freq = 0;
+    if (lora.override_frequency > 0)
+        freq = lora.override_frequency;
+    else if (lora.use_preset && lora.region != meshtastic_Config_LoRaConfig_RegionCode_UNSET) {
+        // same slot logic as the stock MUI: explicit channel_num, else the preset/channel-name default
+        uint32_t slot = lora.channel_num ? lora.channel_num : LoRaPresets::getDefaultSlot(lora.region, lora.modem_preset, channel0Name);
+        freq = LoRaPresets::getRadioFreq(lora.region, lora.modem_preset, slot);
+    }
+    ui.setRadio((int)lora.region, LoRaPresets::loRaRegionToString(lora.region), (int)lora.modem_preset,
+                LoRaPresets::modemPresetToString(lora.modem_preset), lora.use_preset, (uint8_t)lora.hop_limit,
+                (int8_t)lora.tx_power, freq);
+}
+
+void HopticsView::updateBluetoothConfig(const meshtastic_Config_BluetoothConfig &cfg, uint32_t id)
+{
+    bluetooth = cfg;
+    haveBt = true;
+    if (ownNode == 0 && id)
+        ownNode = id; // in phone mode this is the only packet we get, and it carries our node number
+    const uint32_t pin = cfg.mode == meshtastic_Config_BluetoothConfig_PairingMode_FIXED_PIN ? cfg.fixed_pin : 0;
+    ui.setBluetoothEnabled(cfg.enabled, pin);
+    // Bluetooth already on at boot: the firmware is in programming mode and will send nothing else, so show
+    // the phone-mode page with the way back instead of waiting forever on the splash (stock MUI does the same)
+    if (cfg.enabled && state <= eBootScreenDone && state != eWaitingForReboot && state != eProgrammingMode) {
+        ILOG_INFO("Hoptics: radio is in phone app mode (Bluetooth on)");
+        state = eProgrammingMode;
+        ui.showPhoneMode(pin, false);
+    }
+}
+
+void HopticsView::armRebootFallback(void)
+{
+    // the firmware reboots by itself after a Bluetooth change; if that ever does not happen, ask once more
+    lv_timer_t *t = lv_timer_create(
+        [](lv_timer_t *t) {
+            HopticsView *v = (HopticsView *)lv_timer_get_user_data(t);
+            ILOG_WARN("Hoptics: no reboot yet, requesting one");
+            v->controller->requestReboot(1, v->ownNode);
+        },
+        15000, this);
+    lv_timer_set_repeat_count(t, 1);
+}
+
+void HopticsView::updateNetworkConfig(const meshtastic_Config_NetworkConfig &cfg)
+{
+    network = cfg;
+    haveNetwork = true;
+    ui.setNetwork(cfg.wifi_enabled, false, 0, false, 0);
+}
+
+uint8_t HopticsView::nodeChannel(uint32_t num) const
+{
+    auto it = nodeChannels.find(num);
+    return it == nodeChannels.end() ? 0 : it->second;
+}
+
+uint32_t HopticsView::convKeyFor(uint32_t from, uint32_t to, uint8_t ch) const
+{
+    if (to == UINT32_MAX)
+        return ch; // channel conversation
+    return from == ownNode ? to : from; // direct message: keyed by the other party
+}
+
+void HopticsView::packetReceived(const meshtastic_MeshPacket &p)
+{
+    MeshtasticView::packetReceived(p);
+    int8_t hops = (p.hop_start > 0 && p.hop_start >= p.hop_limit) ? (int8_t)(p.hop_start - p.hop_limit) : -1;
+    ui.onPacket(p.from, p.to, (uint16_t)p.decoded.portnum, hops, (int16_t)p.rx_rssi, p.rx_snr, (uint32_t)time(nullptr),
+                p.via_mqtt);
+}
+
+void HopticsView::newMessage(uint32_t from, uint32_t to, uint8_t ch, const char *msg, uint32_t &msgtime, bool restore)
+{
+    ui.addMessage(convKeyFor(from, to, ch), from, msgtime ? msgtime : (uint32_t)time(nullptr), msg, 0,
+                  restore ? HopticsUI::eDefault : HopticsUI::eUnread, restore);
+}
+
+void HopticsView::restoreMessage(const LogMessage &msg)
+{
+    if (msg.trashFlag)
+        return;
+    char text[messagePayloadSize + 1];
+    size_t n = std::min<size_t>(msg._size, messagePayloadSize);
+    memcpy(text, msg.bytes, n);
+    text[n] = 0;
+    ui.addMessage(convKeyFor(msg.from, msg.to, msg.ch), msg.from, (uint32_t)msg.time, text, 0, (uint8_t)msg.status, true);
+}
+
+void HopticsView::textMessageStatus(uint32_t requestId, LogMessage::MsgStatus status)
+{
+    const auto request = requests.findRequest(requestId, ResponseHandler::TextMessageRequest);
+    if (request.type != ResponseHandler::TextMessageRequest)
+        return;
+    const uint32_t channelOrNode = (uint32_t)(uintptr_t)request.cookie;
+    if (channelOrNode < c_max_channels && status == LogMessage::eHeard)
+        status = LogMessage::eAcked; // a rebroadcast heard on a channel is as good as it gets
+    ui.setMessageStatus(requestId, (uint8_t)status);
+    if (status == LogMessage::eAcked || status == LogMessage::eFailed || status == LogMessage::eNoResponse)
+        requests.removeRequest(requestId);
+}
+
+void HopticsView::handleResponse(uint32_t from, uint32_t id, const meshtastic_RouteDiscovery &route)
+{
+    const auto request = requests.findRequest(id, ResponseHandler::TraceRouteRequest);
+    uint32_t target = request.type == ResponseHandler::TraceRouteRequest ? (uint32_t)(uintptr_t)request.cookie : from;
+    auto name = [this](uint32_t n) -> std::string {
+        const HopticsUI::Node *nd = ui.findNode(n);
+        char b[16];
+        if (nd && nd->shortName[0])
+            return nd->shortName;
+        snprintf(b, sizeof(b), "%04x", (unsigned)(n & 0xffff));
+        return b;
+    };
+    auto snr = [](int8_t s) -> std::string {
+        if (s == INT8_MIN)
+            return "";
+        char b[16];
+        snprintf(b, sizeof(b), " (%.1f dB)", s / 4.0f);
+        return b;
+    };
+    // towards: me -> route[0..n-1] -> target, snr_towards[i] measured at hop i
+    std::string t = name(ownNode);
+    for (pb_size_t i = 0; i < route.route_count; i++)
+        t += " > " + name(route.route[i]) + (i < route.snr_towards_count ? snr(route.snr_towards[i]) : "");
+    t += " > " + name(target) +
+         (route.snr_towards_count > route.route_count ? snr(route.snr_towards[route.route_count]) : "");
+    if (route.route_back_count || route.snr_back_count) {
+        t += "\nback: " + name(target);
+        for (pb_size_t i = 0; i < route.route_back_count; i++)
+            t += " > " + name(route.route_back[i]) + (i < route.snr_back_count ? snr(route.snr_back[i]) : "");
+        t += " > " + name(ownNode) +
+             (route.snr_back_count > route.route_back_count ? snr(route.snr_back[route.route_back_count]) : "");
+    }
+    char hops[48];
+    snprintf(hops, sizeof(hops), "\n%u hop%s out", (unsigned)route.route_count + 1, route.route_count == 0 ? "" : "s");
+    ui.showTraceRoute(target, t + hops);
+    if (request.type == ResponseHandler::TraceRouteRequest)
+        requests.removeRequest(id);
+}
