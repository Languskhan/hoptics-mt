+namespace hoptics
+{
+
+#if defined(ARDUINO_ARCH_ESP32)
+namespace
+{
+// A few numbers kept in RTC memory: it is not cleared by a crash or watchdog reset, so at the
+// next start-up we know how long the radio had been running and how much memory was free.
+// After power-on it holds garbage, hence the magic word and check value.
+constexpr uint32_t kMagic = 0x48505431; // "HPT1"
+struct Crumbs {
+    uint32_t magic;
+    uint32_t upSecs;
+    uint16_t heapKB, psramKB;
+    uint8_t streak;
+    uint8_t pad[3];
+    uint32_t check;
+};
+RTC_NOINIT_ATTR Crumbs crumbs;
+
+uint32_t crumbCheck(const Crumbs &c)
+{
+    return (c.magic ^ (c.upSecs * 2654435761u) ^ (((uint32_t)c.heapKB << 16) | c.psramKB) ^ (c.streak * 40503u)) + 0x9e37;
+}
+bool crumbsValid(void)
+{
+    return crumbs.magic == kMagic && crumbs.check == crumbCheck(crumbs);
+}
+void crumbsSeal(void)
+{
+    crumbs.magic = kMagic;
+    crumbs.check = crumbCheck(crumbs);
+}
+
+// "abort() was called at PC 0x4201 on core 0" -> "abort()"; keeps assert text, drops addresses
+void shortReason(const char *in, char *out, size_t len)
+{
+    std::string s(in);
+    size_t p;
+    if ((p = s.find(" was called")) != std::string::npos)
+        s.resize(p);
+    if ((p = s.find(" on core")) != std::string::npos)
+        s.resize(p);
+    if ((p = s.find(" (")) != std::string::npos && s.rfind("assert", 0) != 0)
+        s.resize(p);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '.' || s.back() == '\n'))
+        s.pop_back();
+    snprintf(out, len, "%s", s.c_str());
+}
+} // namespace
+#endif
+
+Report &Report::get(void)
+{
+    static Report r;
+    return r;
+}
+
+const char *Report::board(void)
+{
+    return hoptics::board::kName;
+}
+
+uint32_t Report::uptimeSecs(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    return (uint32_t)(esp_timer_get_time() / 1000000LL);
+#else
+    static auto t0 = std::chrono::steady_clock::now();
+    return (uint32_t)std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - t0).count() + 7980;
+#endif
+}
+
+void Report::memoryKB(uint32_t &heap, uint32_t &psram)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    heap = (uint32_t)(heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024);
+    psram = (uint32_t)(heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024);
+#else
+    heap = 93;
+    psram = 525;
+#endif
+}
+
+std::string Report::duration(uint32_t s)
+{
+    char b[24];
+    if (s < 120)
+        snprintf(b, sizeof(b), "%u s", (unsigned)s);
+    else if (s < 3600)
+        snprintf(b, sizeof(b), "%u min", (unsigned)(s / 60));
+    else if (s < 172800)
+        snprintf(b, sizeof(b), "%u h %u min", (unsigned)(s / 3600), (unsigned)((s / 60) % 60));
+    else
+        snprintf(b, sizeof(b), "%u days", (unsigned)(s / 86400));
+    return b;
+}
+
+void Report::begin(void)
+{
+    if (begun)
+        return;
+    begun = true;
+    load();
+#if defined(ARDUINO_ARCH_ESP32)
+    esp_reset_reason_t rr = esp_reset_reason();
+    uint8_t kind = CK_NONE;
+    const char *why = "power on";
+    switch (rr) {
+    case ESP_RST_POWERON:
+        why = "power on";
+        break;
+    case ESP_RST_EXT:
+        why = "reset button";
+        break;
+    case ESP_RST_SW:
+        why = "restart";
+        break;
+    case ESP_RST_DEEPSLEEP:
+        why = "wake from sleep";
+        break;
+    case ESP_RST_USB:
+    case ESP_RST_JTAG:
+        why = "USB reset";
+        break;
+    case ESP_RST_PANIC:
+    case ESP_RST_CPU_LOCKUP:
+        why = "crash";
+        kind = CK_CRASH;
+        break;
+    case ESP_RST_INT_WDT:
+    case ESP_RST_TASK_WDT:
+    case ESP_RST_WDT:
+        why = "watchdog";
+        kind = CK_WATCHDOG;
+        break;
+    case ESP_RST_BROWNOUT:
+    case ESP_RST_PWR_GLITCH:
+        why = "power dip";
+        kind = CK_POWER;
+        break;
+    default:
+        why = "unknown";
+        break;
+    }
+    snprintf(startText, sizeof(startText), "%s", why);
+
+    bool had = crumbsValid();
+    if (kind != CK_NONE) {
+        CrashRecord r;
+        r.kind = kind;
+        r.count = (uint16_t)(rec.count + 1);
+        r.build = HOPTICS_BUILD;
+        snprintf(r.ver, sizeof(r.ver), "%s", HOPTICS_VERSION);
+        if (had) {
+            r.upSecs = crumbs.upSecs;
+            r.heapKB = crumbs.heapKB;
+            r.psramKB = crumbs.psramKB;
+            r.streak = (uint8_t)((crumbs.upSecs < 120 && crumbs.streak < 250) ? crumbs.streak + 1 : 1);
+        } else {
+            r.streak = 1;
+        }
+        if (kind == CK_POWER) {
+            snprintf(r.reason, sizeof(r.reason), "power dipped");
+        } else {
+            snprintf(r.reason, sizeof(r.reason), "%s",
+                     rr == ESP_RST_TASK_WDT ? "task watchdog" : (rr == ESP_RST_INT_WDT ? "interrupt watchdog" : (kind == CK_WATCHDOG ? "watchdog" : "crash")));
+#if defined(HOPTICS_COREDUMP)
+            // the crash summary the panic handler wrote to the coredump partition
+            if (esp_core_dump_image_check() == ESP_OK) {
+                esp_core_dump_summary_t *s = (esp_core_dump_summary_t *)calloc(1, sizeof(esp_core_dump_summary_t));
+                if (s && esp_core_dump_get_summary(s) == ESP_OK) {
+                    char mine[16] = {0};
+                    esp_app_get_elf_sha256(mine, sizeof(mine));
+                    // an older dump from different firmware would point at the wrong code
+                    if (strncmp((const char *)s->app_elf_sha256, mine, 8) == 0) {
+                        snprintf(r.task, sizeof(r.task), "%s", s->exc_task);
+                        r.pc = s->exc_pc;
+                        uint32_t n = s->exc_bt_info.depth;
+                        uint8_t k = 0;
+                        for (uint32_t i = 0; i < n && i < 16 && k < 8; i++) {
+                            uint32_t a = s->exc_bt_info.bt[i];
+                            if (a && a != r.pc)
+                                r.bt[k++] = a;
+                        }
+                        r.btDepth = k;
+                    }
+                }
+                char pr[96] = {0};
+                if (esp_core_dump_get_panic_reason(pr, sizeof(pr)) == ESP_OK && pr[0])
+                    shortReason(pr, r.reason, sizeof(r.reason));
+                free(s);
+                // the next crash writes a new dump; never report this one twice
+                esp_core_dump_image_erase();
+            }
+#endif
+        }
+        rec = r;
+        fresh = true;
+        save();
+        ILOG_WARN("Hoptics: restarted after %s (%s in %s, pc 0x%08x, up %u s, %u in a row, %u total)", why, rec.reason,
+                  rec.task[0] ? rec.task : "?", (unsigned)rec.pc, (unsigned)rec.upSecs, (unsigned)rec.streak, (unsigned)rec.count);
+    } else {
+        ILOG_INFO("Hoptics: start-up after %s", why);
+    }
+    crumbs.upSecs = 0;
+    crumbs.streak = fresh ? rec.streak : 0;
+    crumbs.heapKB = crumbs.psramKB = 0xffff;
+    crumbsSeal();
+#endif
+}
+
+void Report::tick(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    uint32_t heap, psram;
+    memoryKB(heap, psram);
+    crumbs.upSecs = uptimeSecs();
+    crumbs.heapKB = (uint16_t)(heap > 0xfffe ? 0xfffe : heap);
+    crumbs.psramKB = (uint16_t)(psram > 0xfffe ? 0xfffe : psram);
+    if (crumbs.upSecs >= 120)
+        crumbs.streak = 0; // it stayed up: no longer a restart loop
+    crumbsSeal();
+#endif
+}
+
+void Report::clearCrash(void)
+{
+    rec = CrashRecord();
+    fresh = false;
+    save();
+}
+
+void Report::save(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READWRITE, &h) == ESP_OK) {
+        if (rec.kind == CK_NONE)
+            nvs_erase_key(h, "crash");
+        else
+            nvs_set_blob(h, "crash", &rec, sizeof(rec));
+        nvs_commit(h);
+        nvs_close(h);
+    }
+#endif
+}
+
+void Report::load(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READONLY, &h) == ESP_OK) {
+        CrashRecord r;
+        size_t len = sizeof(r);
+        if (nvs_get_blob(h, "crash", &r, &len) == ESP_OK && len == sizeof(r) && r.version == 1) {
+            r.reason[sizeof(r.reason) - 1] = 0;
+            r.task[sizeof(r.task) - 1] = 0;
+            r.ver[sizeof(r.ver) - 1] = 0;
+            rec = r;
+        }
+        nvs_close(h);
+    }
+#endif
+}
+
+std::string Report::crashLine(void) const
+{
+    if (rec.kind == CK_NONE)
+        return "";
+    std::string s;
+    if (rec.kind == CK_POWER)
+        s = "Power dipped (low battery or loose cable)";
+    else if (rec.kind == CK_WATCHDOG)
+        s = std::string("Froze, restarted by the ") + rec.reason;
+    else
+        s = rec.reason;
+    if (rec.task[0])
+        s += std::string(" in ") + rec.task;
+    if (rec.upSecs)
+        s += ", " + duration(rec.upSecs) + " after start";
+    return s;
+}
+
+// "12s", "4m", "2h13m", "3d" - for the report, where every character counts
+static std::string shortDur(uint32_t s)
+{
+    char b[16];
+    if (s < 120)
+        snprintf(b, sizeof(b), "%us", (unsigned)s);
+    else if (s < 3600)
+        snprintf(b, sizeof(b), "%um", (unsigned)(s / 60));
+    else if (s < 172800)
+        snprintf(b, sizeof(b), "%uh%02um", (unsigned)(s / 3600), (unsigned)((s / 60) % 60));
+    else
+        snprintf(b, sizeof(b), "%ud", (unsigned)(s / 86400));
+    return b;
+}
+
+std::string Report::details(const char *fw, const std::string &status) const
+{
+    // compact on purpose: every character makes the QR code denser
+    char b[160];
+    std::string out;
+    snprintf(b, sizeof(b), "Hoptics %s b%u %s mt%s", HOPTICS_VERSION, (unsigned)HOPTICS_BUILD, board(), fw && fw[0] ? fw : "?");
+    out += b;
+    if (rec.kind != CK_NONE) {
+        static const char *tag[] = {"", "crash", "freeze", "power"};
+        snprintf(b, sizeof(b), "\n%s: %s%s%s up %s x%u/%u b%u", tag[rec.kind], rec.reason, rec.task[0] ? " in " : "", rec.task,
+                 rec.upSecs ? shortDur(rec.upSecs).c_str() : "?", (unsigned)rec.streak, (unsigned)rec.count, (unsigned)rec.build);
+        out += b;
+        if (rec.pc) {
+            snprintf(b, sizeof(b), "\npc %08x bt", (unsigned)rec.pc);
+            out += b;
+            for (int i = 0; i < rec.btDepth && i < 8; i++) {
+                snprintf(b, sizeof(b), " %08x", (unsigned)rec.bt[i]);
+                out += b;
+            }
+        }
+        if (rec.heapKB != 0xffff) {
+            snprintf(b, sizeof(b), "\nbefore %uk/%uk", (unsigned)rec.heapKB, (unsigned)rec.psramKB);
+            out += b;
+        }
+    }
+    uint32_t heap, psram;
+    memoryKB(heap, psram);
+    snprintf(b, sizeof(b), "\nnow: %s, up %s, %uk/%uk", startText, shortDur(uptimeSecs()).c_str(), (unsigned)heap, (unsigned)psram);
+    out += b;
+    if (!status.empty())
+        out += ", " + status;
+    return out;
+}
+
+std::string urlEncode(const std::string &s)
+{
+    static const char *hex = "0123456789ABCDEF";
+    std::string o;
+    o.reserve(s.size() + 16);
+    for (unsigned char c : s) {
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr("-_.~/:,()!*'", c)) {
+            o += (char)c;
+        } else if (c == ' ') {
+            o += '+';
+        } else {
+            o += '%';
+            o += hex[c >> 4];
+            o += hex[c & 15];
+        }
+    }
+    return o;
+}
+
+std::string Report::issueUrl(bool crashTitle, const std::string &details) const
+{
+    std::string title;
+    if (crashTitle && rec.kind == CK_POWER)
+        title = "Restart: power dipped";
+    else if (crashTitle && rec.kind != CK_NONE)
+        title = std::string(rec.kind == CK_WATCHDOG ? "Freeze: " : "Crash: ") + rec.reason;
+    else
+        title = "Problem: ";
+    return std::string(HOPTICS_REPORT_URL "?template=" HOPTICS_REPORT_TEMPLATE "&title=") + urlEncode(title) +
+           "&device=" + urlEncode(details);
+}
+
+} // namespace hoptics
