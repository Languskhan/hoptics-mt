+            if (lv_event_get_code(e) == LV_EVENT_CANCEL)
+                ui->hideKeyboard();
+            else if (lv_event_get_code(e) == LV_EVENT_READY && ui->kbTarget != ui->chatInput)
+                ui->hideKeyboard();
+        },
+        LV_EVENT_ALL, this);
+}
+
+void HopticsUI::showKeyboard(lv_obj_t *ta)
+{
+    if (keysOn && hasKeypad()) {
+        // a real keyboard types into the focused field: no on-screen keyboard over the screen
+        keyScope(ta);
+        return;
+    }
+    kbTarget = ta;
+    lv_keyboard_set_textarea(keyboard, ta);
+    lv_obj_remove_flag(keyboard, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(keyboard, -1);
+    int32_t kbH = lv_obj_get_height(keyboard);
+    // shrink the overlay that owns the textarea so it sits above the keyboard
+    for (lv_obj_t *ov : {chatOv, setOv, wizOv}) {
+        if (!lv_obj_has_flag(ov, LV_OBJ_FLAG_HIDDEN)) {
+            lv_obj_set_height(ov, H() - kbH);
+            lv_obj_update_layout(ov);
+        }
+    }
+    if (ta == chatInput) {
+        lv_obj_scroll_to_y(chatMsgs, LV_COORD_MAX, LV_ANIM_OFF);
+    } else {
+        lv_obj_scroll_to_view_recursive(ta, LV_ANIM_ON);
+    }
+    keyScope(); // trackball-only boards type on the on-screen keyboard
+}
+
+void HopticsUI::hideKeyboard(void)
+{
+    if (!keyboard || lv_obj_has_flag(keyboard, LV_OBJ_FLAG_HIDDEN))
+        return;
+    lv_obj_add_flag(keyboard, LV_OBJ_FLAG_HIDDEN);
+    lv_keyboard_set_textarea(keyboard, nullptr);
+    if (kbTarget)
+        lv_obj_remove_state(kbTarget, LV_STATE_FOCUSED);
+    lv_obj_t *kbTargetWas = kbTarget;
+    kbTarget = nullptr;
+    lv_obj_set_height(chatOv, H());
+    lv_obj_set_height(setOv, H());
+    if (wizOv)
+        lv_obj_set_height(wizOv, H());
+    keyScope(kbTargetWas);
+}
