+uint32_t HopticsView::convKeyFor(uint32_t from, uint32_t to, uint8_t ch) const
+{
+    if (to == UINT32_MAX)
+        return ch; // channel conversation
+    return from == ownNode ? to : from; // direct message: keyed by the other party
+}
+
+void HopticsView::packetReceived(const meshtastic_MeshPacket &p)
+{
+    MeshtasticView::packetReceived(p);
+    int8_t hops = (p.hop_start > 0 && p.hop_start >= p.hop_limit) ? (int8_t)(p.hop_start - p.hop_limit) : -1;
+    ui.onPacket(p.from, p.to, (uint16_t)p.decoded.portnum, hops, (int16_t)p.rx_rssi, p.rx_snr, (uint32_t)time(nullptr),
+                p.via_mqtt);
+}
+
+void HopticsView::newMessage(uint32_t from, uint32_t to, uint8_t ch, const char *msg, uint32_t &msgtime, bool restore)
+{
+    ui.addMessage(convKeyFor(from, to, ch), from, msgtime ? msgtime : (uint32_t)time(nullptr), msg, 0,
+                  restore ? HopticsUI::eDefault : HopticsUI::eUnread, restore);
+}
+
+void HopticsView::restoreMessage(const LogMessage &msg)
+{
+    if (msg.trashFlag)
+        return;
+    char text[messagePayloadSize + 1];
+    size_t n = std::min<size_t>(msg._size, messagePayloadSize);
+    memcpy(text, msg.bytes, n);
+    text[n] = 0;
+    ui.addMessage(convKeyFor(msg.from, msg.to, msg.ch), msg.from, (uint32_t)msg.time, text, 0, (uint8_t)msg.status, true);
+}
+
+void HopticsView::textMessageStatus(uint32_t requestId, LogMessage::MsgStatus status)
+{
+    const auto request = requests.findRequest(requestId, ResponseHandler::TextMessageRequest);
+    if (request.type != ResponseHandler::TextMessageRequest)
+        return;
+    const uint32_t channelOrNode = (uint32_t)(uintptr_t)request.cookie;
+    if (channelOrNode < c_max_channels && status == LogMessage::eHeard)
+        status = LogMessage::eAcked; // a rebroadcast heard on a channel is as good as it gets
+    ui.setMessageStatus(requestId, (uint8_t)status);
+    if (status == LogMessage::eAcked || status == LogMessage::eFailed || status == LogMessage::eNoResponse)
+        requests.removeRequest(requestId);
+}
+
+void HopticsView::handleResponse(uint32_t from, uint32_t id, const meshtastic_RouteDiscovery &route)
+{
+    const auto request = requests.findRequest(id, ResponseHandler::TraceRouteRequest);
+    uint32_t target = request.type == ResponseHandler::TraceRouteRequest ? (uint32_t)(uintptr_t)request.cookie : from;
+    auto name = [this](uint32_t n) -> std::string {
+        const HopticsUI::Node *nd = ui.findNode(n);
+        char b[16];
+        if (nd && nd->shortName[0])
+            return nd->shortName;
+        snprintf(b, sizeof(b), "%04x", (unsigned)(n & 0xffff));
+        return b;
+    };
+    auto snr = [](int8_t s) -> std::string {
+        if (s == INT8_MIN)
+            return "";
+        char b[16];
+        snprintf(b, sizeof(b), " (%.1f dB)", s / 4.0f);
+        return b;
+    };
+    // towards: me -> route[0..n-1] -> target, snr_towards[i] measured at hop i
+    std::string t = name(ownNode);
+    for (pb_size_t i = 0; i < route.route_count; i++)
+        t += " > " + name(route.route[i]) + (i < route.snr_towards_count ? snr(route.snr_towards[i]) : "");
+    t += " > " + name(target) +
+         (route.snr_towards_count > route.route_count ? snr(route.snr_towards[route.route_count]) : "");
+    if (route.route_back_count || route.snr_back_count) {
+        t += "\nback: " + name(target);
+        for (pb_size_t i = 0; i < route.route_back_count; i++)
+            t += " > " + name(route.route_back[i]) + (i < route.snr_back_count ? snr(route.snr_back[i]) : "");
+        t += " > " + name(ownNode) +
+             (route.snr_back_count > route.route_back_count ? snr(route.snr_back[route.route_back_count]) : "");
+    }
+    char hops[48];
+    snprintf(hops, sizeof(hops), "\n%u hop%s out", (unsigned)route.route_count + 1, route.route_count == 0 ? "" : "s");
+    ui.showTraceRoute(target, t + hops);
+    if (request.type == ResponseHandler::TraceRouteRequest)
+        requests.removeRequest(id);
+}
