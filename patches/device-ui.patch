+            if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                if (ui->cbs.reboot)
+                    ui->cbs.reboot();
+                setButtonText(b, "Rebooting...");
+                return;
+            }
+            lv_obj_add_state(b, LV_STATE_USER_1);
+            setButtonText(b, ui->touchInput ? "Tap again" : "Press again");
+            lv_timer_t *t = lv_timer_create(
+                [](lv_timer_t *t) {
+                    lv_obj_t *btn = (lv_obj_t *)lv_timer_get_user_data(t);
+                    lv_obj_remove_state(btn, LV_STATE_USER_1);
+                    setButtonText(btn, LV_SYMBOL_REFRESH " Reboot");
+                },
+                3000, b);
+            lv_timer_set_repeat_count(t, 1);
+        },
+        LV_EVENT_CLICKED, this);
+    lv_obj_add_event_cb(
+        setShutdownBtn,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            lv_obj_t *b = (lv_obj_t *)lv_event_get_current_target(e);
+            if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                if (ui->cbs.shutdown)
+                    ui->cbs.shutdown();
+                setButtonText(b, "Bye...");
+                return;
+            }
+            lv_obj_add_state(b, LV_STATE_USER_1);
+            setButtonText(b, ui->touchInput ? "Tap again" : "Press again");
+            lv_timer_t *t = lv_timer_create(
+                [](lv_timer_t *t) {
+                    lv_obj_t *btn = (lv_obj_t *)lv_timer_get_user_data(t);
+                    lv_obj_remove_state(btn, LV_STATE_USER_1);
+                    setButtonText(btn, LV_SYMBOL_POWER " Off");
+                },
+                3000, b);
+            lv_timer_set_repeat_count(t, 1);
+        },
+        LV_EVENT_CLICKED, this);
+
+    lv_obj_t *repBtn = flatButton(cdv, LV_SYMBOL_WARNING " Report a problem", C_CYAN, W() - 2 * PAD - 16, 36);
+    stop(repBtn);
+    lv_obj_add_event_cb(
+        repBtn, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->openReport(false); }, LV_EVENT_CLICKED, this);
+
+    // support the project: scan with a phone (the radio has no browser)
+    {
+        lv_obj_t *csu = card(body, "SUPPORT THE PROJECT");
+        stop(csu); // read-only: lets keys scroll down to it
+        lv_obj_t *sr = plain(csu);
+        lv_obj_set_size(sr, LV_PCT(100), LV_SIZE_CONTENT);
+        row(sr, 10);
+        lv_obj_t *qb = plain(sr);
+        lv_obj_set_size(qb, 96, 96);
+        lv_obj_set_style_bg_color(qb, lv_color_white(), 0);
+        lv_obj_set_style_bg_opa(qb, LV_OPA_COVER, 0);
+        lv_obj_set_style_radius(qb, 6, 0);
+        lv_obj_t *qr = lv_qrcode_create(qb);
+        lv_qrcode_set_size(qr, 84);
+        lv_qrcode_set_dark_color(qr, lv_color_black());
+        lv_qrcode_set_light_color(qr, lv_color_white());
+        lv_qrcode_update(qr, HOPTICS_SUPPORT_URL, (uint32_t)strlen(HOPTICS_SUPPORT_URL));
+        lv_obj_center(qr);
+        lv_obj_t *st = label(sr, &F12, C_TEXT,
+                             "Hoptics MT is free. If it's useful to you, you can buy me a coffee: scan the code with "
+                             "your phone.");
+        lv_obj_set_flex_grow(st, 1);
+        lv_label_set_long_mode(st, LV_LABEL_LONG_MODE_WRAP);
+        lv_obj_t *su = label(csu, FSMALL, C_MUTED, "buymeacoffee.com/Bluffs");
+        lv_obj_set_width(su, LV_PCT(100));
+    }
+
+    lv_obj_t *about = label(body, FSMALL, C_DIM, HOPTICS_NAME " v" HOPTICS_VERSION "  -  GPL-3.0\nBuilt on Meshtastic device-ui");
+    lv_obj_set_width(about, LV_PCT(100));
+    lv_obj_set_style_text_align(about, LV_TEXT_ALIGN_CENTER, 0);
+}
