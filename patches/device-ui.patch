+bool HopticsView::setupUIConfig(const meshtastic_DeviceUIConfig &uiconfig)
+{
+    if (uiconfig.version == 1) {
+        uiCfg = uiconfig;
+        if (uiCfg.screen_timeout == 1) {
+            uiCfg.screen_timeout = 30;
+            storeUI();
+        }
+    } else {
+        ILOG_WARN("Hoptics: no stored UI config, using defaults");
+        uiCfg = meshtastic_DeviceUIConfig{};
+        uiCfg.version = 1;
+        uiCfg.screen_brightness = 153;
+        uiCfg.screen_timeout = 30;
+        uiCfg.alert_enabled = true;
+        uiCfg.banner_enabled = true;
+        uiCfg.theme = (meshtastic_Theme)0;
+        storeUI();
+    }
+    if (displaydriver->hasLight())
+        displaydriver->setBrightness(uiCfg.screen_brightness);
+    displaydriver->setScreenTimeout(uiCfg.screen_timeout);
+    ui.setUiConfig(uiCfg.screen_brightness, uiCfg.screen_timeout, uiCfg.banner_enabled);
+    // node_highlight.chat_switch is otherwise unused by Hoptics: we keep the "share chat on web" opt-in there
+    ui.setWebChat(uiCfg.has_node_highlight && uiCfg.node_highlight.chat_switch);
+    ui.setTheme((int)uiCfg.theme < HopticsUI::TH_COUNT ? (int)uiCfg.theme : 0);
+    ui.setBootStatus("Loading node database...");
+    state = eSetupUIConfig;
+    return true;
+}
