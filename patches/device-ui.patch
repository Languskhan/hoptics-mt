+        lv_obj_add_flag(p, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_scroll_dir(p, LV_DIR_VER);
+        lv_obj_set_scrollbar_mode(p, LV_SCROLLBAR_MODE_ACTIVE);
+        lv_obj_set_style_pad_all(p, PAD, 0);
+        lv_obj_set_style_width(p, 3, LV_PART_SCROLLBAR);
+        lv_obj_set_style_bg_color(p, C_CYAN, LV_PART_SCROLLBAR);
+        lv_obj_set_style_bg_opa(p, LV_OPA_50, LV_PART_SCROLLBAR);
+        column(p, PAD);
+        lv_obj_add_flag(p, LV_OBJ_FLAG_HIDDEN);
+        pages[i] = p;
+    }
+    buildHome(pages[T_HOME]);
+    buildLive(pages[T_LIVE]);
+    buildMap(pages[T_MAP]);
+    buildChatList(pages[T_CHAT]);
+    buildNodes(pages[T_NODES]);
+    buildStats(pages[T_STATS]);
+    buildNavBar(mainScreen);
+
+    buildChatOverlay();
+    buildNodeOverlay();
+    buildSettingsOverlay();
+    buildWizard();
+    buildKeyboard();
+
+    // toast
+    toast = plain(mainScreen);
+    lv_obj_set_size(toast, W() - 16, LV_SIZE_CONTENT);
+    lv_obj_align(toast, LV_ALIGN_TOP_MID, 0, STATUS_H + 4);
+    lv_obj_set_style_bg_color(toast, C_CARD2, 0);
+    lv_obj_set_style_bg_opa(toast, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_color(toast, C_CYAN, 0);
+    lv_obj_set_style_border_width(toast, 1, 0);
+    lv_obj_set_style_radius(toast, 10, 0);
+    lv_obj_set_style_pad_all(toast, 8, 0);
+    lv_obj_set_style_shadow_width(toast, 16, 0);
+    lv_obj_set_style_shadow_opa(toast, LV_OPA_50, 0);
+    lv_obj_add_flag(toast, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_flag(toast, LV_OBJ_FLAG_CLICKABLE);
+    toastLabel = label(toast, &F14, C_TEXT, "");
+    lv_obj_set_width(toastLabel, LV_PCT(100));
+    lv_label_set_long_mode(toastLabel, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_style_max_height(toastLabel, 40, 0);
+    lv_obj_add_event_cb(
+        toast,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            lv_obj_add_flag(ui->toast, LV_OBJ_FLAG_HIDDEN);
+            uintptr_t key = (uintptr_t)lv_obj_get_user_data(ui->toast);
+            if (key != 0)
+                ui->openChat((uint32_t)(key - 1));
+        },
+        LV_EVENT_CLICKED, this);
+
+    replayCharts();
+    selectTab(T_HOME);
+    refreshStatusBar();
+}
+
+void HopticsUI::replayCharts(void)
+{
+    // repopulate graphs from the model (used after a theme switch rebuilds the screen)
+    for (int i = 0; i < HOPTICS_HISTORY; i++) {
+        lv_chart_set_next_value(statRateChart, serRate, histPktRate[i]);
+        lv_chart_set_next_value(statUtilChart, serChUtil, histChUtil[i]);
+        lv_chart_set_next_value(statUtilChart, serAirUtil, histAirUtil[i]);
+        if (i >= HOPTICS_HISTORY - 30)
+            lv_chart_set_next_value(homeChart, homeSeries, histPktRate[i]);
+    }
+    for (int i = 0; i < HOPTICS_SIGNAL_HISTORY; i++) {
+        lv_chart_set_next_value(statSigChart, serRssi, sigRssi[i]);
+        lv_chart_set_next_value(statSigChart, serSnr, sigSnr[i]);
+    }
+    dirtyHome = dirtyLive = dirtyChats = dirtyNodes = dirtyStats = dirtyMap = true;
+}
+
+void HopticsUI::setTheme(int t)
+{
+    if (t < 0 || t >= TH_COUNT)
+        t = 0;
+    if (t == themeIdx && mainScreen)
+        return;
+    themeIdx = t;
+    if (!mainScreen)
+        return;
+    // rebuild every widget with the new palette; the model is untouched
+    Tab tab = activeTab;
+    bool settingsOpen = setOv && !lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN);
+    if (toastTimer) {
+        lv_timer_delete(toastTimer);
+        toastTimer = nullptr;
+    }
+    lv_anim_delete_all();
+    mapPings = 0;
+    lv_obj_t *old = mainScreen;
+    mainScreen = nullptr;
+    chatKey = UINT32_MAX;
+    nodeOvNum = 0;
+    bubbleRefs.clear();
+    kbTarget = nullptr;
+    buildMainScreen();
+    lv_screen_load(mainScreen);
+    lv_obj_delete(old);
+    selectTab(tab);
+    if (settingsOpen)
+        openSettings();
+}
+
+void HopticsUI::showMainScreen(void)
+{
+    if (!mainScreen)
+        buildMainScreen();
+    lv_screen_load_anim(mainScreen, LV_SCREEN_LOAD_ANIM_FADE_IN, 250, 0, true);
+    bootScreen = nullptr; // auto-deleted by the load animation
+    bootStatus = nullptr;
+    maybeShowWizard();
+}
