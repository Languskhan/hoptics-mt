+const char *compass(uint16_t deg)
+{
+    static const char *pts[8] = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"};
+    return pts[((deg + 22) % 360) / 45];
+}
+constexpr float IN_CITY_KM = 4.0f; // closer than this to a city centre counts as "in" it
+} // namespace
+
+bool HopticsUI::hasCityData(void) const
+{
+    return HOPTICS_HAVE_CITIES != 0;
+}
+
+void HopticsUI::lookupCity(Node &n)
+{
+    if (!n.hasPos) {
+        n.cityIdx = -1;
+        return;
+    }
+    n.cityIdx = nearestCity(n.lat, n.lon, n.cityKm, n.cityBearing);
+}
+
+bool HopticsUI::cityLabel(uint32_t num, char *buf, size_t len)
+{
+    Node *n = nodePtr(num);
+    if (!n || !n->hasPos)
+        return false;
+    if (n->cityIdx == -2)
+        lookupCity(*n);
+    if (n->cityIdx < 0)
+        return false;
+    if (n->cityKm < IN_CITY_KM)
+        snprintf(buf, len, "%s", cityName(n->cityIdx));
+    else
+        snprintf(buf, len, "%.0f km %s of %s", n->cityKm, compass(n->cityBearing), cityName(n->cityIdx));
+    return true;
+}
