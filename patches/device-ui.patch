+        histAirUtil[i] = LV_CHART_POINT_NONE;
+        histPktRate[i] = LV_CHART_POINT_NONE;
+    }
+    for (int i = 0; i < HOPTICS_SIGNAL_HISTORY; i++) {
+        sigRssi[i] = LV_CHART_POINT_NONE;
+        sigSnr[i] = LV_CHART_POINT_NONE;
+    }
+    nodes.reserve(HOPTICS_MAX_NODES);
+}
