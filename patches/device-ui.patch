+void HopticsUI::selectTab(Tab t)
+{
+    hideKeyboard();
+    for (int i = 0; i < T_COUNT; i++) {
+        if (i == t) {
+            lv_obj_remove_flag(pages[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_add_state(navBtns[i], LV_STATE_CHECKED);
+            for (uint32_t c = 0; c < lv_obj_get_child_count(navBtns[i]); c++)
+                lv_obj_add_state(lv_obj_get_child(navBtns[i], c), LV_STATE_CHECKED);
+        } else {
+            lv_obj_add_flag(pages[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_remove_state(navBtns[i], LV_STATE_CHECKED);
+            for (uint32_t c = 0; c < lv_obj_get_child_count(navBtns[i]); c++)
+                lv_obj_remove_state(lv_obj_get_child(navBtns[i], c), LV_STATE_CHECKED);
+        }
+    }
+    activeTab = t;
+    switch (t) {
+    case T_HOME:
+        refreshHome();
+        break;
+    case T_LIVE:
+        refreshLive();
+        break;
+    case T_MAP:
+        if (!mapUserZoom)
+            mapFit();
+        refreshMap();
+        break;
+    case T_CHAT:
+        refreshChatList();
+        break;
+    case T_NODES:
+        refreshNodes();
+        break;
+    case T_STATS:
+        refreshStats();
+        break;
+    default:
+        break;
+    }
+    keyScope();
+}
