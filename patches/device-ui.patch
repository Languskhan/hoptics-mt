+constexpr lv_obj_flag_t F_LAST = LV_OBJ_FLAG_USER_4;  // reached last (e.g. the wizard's Skip, after Next)
+
+bool isKeyIndev(lv_indev_t *in)
+{
+    if (!in)
+        return false;
+    const lv_indev_type_t t = lv_indev_get_type(in);
+    return t == LV_INDEV_TYPE_KEYPAD || t == LV_INDEV_TYPE_ENCODER;
+}
+
+bool anyIndev(lv_indev_type_t type)
+{
+    for (lv_indev_t *in = lv_indev_get_next(nullptr); in; in = lv_indev_get_next(in))
+        if (lv_indev_get_type(in) == type)
+            return true;
+    return false;
+}
+
+bool shown(lv_obj_t *o)
+{
+    for (; o; o = lv_obj_get_parent(o))
+        if (lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN))
+            return false;
+    return true;
+}
+
+void collectStops(lv_obj_t *o, std::vector<lv_obj_t *> &out, std::vector<lv_obj_t *> &last)
+{
+    if (!o)
+        return;
+    if (lv_obj_has_flag(o, F_STOP))
+        (lv_obj_has_flag(o, F_LAST) ? last : out).push_back(o);
+    const uint32_t n = lv_obj_get_child_count(o);
+    for (uint32_t i = 0; i < n; i++)
+        collectStops(lv_obj_get_child(o, i), out, last);
+}
