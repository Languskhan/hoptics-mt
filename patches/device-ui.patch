+// ---------------------------------------------------------------- user actions -> radio
+void HopticsView::wireCallbacks(void)
+{
+    HopticsUI::Callbacks cb;
+    cb.sendText = [this](uint32_t key, const char *text) -> uint32_t {
+        uint32_t to = UINT32_MAX;
+        uint8_t ch = 0;
+        bool usePkc = false;
+        uint8_t hopLimit = haveLora ? lora.hop_limit : 3;
+        uint32_t requestId;
+        if (key < HopticsUI::kMaxChannels) {
+            ch = (uint8_t)key;
+            requestId = requests.addRequest(ch, ResponseHandler::TextMessageRequest, (void *)(intptr_t)ch);
+        } else {
+            to = key;
+            ch = nodeChannel(to);
+            auto it = nodeHasKey.find(to);
+            usePkc = it != nodeHasKey.end() && it->second; // end-to-end encrypted DM when the peer has a public key
+            requestId = requests.addRequest(to, ResponseHandler::TextMessageRequest, (void *)(uintptr_t)to);
+        }
+        controller->sendTextMessage(to, ch, hopLimit, (uint32_t)time(nullptr), requestId, usePkc, text);
+        return requestId;
+    };
+    cb.traceRoute = [this](uint32_t node) {
+        uint32_t id = requests.addRequest(node, ResponseHandler::TraceRouteRequest, (void *)(uintptr_t)node);
+        controller->traceRoute(node, nodeChannel(node), haveLora ? lora.hop_limit : 3, id);
+    };
+    cb.requestPosition = [this](uint32_t node) {
+        uint32_t id = requests.addRequest(node, ResponseHandler::PositionRequest, (void *)(uintptr_t)node);
+        controller->requestPosition(node, nodeChannel(node), id);
+    };
+    cb.setBrightness = [this](uint8_t b) {
+        uiCfg.screen_brightness = b;
+        if (displaydriver->hasLight())
+            displaydriver->setBrightness(b);
+        storeUI();
+    };
+    cb.setScreenTimeout = [this](uint16_t t) {
+        uiCfg.screen_timeout = t;
+        displaydriver->setScreenTimeout(t);
+        storeUI();
+    };
+    cb.setBanner = [this](bool on) {
+        uiCfg.banner_enabled = on;
+        storeUI();
+    };
+    cb.setTheme = [this](int t) {
+        uiCfg.theme = (meshtastic_Theme)t;
+        storeUI();
+    };
+    cb.setWebChat = [this](bool on) {
+        uiCfg.has_node_highlight = true;
+        uiCfg.node_highlight.chat_switch = on;
+        storeUI();
+    };
+    cb.saveUser = [this](const char *s, const char *l) {
+        meshtastic_User u = myUser;
+        strncpy(u.short_name, s, sizeof(u.short_name) - 1);
+        u.short_name[sizeof(u.short_name) - 1] = 0;
+        strncpy(u.long_name, l, sizeof(u.long_name) - 1);
+        u.long_name[sizeof(u.long_name) - 1] = 0;
+        controller->sendConfig(u, ownNode);
+    };
+    cb.setRole = [this](int r) {
+        if (!haveDevice)
+            return;
+        meshtastic_Config_DeviceConfig d = device;
+        d.role = (meshtastic_Config_DeviceConfig_Role)r;
+        controller->sendConfig(std::move(d), ownNode);
+    };
+    cb.setRegion = [this](int r) {
+        if (!haveLora)
+            return;
+        meshtastic_Config_LoRaConfig l = lora;
+        l.region = (meshtastic_Config_LoRaConfig_RegionCode)r;
+        l.use_preset = true;
+        l.tx_enabled = true;
+        controller->sendConfig(std::move(l), ownNode);
+    };
+    cb.setPreset = [this](int p) {
+        if (!haveLora)
+            return;
+        meshtastic_Config_LoRaConfig l = lora;
+        l.use_preset = true;
+        l.modem_preset = (meshtastic_Config_LoRaConfig_ModemPreset)p;
+        l.channel_num = 0; // back to the preset's default slot
+        controller->sendConfig(std::move(l), ownNode);
+    };
+    cb.setBluetooth = [this](bool on) {
+        if (on && haveNetwork && network.wifi_enabled) {
+            meshtastic_Config_NetworkConfig n = network;
+            n.wifi_enabled = false; // Wi-Fi and Bluetooth exclude each other on ESP32 Meshtastic
+            controller->sendConfig(std::move(n), ownNode);
+        }
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = on;
+        if (on) {
+            // a fresh random PIN each time, shown on the phone-mode page - never the well-known default
+            b.mode = meshtastic_Config_BluetoothConfig_PairingMode_FIXED_PIN;
+            b.fixed_pin = randomPin();
+        }
+        controller->sendConfig(std::move(b), ownNode);
+    };
+    // Bluetooth on hands the radio to the phone app: PacketAPI stops feeding this screen until it is off again
+    // (firmware src/mesh/api/PacketAPI.cpp runOnce). Same sequence as the stock MUI enterProgrammingMode().
+    cb.enterPhoneMode = [this]() {
+        if (haveNetwork && network.wifi_enabled) {
+            meshtastic_Config_NetworkConfig n = network;
+            n.wifi_enabled = false; // Wi-Fi and Bluetooth exclude each other on ESP32 Meshtastic
+            controller->sendConfig(std::move(n), ownNode);
+        }
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = true;
+        b.mode = meshtastic_Config_BluetoothConfig_PairingMode_FIXED_PIN;
+        b.fixed_pin = randomPin();
+        bluetooth = b;
+        controller->sendConfig(meshtastic_Config_BluetoothConfig{b}, ownNode);
+        state = eWaitingForReboot;
+        ui.showPhoneMode(b.fixed_pin, true);
+        armRebootFallback();
+    };
+    cb.leavePhoneMode = [this]() {
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = false;
+        bluetooth = b;
+        controller->sendConfig(meshtastic_Config_BluetoothConfig{b}, ownNode); // the firmware saves and reboots
+        state = eWaitingForReboot;
+        armRebootFallback();
+    };
+    cb.setWifi = [this](bool on, const char *ssid, const char *psk) {
+        meshtastic_Config_NetworkConfig n = network;
+        n.wifi_enabled = on;
+        if (ssid) {
+            strncpy(n.wifi_ssid, ssid, sizeof(n.wifi_ssid) - 1);
+            n.wifi_ssid[sizeof(n.wifi_ssid) - 1] = 0;
+        }
+        // "sekrit" is the firmware's keep-the-saved-secret marker (AdminModule writeSecret)
+        strncpy(n.wifi_psk, psk ? psk : "sekrit", sizeof(n.wifi_psk) - 1);
+        n.wifi_psk[sizeof(n.wifi_psk) - 1] = 0;
+        network = n;
+        controller->sendConfig(meshtastic_Config_NetworkConfig{n}, ownNode); // network changes restart the radio
+        armRebootFallback();
+    };
+    cb.setLnaMode = [this](int m) {
+        if (!haveLora)
+            return;
+        meshtastic_Config_LoRaConfig l = lora;
+        l.fem_lna_mode = (meshtastic_Config_LoRaConfig_FEM_LNA_Mode)m;
+        lora = l;
+        controller->sendConfig(meshtastic_Config_LoRaConfig{l}, ownNode); // applied live, no restart
+        controller->requestLoRaConfig(ownNode); // read back: boards without LNA control report "not present"
+    };
+    cb.setRingtone = [this](int idx) {
+        const char *want = HopticsUI::toneLibraryName(idx);
+        const char *rtttl = nullptr;
+        for (int i = 0; want && i < numRingtones; i++)
+            if (strcmp(ringtone[i].name, want) == 0)
+                rtttl = ringtone[i].rtttl;
+        if (!rtttl)
+            return;
+        // the buzzer is on by default on these kits; switch it back on if someone turned it off
+#ifdef USE_I2S_BUZZER
+        // T-Deck: tones play through the I2S speaker; there is no PWM buzzer pin
+        const bool soundOff = !extNotif.enabled || !extNotif.alert_message_buzzer || !extNotif.use_i2s_as_buzzer;
+#else
+        const bool soundOff = !extNotif.enabled || !extNotif.alert_message_buzzer || !extNotif.use_pwm;
+#endif
+        if (idx > 0 && haveExtNotif && soundOff) {
+            extNotif.enabled = true;
+            extNotif.alert_message_buzzer = true;
+#ifdef USE_I2S_BUZZER
+            extNotif.use_i2s_as_buzzer = true;
+            extNotif.use_pwm = false;
+#else
+            extNotif.use_pwm = true;
+#endif
+            controller->sendConfig(meshtastic_ModuleConfig_ExternalNotificationConfig{extNotif}, ownNode);
+            ui.showToast(LV_SYMBOL_AUDIO " Message sound turned on - restarting", 5000);
+            armRebootFallback();
+        }
+        controller->sendConfig(rtttl, ownNode); // the radio plays it once as a preview (firmware patch)
+        uiCfg.ring_tone_id = (uint32_t)idx;
+        uiCfg.alert_enabled = idx > 0;
+        storeUI();
+    };
+    cb.setEnvSharing = [this](bool share, uint32_t secs) {
+        if (!haveTelemetry) {
+            ui.showToast(LV_SYMBOL_WARNING " Radio settings not loaded yet - try again in a moment", 4000);
+            return;
+        }
+        meshtastic_ModuleConfig_TelemetryConfig t = telemetry;
+        t.environment_measurement_enabled = share;
+        t.environment_update_interval = secs;
+        telemetry = t;
+        controller->sendConfig(meshtastic_ModuleConfig_TelemetryConfig{t}, ownNode); // the radio saves and restarts
+        armRebootFallback();
+    };
+    cb.setGps = [this](bool on) {
+        if (!havePosition)
+            return;
+        meshtastic_Config_PositionConfig p = position;
+        p.gps_mode = on ? meshtastic_Config_PositionConfig_GpsMode_ENABLED : meshtastic_Config_PositionConfig_GpsMode_DISABLED;
+        position = p;
+        controller->sendConfig(meshtastic_Config_PositionConfig{p}, ownNode); // the radio saves and restarts
+        armRebootFallback();
+    };
+    cb.reboot = [this]() { controller->requestReboot(5, ownNode); };
+    cb.shutdown = [this]() { controller->requestShutdown(5, ownNode); };
+    // Keyboards that go through device-ui's input policy (ThinkNode M9) have UP / DOWN turned into
+    // "next / previous control" unless the focused control wants them: an open list, the chat being
+    // scrolled, the map being panned.
+    cb.setKeyContext = [](int c) {
+        using input_policy::FocusSemantic;
+        auto &ctx = input_policy::InputContextState::instance();
+        ctx.setFocusSemantic(c == HopticsUI::KC_LIST_OPEN ? FocusSemantic::Dropdown
+                             : c == HopticsUI::KC_SCROLL  ? FocusSemantic::Scrollable
+                             : c == HopticsUI::KC_MAP     ? FocusSemantic::Map
+                                                          : FocusSemantic::Unknown);
+        ctx.setEditMode(c == HopticsUI::KC_LIST_OPEN);
+    };
+    ui.setCallbacks(cb);
+
+    // the M9's dedicated keys (Home, Chat, Map, Preset) arrive as commands from the same input policy
+    using input_policy::UICommand;
+    auto &keys = input_policy::UICommandDispatcher::instance();
+    keys.registerHandler(UICommand::GoHome, [this](const input_policy::CommandPayload &) { ui.keyCommand(HopticsUI::KEY_HOME); });
+    keys.registerHandler(UICommand::OpenChats, [this](const input_policy::CommandPayload &) { ui.keyCommand(HopticsUI::KEY_CHATS); });
+    keys.registerHandler(UICommand::OpenMap, [this](const input_policy::CommandPayload &) { ui.keyCommand(HopticsUI::KEY_MAP); });
+    keys.registerHandler(UICommand::QuickChat,
+                         [this](const input_policy::CommandPayload &) { ui.keyCommand(HopticsUI::KEY_COMPOSE); });
+}
