+    lv_obj_set_style_text_color(mainScreen, C_TEXT, 0);
+    lv_obj_set_style_text_font(mainScreen, &F14, 0);
+
+    buildStatusBar(mainScreen);
+
+    content = plain(mainScreen);
+    lv_obj_set_pos(content, 0, STATUS_H);
+    lv_obj_set_size(content, W(), H() - STATUS_H - NAV_H);
+
+    for (int i = 0; i < T_COUNT; i++) {
+        lv_obj_t *p = plain(content);
