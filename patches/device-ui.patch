+void HopticsUI::refreshLive(void)
+{
+    if (!mainScreen)
+        return;
+    dirtyLive = false;
+    char buf[64], ago[12];
+    for (int i = 0; i < 3; i++) {
+        lv_obj_t *l = lv_obj_get_child(liveChips[i], 0);
+        if (i == liveFilter) {
+            lv_obj_add_state(liveChips[i], LV_STATE_CHECKED);
+            lv_obj_add_state(l, LV_STATE_CHECKED);
+        } else {
+            lv_obj_remove_state(liveChips[i], LV_STATE_CHECKED);
+            lv_obj_remove_state(l, LV_STATE_CHECKED);
+        }
+    }
+    // collect entries matching the filter, newest first
+    uint32_t idx[HOPTICS_LIVE_ROWS];
+    uint32_t n = 0;
+    for (uint32_t i = 0; i < liveCount; i++) {
+        uint32_t k = (liveHead + HOPTICS_LIVE_ROWS - 1 - i) % HOPTICS_LIVE_ROWS;
+        if ((liveFilter == LF_RF && live[k].viaMqtt) || (liveFilter == LF_MQTT && !live[k].viaMqtt))
+            continue;
+        idx[n++] = k;
+    }
+    if (n) {
+        lv_obj_add_flag(liveEmpty, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_remove_flag(liveEmpty, LV_OBJ_FLAG_HIDDEN);
+        lv_label_set_text(liveEmpty, liveFilter == LF_MQTT ? "No MQTT traffic yet.\nNeeds Wi-Fi + the MQTT module, or\n'proxy to client' on a phone link."
+                                                           : "Listening...\nPackets will appear here as they arrive.");
+    }
+    for (uint32_t i = 0; i < HOPTICS_LIVE_ROWS; i++) {
+        LiveRow &r = liveRows[i];
+        if (i >= n) {
+            lv_obj_add_flag(r.row, LV_OBJ_FLAG_HIDDEN);
+            continue;
+        }
+        const LiveEntry &le = live[idx[i]];
+        setBadge(r.badge, le.from);
+        lv_label_set_text(r.name, nodeLong(le.from, buf, sizeof(buf)));
+        lv_label_set_text(r.port, portTag(le.port));
+        lv_color_t pc = portColor(le.port);
+        lv_obj_set_style_text_color(r.port, pc, 0);
+        lv_obj_set_style_bg_color(r.port, pc, 0);
+
+        agoString(le.time, ago, sizeof(ago));
+        const char *dest = le.to == kBroadcast ? "all" : (le.to == myNode ? "me" : "dm");
+        if (le.viaMqtt)
+            snprintf(buf, sizeof(buf), "via MQTT  -  %s  -  %s", dest, ago);
+        else if (le.hops == 0)
+            snprintf(buf, sizeof(buf), "direct  -  %s  -  %s", dest, ago);
+        else if (le.hops > 0)
+            snprintf(buf, sizeof(buf), "%d hop%s  -  %s  -  %s", le.hops, le.hops == 1 ? "" : "s", dest, ago);
+        else
+            snprintf(buf, sizeof(buf), "%s  -  %s", dest, ago);
+        // MQTT rows get a violet edge; light theme outlines every row
+        if (le.viaMqtt) {
+            lv_obj_set_style_border_side(r.row, LV_BORDER_SIDE_LEFT, 0);
+            lv_obj_set_style_border_width(r.row, 3, 0);
+            lv_obj_set_style_border_color(r.row, C_VIOLET, 0);
+        } else if (T_BORDERS) {
+            lv_obj_set_style_border_side(r.row, LV_BORDER_SIDE_FULL, 0);
+            lv_obj_set_style_border_width(r.row, 1, 0);
+            lv_obj_set_style_border_color(r.row, C_LINE, 0);
+        } else {
+            lv_obj_set_style_border_width(r.row, 0, 0);
+        }
+        lv_label_set_text(r.meta, buf);
+        lv_obj_align_to(r.meta, r.port, LV_ALIGN_OUT_RIGHT_MID, 5, 0);
+
+        if (le.rssi != 0 && !le.viaMqtt) {
+            snprintf(buf, sizeof(buf), "%d dBm\n%+.1f dB", le.rssi, le.snr);
+            lv_obj_set_style_text_color(r.sig, snrColor(le.snr), 0);
+        } else
+            snprintf(buf, sizeof(buf), "-");
+        lv_label_set_text(r.sig, buf);
+        lv_obj_align(r.sig, LV_ALIGN_RIGHT_MID, -6, 0);
+        lv_obj_set_user_data(r.row, (void *)(uintptr_t)le.from);
+        lv_obj_remove_flag(r.row, LV_OBJ_FLAG_HIDDEN);
+    }
+}
