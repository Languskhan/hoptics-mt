+void HopticsUI::updateMetrics(uint32_t num, uint8_t battery, float voltage, float chUtil, float airUtil)
+{
+    Node &n = nodeRef(num);
+    if (battery != 255) {
+        n.battery = battery;
+        n.voltage = voltage;
+    }
+    if (chUtil >= 0)
+        n.chUtil = chUtil;
+    if (airUtil >= 0)
+        n.airUtil = airUtil;
+    if (num == myNode) {
+        if (battery != 255) {
+            myBattery = battery;
+            myVoltage = voltage;
+        }
+        if (chUtil >= 0)
+            lastChUtil = chUtil;
+        if (airUtil >= 0)
+            lastAirUtil = airUtil;
+        refreshStatusBar();
+        dirtyHome = true;
+    }
+    dirtyNodes = true;
+    if (num == nodeOvNum)
+        dirtyNodeOv = true;
+}
+
+void HopticsUI::updateSignal(uint32_t num, int16_t rssi, float snr)
+{
+    Node &n = nodeRef(num);
+    n.hasSignal = true;
+    n.rssi = rssi;
+    n.snr = snr;
+    n.hops = 0;
+    dirtyMap = true;
+    n.snrHist[n.snrIdx] = (int8_t)std::max(-127.0f, std::min(127.0f, roundf(snr)));
+    n.snrIdx = (uint8_t)((n.snrIdx + 1) % 16);
+    if (n.snrCount < 16)
+        n.snrCount++;
+    dirtyNodes = dirtyStats = true;
+    if (num == nodeOvNum)
+        dirtyNodeOv = true;
+}
