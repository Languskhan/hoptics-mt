+        r.badge = makeBadge(r.row, 42, 24, &F12);
+        lv_obj_align(r.badge, LV_ALIGN_LEFT_MID, 5, 0);
+        r.name = label(r.row, &F14, C_TEXT, "");
+        oneLine(r.name);
+        lv_obj_set_width(r.name, W() - 2 * PAD - 52 - 70);
+        lv_obj_set_pos(r.name, 52, 3);
+        r.port = pill(r.row, "", C_BLUE);
+        lv_obj_set_pos(r.port, 52, 22);
+        r.meta = label(r.row, FSMALL, C_MUTED, "");
+        lv_obj_align_to(r.meta, r.port, LV_ALIGN_OUT_RIGHT_MID, 5, 0);
+        r.sig = label(r.row, &F12, C_GREEN, "");
+        lv_obj_set_style_text_align(r.sig, LV_TEXT_ALIGN_RIGHT, 0);
+        lv_obj_align(r.sig, LV_ALIGN_RIGHT_MID, -6, 0);
