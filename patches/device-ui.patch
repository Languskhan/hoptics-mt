+void HopticsUI::buildEnvOverlay(void)
+{
+    envOv = overlayPanel("Environment", nullptr, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->closeEnv(); });
+    lv_obj_t *body = plain(envOv);
