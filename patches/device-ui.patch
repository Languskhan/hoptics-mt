+std::string HopticsUI::reportStatus(void) const
+{
+    char b[96];
+    snprintf(b, sizeof(b), "%u nodes, wifi %s, mqtt %s", (unsigned)nodes.size(), wifiOn ? (wifiUp ? "up" : "on") : "off",
+             mqttUp ? "up" : "off");
+    return b;
+}
+
+void HopticsUI::openReport(bool forCrash)
+{
+    if (!repOv)
+        return;
+    hoptics::Report &rp = hoptics::Report::get();
+    repCrash = forCrash && rp.hasCrash();
+    std::string details = rp.details(fwVersion, reportStatus());
+    std::string url = rp.issueUrl(repCrash, details);
+    lv_qrcode_update(repQr, url.data(), (uint32_t)url.size());
+
+    lv_label_set_text(repTitle, repCrash ? "Crash report" : "Report a problem");
+    if (rp.hasCrash()) {
+        lv_color_t c = rp.crash().kind == hoptics::CK_POWER ? C_AMBER : C_RED;
+        lv_obj_set_style_bg_color(repBanner, c, 0);
+        lv_obj_set_style_border_color(repBanner, c, 0);
+        std::string t;
+        if (repCrash && rp.crash().streak >= 3)
+            t = "It keeps restarting. Unplug it if it doesn't settle, and please send this report.\n";
+        else if (repCrash && rp.crash().kind == hoptics::CK_POWER)
+            t = "The radio restarted because its power dipped.\n";
+        else if (repCrash)
+            t = "Hoptics MT restarted after a problem.\n";
+        else
+            t = "Last crash:\n";
+        t += rp.crashLine();
+        lv_label_set_text(repBannerText, t.c_str());
+        lv_obj_remove_flag(repBanner, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_remove_flag(repClearBtn, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(repBanner, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(repClearBtn, LV_OBJ_FLAG_HIDDEN);
+    }
+    // same details as in the code, so a photo of the screen carries them too
+    lv_label_set_text(repText, details.c_str());
+
+    lv_obj_scroll_to_y(repScroll, 0, LV_ANIM_OFF);
+    lv_obj_remove_flag(repOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(repOv, -1);
+    lv_obj_move_to_index(toast, -1);
+    // start at the top; not on a button, so a stray Enter does nothing
+    keyScope(LAND ? lv_obj_get_child(repScroll, (int32_t)lv_obj_get_child_count(repScroll) - 1) : lv_obj_get_child(repScroll, 0));
+}
+
+void HopticsUI::closeReport(void)
+{
+    if (repOv)
+        lv_obj_add_flag(repOv, LV_OBJ_FLAG_HIDDEN);
+    if (repCrash)
+        hoptics::Report::get().ackFresh();
+    repCrash = false;
+    keyScope();
+}
