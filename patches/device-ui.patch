+// ================================================================= SETTINGS
+void HopticsUI::buildSettingsOverlay(void)
+{
+    setOv = overlayPanel("Settings", nullptr, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->closeSettings(); });
+    lv_obj_t *body = plain(setOv);
+    lv_obj_set_width(body, LV_PCT(100));
+    lv_obj_set_flex_grow(body, 1);
+    lv_obj_add_flag(body, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_scroll_dir(body, LV_DIR_VER);
+    lv_obj_set_style_pad_all(body, PAD, 0);
+    column(body, PAD);
+
+    // display
+    lv_obj_t *cd = card(body, "DISPLAY");
+    lv_obj_t *r = settingsRow(cd, "Color theme");
+    setThemeDd = lv_dropdown_create(r);
+    ctlWidth(setThemeDd);
+    // landscape: the dropdown sits beside its label, so the long names lose their explanation
+    lv_dropdown_set_options(setThemeDd, LAND ? "Midnight (dark)\nDaylight (sunlight)\nNight Red\nAmber terminal"
+                                             : "Midnight (dark)\nDaylight (sunlight)\nNight Red (night vision)\nAmber terminal");
+    styleDropdown(setThemeDd);
+    stop(setThemeDd);
+    lv_obj_add_event_cb(
+        setThemeDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int t = (int)lv_dropdown_get_selected(ui->setThemeDd);
+            if (ui->cbs.setTheme)
+                ui->cbs.setTheme(t);
+            // rebuild after this event returns (we are inside a widget that is about to be deleted)
+            lv_async_call([](void *u) { HopticsUI *x = (HopticsUI *)u; x->setTheme(x->pendingTheme); }, ui);
+            ui->pendingTheme = t;
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    r = settingsRow(cd, "Brightness");
+    setBright = lv_slider_create(r);
+    lv_obj_set_width(setBright, LAND ? LV_PCT(60) : LV_PCT(94));
+    lv_obj_set_style_margin_hor(setBright, 6, 0);
+    lv_slider_set_range(setBright, 10, 255);
+    lv_obj_set_style_bg_color(setBright, C_CARD2, LV_PART_MAIN);
+    lv_obj_set_style_bg_color(setBright, C_CYAN, LV_PART_INDICATOR);
+    lv_obj_set_style_bg_color(setBright, C_TEXT, LV_PART_KNOB);
+    stop(setBright);
+    lv_obj_add_event_cb(
+        setBright,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->brightness = (uint8_t)lv_slider_get_value(ui->setBright);
+            if (ui->cbs.setBrightness)
+                ui->cbs.setBrightness(ui->brightness);
+        },
+        LV_EVENT_RELEASED, this);
+    // keys and the trackball change the value without a press / release, so apply each step
+    lv_obj_add_event_cb(
+        setBright,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading || lv_obj_has_state(ui->setBright, LV_STATE_PRESSED))
+                return; // a finger drag applies on release
+            ui->brightness = (uint8_t)lv_slider_get_value(ui->setBright);
+            if (ui->cbs.setBrightness)
+                ui->cbs.setBrightness(ui->brightness);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    r = settingsRow(cd, "Screen off after");
+    setTimeout = lv_dropdown_create(r);
+    ctlWidth(setTimeout);
+    lv_dropdown_set_options(setTimeout, TIMEOUT_OPTS);
+    styleDropdown(setTimeout);
+    stop(setTimeout);
+    lv_obj_add_event_cb(
+        setTimeout,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->screenTimeout = TIMEOUTS[lv_dropdown_get_selected(ui->setTimeout)];
+            if (ui->cbs.setScreenTimeout)
+                ui->cbs.setScreenTimeout(ui->screenTimeout);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    lv_obj_t *br = plain(cd);
+    lv_obj_set_size(br, LV_PCT(100), 30);
+    row(br, 6);
+    lv_obj_t *bl = label(br, &F14, C_TEXT, "Message pop-ups");
+    lv_obj_set_flex_grow(bl, 1);
+    setBanner = lv_switch_create(br);
+    stop(setBanner);
+    lv_obj_set_style_bg_color(setBanner, C_CYAN, (lv_style_selector_t)LV_PART_INDICATOR | LV_STATE_CHECKED);
+    lv_obj_add_event_cb(
+        setBanner,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            ui->bannerOn = lv_obj_has_state(ui->setBanner, LV_STATE_CHECKED);
+            if (ui->cbs.setBanner)
+                ui->cbs.setBanner(ui->bannerOn);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    // message sound: picking one plays it once on the buzzer
+    r = settingsRow(cd, "Message sound (plays a sample)");
+    setToneDd = lv_dropdown_create(r);
+    ctlWidth(setToneDd);
+    {
+        std::string opts;
+        for (int i = 0; i < kToneCount; i++) {
+            if (i)
+                opts += "\n";
+            opts += toneName(i);
+        }
+        lv_dropdown_set_options(setToneDd, opts.c_str());
+    }
+    styleDropdown(setToneDd);
+    stop(setToneDd);
+    lv_obj_add_event_cb(
+        setToneDd,
+        [](lv_event_t *e) {
+            HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+            if (ui->settingsLoading)
+                return;
+            int t = (int)lv_dropdown_get_selected(ui->setToneDd);
+            ui->toneIdx = t;
+            if (ui->cbs.setRingtone)
+                ui->cbs.setRingtone(t);
+            char b[48];
+            snprintf(b, sizeof(b), t ? LV_SYMBOL_AUDIO " Message sound: %s" : LV_SYMBOL_MUTE " Message sound off", toneName(t));
+            ui->showToast(b);
+        },
+        LV_EVENT_VALUE_CHANGED, this);
+
+    // environment sensors
+    lv_obj_t *cs = card(body, "SENSORS");
+    r = settingsRow(cs, "Temperature");
+    setEnvTempDd = lv_dropdown_create(r);
+    ctlWidth(setEnvTempDd);
+    lv_dropdown_set_options(setEnvTempDd, "\xC2\xB0" "F  Fahrenheit\n" "\xC2\xB0" "C  Celsius");
+    styleDropdown(setEnvTempDd);
+    stop(setEnvTempDd);
+    r = settingsRow(cs, "Pressure");
+    setEnvPressDd = lv_dropdown_create(r);
+    ctlWidth(setEnvPressDd);
+    lv_dropdown_set_options(setEnvPressDd, LAND ? "inHg  (inches)\nhPa  (millibars)" : "inHg  inches of mercury\nhPa  hectopascals (mbar)");
+    styleDropdown(setEnvPressDd);
+    stop(setEnvPressDd);
+    r = settingsRow(cs, "Temperature correction");
+    {
+        lv_obj_t *cr = plain(r);
+        ctlWidth(cr);
+        lv_obj_set_height(cr, 36);
+        row(cr, 6);
+        lv_obj_t *minus = flatButton(cr, LV_SYMBOL_MINUS, C_CYAN, 52, 34);
+        stop(minus);
+        setEnvCorr = label(cr, &F16, C_TEXT, "None");
+        lv_obj_set_flex_grow(setEnvCorr, 1);
+        lv_obj_set_style_text_align(setEnvCorr, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_t *plus = flatButton(cr, LV_SYMBOL_PLUS, C_CYAN, 52, 34);
+        stop(plus);
+        lv_obj_add_event_cb(
+            minus, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->stepEnvCorr(-1); }, LV_EVENT_CLICKED, this);
+        lv_obj_add_event_cb(
+            plus, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->stepEnvCorr(1); }, LV_EVENT_CLICKED, this);
+        setEnvCorrNote = label(r, FSMALL, C_DIM, "");
+        lv_obj_set_width(setEnvCorrNote, LV_PCT(100));
+        lv_label_set_long_mode(setEnvCorrNote, LV_LABEL_LONG_MODE_WRAP);
+    }
+    for (lv_obj_t *dd : {setEnvTempDd, setEnvPressDd})
