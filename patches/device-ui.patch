+            HopticsUI *ui = (HopticsUI *)lv_timer_get_user_data(t);
+            lv_obj_add_flag(ui->toast, LV_OBJ_FLAG_HIDDEN);
+            ui->toastTimer = nullptr;
+        },
+        ms, this);
+    lv_timer_set_repeat_count(toastTimer, 1);
+}
