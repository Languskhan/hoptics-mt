+// ================================================================= WEB SNAPSHOT
+namespace
+{
+void jsonStr(std::string &o, const char *s)
+{
+    o += '"';
+    for (const unsigned char *p = (const unsigned char *)s; p && *p; p++) {
+        unsigned char c = *p;
+        if (c == '"' || c == '\\') {
+            o += '\\';
+            o += (char)c;
+        } else if (c < 0x20) {
+            char b[8];
+            snprintf(b, sizeof(b), "\\u%04x", c);
+            o += b;
+        } else if (c == '<') {
+            o += "\\u003c"; // never let a node name close a <script> or inject markup
+        } else
+            o += (char)c;
+    }
+    o += '"';
+}
+void jsonNum(std::string &o, const char *key, double v, bool comma = true)
+{
+    char b[48];
+    if (std::isfinite(v))
+        snprintf(b, sizeof(b), "%s\"%s\":%g", comma ? "," : "", key, v);
+    else
+        snprintf(b, sizeof(b), "%s\"%s\":null", comma ? "," : "", key);
+    o += b;
+}
+} // namespace
+
+void HopticsUI::buildSnapshotJson(std::string &o) const
+{
+    o.clear();
+    o.reserve(8192 + nodes.size() * 180);
+    char b[64];
+    o += "{\"v\":1,\"ui\":";
+    jsonStr(o, HOPTICS_NAME " " HOPTICS_VERSION);
+    o += ",\"fw\":";
+    jsonStr(o, fwVersion);
+    jsonNum(o, "now", nowTs);
+    o += ",\"clock\":";
+    o += clockValid ? "true" : "false";
+    snprintf(b, sizeof(b), ",\"me\":\"!%08x\"", (unsigned)myNode);
+    o += b;
+    o += ",\"radio\":{\"region\":";
+    jsonStr(o, regionName);
+    o += ",\"preset\":";
+    jsonStr(o, presetName);
+    jsonNum(o, "mhz", freqMHz);
+    jsonNum(o, "hops", hopLimit);
+    jsonNum(o, "txdbm", txPower);
+    o += "},\"stats\":{";
+    jsonNum(o, "chutil", lastChUtil, false);
+    jsonNum(o, "airtx", lastAirUtil);
+    jsonNum(o, "pkts", pktTotal);
+    jsonNum(o, "direct", pktDirect);
+    jsonNum(o, "mqtt", pktMqtt);
+    jsonNum(o, "perMin", pktThisMinute);
+    jsonNum(o, "battery", myBattery == 255 ? NAN : myBattery);
+    o += ",\"mqttUp\":";
+    o += mqttUp ? "true" : "false";
+    auto arr = [&](const char *key, const int32_t *a, int n) {
+        o += ",\"";
+        o += key;
+        o += "\":[";
+        for (int i = 0; i < n; i++) {
+            if (i)
+                o += ',';
+            if (a[i] == LV_CHART_POINT_NONE)
+                o += "null";
+            else {
+                snprintf(b, sizeof(b), "%d", (int)a[i]);
+                o += b;
+            }
+        }
+        o += ']';
+    };
+    arr("rateHist", histPktRate, HOPTICS_HISTORY);
+    arr("chHist", histChUtil, HOPTICS_HISTORY);
+    arr("airHist", histAirUtil, HOPTICS_HISTORY);
+    arr("rssiHist", sigRssi, HOPTICS_SIGNAL_HISTORY);
+    arr("snrHist", sigSnr, HOPTICS_SIGNAL_HISTORY);
+    static const char *portNames[8] = {"text", "position", "nodeinfo", "telemetry", "routing", "trace", "other", "mqtt"};
+    o += ",\"ports\":{";
+    for (int i = 0; i < 8; i++)
+        jsonNum(o, portNames[i], portCounts[i], i > 0);
+    o += "}},\"nodes\":[";
+    bool first = true;
+    for (const auto &n : nodes) {
+        if (!first)
+            o += ',';
+        first = false;
+        snprintf(b, sizeof(b), "{\"id\":\"!%08x\",\"short\":", (unsigned)n.num);
+        o += b;
+        jsonStr(o, n.shortName);
+        o += ",\"long\":";
+        jsonStr(o, n.longName);
+        o += ",\"role\":";
+        jsonStr(o, roleName(n.role));
+        jsonNum(o, "last", n.lastHeard);
+        jsonNum(o, "hops", n.hops < 0 ? NAN : n.hops);
+        jsonNum(o, "snr", n.hasSignal ? n.snr : NAN);
+        jsonNum(o, "rssi", n.hasSignal ? n.rssi : NAN);
+        jsonNum(o, "batt", n.battery <= 101 ? n.battery : NAN);
+        jsonNum(o, "pk", n.packets);
+        if (n.hasPos) {
+            jsonNum(o, "lat", n.lat / 1e7);
+            jsonNum(o, "lon", n.lon / 1e7);
+            char cb[80];
+            if (const_cast<HopticsUI *>(this)->cityLabel(n.num, cb, sizeof(cb))) {
+                o += ",\"city\":";
+                jsonStr(o, cb);
+            }
+        }
+        o += ",\"mqtt\":";
+        o += n.viaMqtt ? "true" : "false";
+        o += ",\"me\":";
+        o += n.num == myNode ? "true" : "false";
+        o += '}';
+    }
+    o += "],\"live\":[";
+    for (uint32_t i = 0; i < liveCount; i++) {
+        const LiveEntry &le = live[(liveHead + HOPTICS_LIVE_ROWS - 1 - i) % HOPTICS_LIVE_ROWS];
+        if (i)
+            o += ',';
+        snprintf(b, sizeof(b), "{\"from\":\"!%08x\",\"port\":", (unsigned)le.from);
+        o += b;
+        jsonStr(o, portTag(le.port));
+        o += ",\"to\":";
+        jsonStr(o, le.to == kBroadcast ? "all" : (le.to == myNode ? "me" : "dm"));
+        jsonNum(o, "t", le.time);
+        jsonNum(o, "hops", le.hops < 0 ? NAN : le.hops);
+        jsonNum(o, "rssi", (le.rssi != 0 && !le.viaMqtt) ? le.rssi : NAN);
+        jsonNum(o, "snr", (le.rssi != 0 && !le.viaMqtt) ? le.snr : NAN);
+        o += ",\"mqtt\":";
+        o += le.viaMqtt ? "true" : "false";
+        o += '}';
+    }
+    o += ']';
+    // channel chat only when the owner opted in; direct messages are never exported
+    o += ",\"chat\":";
+    if (!webChat)
+        o += "null";
+    else {
+        o += '[';
+        bool f = true;
+        for (const auto &c : convs) {
+            if (c.key >= kMaxChannels)
+                continue;
+            size_t start = c.msgs.size() > 20 ? c.msgs.size() - 20 : 0;
+            for (size_t i = start; i < c.msgs.size(); i++) {
+                const Msg &m = c.msgs[i];
+                if (!f)
+                    o += ',';
+                f = false;
+                o += "{\"ch\":";
+                jsonStr(o, channelNames[c.key][0] ? channelNames[c.key] : (c.key == 0 ? "Primary" : "Channel"));
+                snprintf(b, sizeof(b), ",\"from\":\"!%08x\"", (unsigned)m.from);
+                o += b;
+                jsonNum(o, "t", m.time);
+                o += ",\"text\":";
+                jsonStr(o, m.text.c_str());
+                o += '}';
+            }
+        }
+        o += ']';
+    }
+    o += '}';
+}
