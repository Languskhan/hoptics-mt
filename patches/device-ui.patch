+#include "esp_attr.h"
+#include "esp_heap_caps.h"
+// the crash summary needs core dumps saved to flash in ELF format (the Hoptics builds turn this on;
+// without it a report still has the restart reason, uptime and memory, just no crash address)
+#if defined(CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH) && defined(CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF)
+#define HOPTICS_COREDUMP 1
+#include "esp_core_dump.h"
+#endif
+#include "esp_system.h"
