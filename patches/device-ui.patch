+uint32_t HopticsView::randomPin(void)
+{
+#if defined(ARDUINO_ARCH_ESP32)
+    return 100000 + (esp_random() % 900000); // hardware RNG
+#else
+    return 100000 + (uint32_t)(rand() % 900000);
