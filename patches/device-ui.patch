diff --git a/include/graphics/view/TFT/HopticsUI.h b/include/graphics/view/TFT/HopticsUI.h
new file mode 100644
index 0000000..69f1867
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsUI.h
@@ -0,0 +1,447 @@
+#pragma once
+/**
+ * Hoptics MT - a from-scratch touch UI for Meshtastic on 240x320 TFT boards
+ * (Heltec V4 Expansion Kit, Heltec V4-R8 Expansion Kit V2).
+ *
+ * This file is pure LVGL + C++ STL. It knows nothing about protobufs or the
+ * Meshtastic client plumbing; HopticsView adapts the device-ui MeshtasticView
+ * callbacks into calls on this class, and HopticsUI reports user actions back
+ * through the Callbacks struct. Keeping it separate lets the whole UI be
+ * rendered and tested on a host with fake data.
+ *
+ * GPL-3.0, same as device-ui.
+ */
+
+#include "lvgl.h"
+#include <functional>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+#ifndef HOPTICS_HISTORY
+#define HOPTICS_HISTORY 60 // graph samples kept (1/min for utilisation and packet rate)
+#endif
+#ifndef HOPTICS_SIGNAL_HISTORY
+#define HOPTICS_SIGNAL_HISTORY 60 // last N received packets in the RSSI/SNR graph
+#endif
+#ifndef HOPTICS_NODE_ROWS
+#define HOPTICS_NODE_ROWS 50 // node list rows kept as a reusable pool
+#endif
+#ifndef HOPTICS_LIVE_ROWS
+#define HOPTICS_LIVE_ROWS 30 // live "last heard" rows
+#endif
+#ifndef HOPTICS_MAX_NODES
+#define HOPTICS_MAX_NODES 300
+#endif
+#ifndef HOPTICS_MSGS_PER_CONV
+#define HOPTICS_MSGS_PER_CONV 60
+#endif
+#ifndef HOPTICS_MAP_MARKERS
+#define HOPTICS_MAP_MARKERS 60 // node dots drawn on the map
+#endif
+#ifndef HOPTICS_MAX_DM_CONVS
+#define HOPTICS_MAX_DM_CONVS 40 // direct-message conversations kept (oldest idle one is dropped)
+#endif
+#ifndef HOPTICS_NAME
+#define HOPTICS_NAME "HOPTICS MT"
+#endif
+#ifndef HOPTICS_VERSION
+#define HOPTICS_VERSION "0.1.0"
+#endif
+
+class HopticsUI
+{
+  public:
+    static constexpr uint32_t kBroadcast = 0xffffffff;
+    static constexpr uint32_t kMaxChannels = 8;
+    static constexpr uint32_t kOnlineSecs = 2 * 60 * 60; // "online" = heard within 2h
+
+    // message delivery states (mirrors LogMessage::MsgStatus order)
+    enum MsgStatus : uint8_t { eNone, eDefault, eHeard, eNoResponse, eAcked, eFailed, eDeleted, eUnread };
+
+    // Meshtastic port numbers we name in the UI
+    enum Port : uint16_t {
+        P_TEXT = 1,
+        P_REMOTE_HW = 2,
+        P_POSITION = 3,
+        P_NODEINFO = 4,
+        P_ROUTING = 5,
+        P_ADMIN = 6,
+        P_TEXT_COMP = 7,
+        P_WAYPOINT = 8,
+        P_DETECT = 10,
+        P_ALERT = 11,
+        P_KEY_VERIFY = 12,
+        P_REPLY = 32,
+        P_PAX = 34,
+        P_SERIAL = 64,
+        P_STORE_FWD = 65,
+        P_RANGE = 66,
+        P_TELEMETRY = 67,
+        P_TRACE = 70,
+        P_NEIGHBOR = 71,
+        P_ATAK = 72,
+        P_MAP = 73,
+    };
+
+    struct Node {
+        uint32_t num = 0;
+        char shortName[10] = {0};
+        char longName[42] = {0};
+        uint8_t role = 255;
+        uint8_t channel = 0;
+        uint32_t lastHeard = 0;
+        int8_t hops = -1;
+        bool hasSignal = false;
+        int16_t rssi = 0;
+        float snr = 0;
+        uint8_t battery = 255; // 0..100, 101 = powered, 255 = unknown
+        float voltage = 0;
+        float chUtil = -1;
+        float airUtil = -1;
+        bool hasPos = false;
+        int32_t lat = 0, lon = 0, alt = 0;
+        bool hasKey = false;
+        bool viaMqtt = false;
+        uint16_t hwModel = 0;
+        int8_t snrHist[16] = {0};
+        uint8_t snrCount = 0, snrIdx = 0;
+        uint32_t packets = 0;
+        int32_t cityIdx = -2; // -2 = not looked up yet, -1 = none near
+        float cityKm = 0;
+        uint16_t cityBearing = 0;
+    };
+
+    struct Msg {
+        uint32_t from;
+        uint32_t time;
+        uint32_t requestId;
+        uint8_t status;
+        std::string text;
+    };
+
+    struct Conv {
+        uint32_t key; // < kMaxChannels: channel index, otherwise node number (DM)
+        std::vector<Msg> msgs;
+        uint16_t unread = 0;
+        uint32_t lastTime = 0;
+    };
+
+    struct LiveEntry {
+        uint32_t from = 0, to = 0, time = 0;
+        uint16_t port = 0;
+        int8_t hops = -1;
+        int16_t rssi = 0;
+        float snr = 0;
+        bool viaMqtt = false;
+    };
+
+    struct Callbacks {
+        // returns a request id used for delivery status, 0 if not sent
+        std::function<uint32_t(uint32_t convKey, const char *text)> sendText;
+        std::function<void(uint32_t node)> traceRoute;
+        std::function<void(uint32_t node)> requestPosition;
+        std::function<void(uint8_t brightness)> setBrightness;
+        std::function<void(uint16_t seconds)> setScreenTimeout;
+        std::function<void(bool on)> setBanner;
+        std::function<void(const char *shortName, const char *longName)> saveUser;
+        std::function<void(int role)> setRole;
+        std::function<void(int region)> setRegion;
+        std::function<void(int preset)> setPreset;
+        std::function<void(bool on)> setBluetooth;
+        // phone app mode: Bluetooth on for the Meshtastic app; the firmware stops feeding the screen
+        std::function<void(void)> enterPhoneMode;
+        std::function<void(void)> leavePhoneMode;
+        std::function<void(void)> reboot;
+        std::function<void(void)> shutdown;
+        std::function<void(uint32_t convKey)> conversationRead;
+        std::function<void(int theme)> setTheme;
+        std::function<void(bool on)> setWebChat;
+    };
+
+    enum Theme { TH_MIDNIGHT = 0, TH_DAYLIGHT, TH_NIGHT_RED, TH_AMBER, TH_COUNT };
+
+    HopticsUI(void);
+    void setCallbacks(const Callbacks &cb) { cbs = cb; }
+
+    // --- lifecycle ---
+    void createBootScreen(const char *firmwareVersion);
+    void setBootStatus(const char *text);
+    void buildMainScreen(void);
+    void showMainScreen(void);
+    bool isMainBuilt(void) const { return mainScreen != nullptr; }
+    void tick(uint32_t now); // call ~1x per second with unix time (or uptime if no clock)
+
+    // --- model updates ---
+    void setMyNode(uint32_t num);
+    void upsertNode(uint32_t num, uint8_t channel, uint32_t lastHeard, const char *shortName, const char *longName, uint8_t role,
+                    bool hasKey, bool viaMqtt, uint16_t hwModel);
+    void touchNode(uint32_t num, uint32_t lastHeard); // create placeholder if unknown
+    void removeNode(uint32_t num);
+    void updatePosition(uint32_t num, int32_t lat, int32_t lon, int32_t alt);
+    void updateMetrics(uint32_t num, uint8_t battery, float voltage, float chUtil, float airUtil);
+    void updateSignal(uint32_t num, int16_t rssi, float snr);
+    void updateHops(uint32_t num, int8_t hops);
+    void onPacket(uint32_t from, uint32_t to, uint16_t port, int8_t hops, int16_t rssi, float snr, uint32_t time, bool viaMqtt);
+    void addMessage(uint32_t convKey, uint32_t from, uint32_t time, const char *text, uint32_t requestId, uint8_t status,
+                    bool restoring);
+    void setMessageStatus(uint32_t requestId, uint8_t status);
+    void setChannel(uint8_t index, const char *name, bool enabled);
+    void setRadio(int region, const char *regionName, int preset, const char *presetName, bool usePreset, uint8_t hopLimit,
+                  int8_t txPower, float freqMHz);
+    void setDeviceRole(int role);
+    void setBluetoothEnabled(bool on, uint32_t fixedPin = 0);
+    // full-screen "phone app mode" page (Bluetooth on, screen paused); restarting = on the way in or out
+    void showPhoneMode(uint32_t pin, bool restarting);
+    bool inPhoneMode(void) const { return phoneScreen != nullptr; }
+    void setNetwork(bool wifiOn, bool wifiUp, uint32_t ip, bool mqttUp, int32_t wifiRssi);
+    void setTheme(int theme); // rebuilds the main screen if it exists
+    int theme(void) const { return themeIdx; }
+    void setWebChat(bool on) { webChat = on; }
+    // read-only JSON snapshot for the web page / loggers (no DM content ever)
+    void buildSnapshotJson(std::string &out) const;
+    void setUiConfig(uint8_t brightness, uint16_t timeout, bool banner);
+    void setDeviceInfo(const char *fwVersion, int hwModel, bool canShutdown, bool hasBluetooth);
+    void setTime(uint32_t epoch);
+    void setConnected(bool connected);
+    void showTraceRoute(uint32_t target, const std::string &text);
+    void showToast(const char *text, uint32_t ms = 2500);
+    void maybeShowWizard(void);
+    bool hasCityData(void) const;
+    // "Orangevale, CA" / "near Folsom, CA - 6 km NE"; false if no position or no city data
+    bool cityLabel(uint32_t num, char *buf, size_t len);
+
+    uint32_t myNodeNum(void) const { return myNode; }
+    const Node *findNode(uint32_t num) const;
+
+  private:
+    // ---------- screens ----------
+    enum Tab { T_HOME, T_LIVE, T_MAP, T_CHAT, T_NODES, T_STATS, T_COUNT };
+    enum LiveFilter { LF_ALL, LF_RF, LF_MQTT };
+    enum SortMode { S_RECENT, S_SIGNAL, S_HOPS, S_NAME };
+
+    void buildStatusBar(lv_obj_t *parent);
+    void buildNavBar(lv_obj_t *parent);
+    void buildHome(lv_obj_t *parent);
+    void buildLive(lv_obj_t *parent);
+    void buildChatList(lv_obj_t *parent);
+    void buildNodes(lv_obj_t *parent);
+    void buildStats(lv_obj_t *parent);
+    void buildMap(lv_obj_t *parent);
+    void refreshMap(void);
+    void mapFit(void);
+    void mapPing(uint32_t num, uint16_t port, bool viaMqtt, int8_t hops);
+    bool mapProject(int32_t lat, int32_t lon, int32_t &x, int32_t &y) const;
+    void replayCharts(void);
+    void buildChatOverlay(void);
+    void buildNodeOverlay(void);
+    void buildSettingsOverlay(void);
+    void buildKeyboard(void);
+    void buildWizard(void);
+    void wizardStep(int step);
+    void lookupCity(Node &n);
+
+    void selectTab(Tab t);
+    void openChat(uint32_t convKey);
+    void closeChat(void);
+    void openNode(uint32_t num);
+    void closeNode(void);
+    void openSettings(void);
+    void closeSettings(void);
+    void showKeyboard(lv_obj_t *textarea);
+    void hideKeyboard(void);
+    void sendFromChat(void);
+
+    // ---------- refresh ----------
+    void refreshStatusBar(void);
+    void refreshHome(void);
+    void refreshLive(void);
+    void refreshChatList(void);
+    void refreshNodes(void);
+    void refreshStats(void);
+    void refreshNodeOverlay(void);
+    void rebuildChatMessages(void);
+    void appendBubble(const Msg &m);
+    void minuteSample(void);
+
+    // ---------- helpers ----------
+    Node *nodePtr(uint32_t num);
+    Node &nodeRef(uint32_t num);
+    Conv &convRef(uint32_t key);
+    Conv *convPtr(uint32_t key);
+    const char *nodeShort(uint32_t num, char *buf, size_t len);
+    const char *nodeLong(uint32_t num, char *buf, size_t len);
+    const char *convTitle(uint32_t key, char *buf, size_t len);
+    void agoString(uint32_t t, char *buf, size_t len) const;
+    static const char *portTag(uint16_t port);
+    static lv_color_t portColor(uint16_t port);
+    static lv_color_t nodeColor(uint32_t num);
+    static lv_color_t snrColor(float snr);
+    static const char *roleName(uint8_t role);
+    static const char *statusGlyph(uint8_t status);
+    void setBadge(lv_obj_t *badge, uint32_t num);
+    uint32_t onlineCount(void) const;
+    double distanceKm(const Node &a, const Node &b) const;
+
+    lv_obj_t *card(lv_obj_t *parent, const char *title, lv_obj_t **titleLabel = nullptr);
+    lv_obj_t *statTile(lv_obj_t *parent, const char *caption, lv_color_t accent, lv_obj_t **value, lv_obj_t **sub);
+    lv_obj_t *makeChart(lv_obj_t *parent, int32_t h, lv_chart_type_t type, uint32_t points);
+    lv_obj_t *overlayPanel(const char *title, lv_obj_t **titleLabel, lv_event_cb_t backCb);
+    lv_obj_t *settingsRow(lv_obj_t *parent, const char *label);
+    lv_obj_t *label(lv_obj_t *parent, const lv_font_t *font, lv_color_t color, const char *text = "");
+
+    // ---------- model ----------
+    Callbacks cbs;
+    std::vector<Node> nodes;
+    std::vector<Conv> convs;
+    LiveEntry live[HOPTICS_LIVE_ROWS];
+    uint32_t liveHead = 0, liveCount = 0;
+    char channelNames[kMaxChannels][14];
+    bool channelEnabled[kMaxChannels];
+    uint32_t myNode = 0;
+    uint32_t nowTs = 0;
+    bool clockValid = false;
+    bool connected = false;
+    uint32_t lastMinute = 0;
+    uint32_t pktThisMinute = 0;
+    uint32_t pktTotal = 0, pktDirect = 0, pktMqtt = 0;
+    uint32_t portCounts[8] = {0}; // TEXT POS NODE TELEM ROUTE TRACE OTHER MQTT
+    float lastChUtil = -1, lastAirUtil = -1;
+    uint8_t myBattery = 255;
+    int themeIdx = 0;
+    bool webChat = false;
+    int pendingTheme = 0;
+    bool wifiOn = false, wifiUp = false, mqttUp = false;
+    uint32_t ipAddr = 0;
+    int32_t wifiRssi = 0;
+    uint32_t btPin = 0;
+    int32_t sigRssi[HOPTICS_SIGNAL_HISTORY];
+    int32_t sigSnr[HOPTICS_SIGNAL_HISTORY];
+    LiveFilter liveFilter = LF_ALL;
+    float myVoltage = 0;
+    int region = 0, preset = 0, role = 0;
+    char regionName[16] = "--", presetName[20] = "--";
+    uint8_t hopLimit = 3;
+    int8_t txPower = 0;
+    float freqMHz = 0;
+    bool usePreset = true;
+    bool bluetoothOn = false;
+    uint8_t brightness = 153;
+    uint16_t screenTimeout = 30;
+    bool bannerOn = true;
+    char fwVersion[24] = "";
+    int hwModel = 0;
+    bool canShutdown = false;
+    bool hasBluetooth = true;
+
+    // graph history (oldest first, shifted in)
+    int32_t histChUtil[HOPTICS_HISTORY];
+    int32_t histAirUtil[HOPTICS_HISTORY];
+    int32_t histPktRate[HOPTICS_HISTORY];
+
+    // dirty flags - widgets are only touched when visible & dirty
+    bool dirtyHome = true, dirtyLive = true, dirtyChats = true, dirtyNodes = true, dirtyStats = true, dirtyNodeOv = true;
+    uint32_t lastNodesRefresh = 0;
+
+    // ---------- widgets ----------
+    lv_obj_t *bootScreen = nullptr, *bootStatus = nullptr;
+    lv_obj_t *phoneScreen = nullptr, *phoneMsg = nullptr, *phonePin = nullptr, *phoneBtn = nullptr;
+    lv_obj_t *mainScreen = nullptr;
+    lv_obj_t *statusTime = nullptr, *statusName = nullptr, *statusBatt = nullptr, *statusMsg = nullptr, *statusLink = nullptr,
+             *statusMqtt = nullptr, *statusBt = nullptr;
+    lv_obj_t *content = nullptr;
+    lv_obj_t *pages[T_COUNT] = {nullptr};
+    lv_obj_t *navBtns[T_COUNT] = {nullptr};
+    lv_obj_t *navBadge = nullptr;
+    Tab activeTab = T_HOME;
+
+    // home
+    lv_obj_t *homeOnline = nullptr, *homeOnlineSub = nullptr;
+    lv_obj_t *homeChUtil = nullptr, *homeChUtilSub = nullptr;
+    lv_obj_t *homeAir = nullptr, *homeAirSub = nullptr;
+    lv_obj_t *homeRate = nullptr, *homeRateSub = nullptr;
+    lv_obj_t *homeChart = nullptr;
+    lv_chart_series_t *homeSeries = nullptr;
+    lv_obj_t *homeRadio = nullptr;
+    lv_obj_t *homeLast[3] = {nullptr};
+    lv_obj_t *homeLastBadge[3] = {nullptr};
+    lv_obj_t *homeLastName[3] = {nullptr};
+    lv_obj_t *homeLastInfo[3] = {nullptr};
+
+    // live
+    lv_obj_t *liveList = nullptr, *liveEmpty = nullptr;
+    lv_obj_t *liveChips[3] = {nullptr};
+    struct LiveRow {
+        lv_obj_t *row, *badge, *name, *port, *sig, *meta;
+    } liveRows[HOPTICS_LIVE_ROWS];
+
+    // chats
+    lv_obj_t *chatList = nullptr;
+
+    // nodes
+    lv_obj_t *nodesHeader = nullptr, *nodesList = nullptr, *nodesMore = nullptr;
+    lv_obj_t *sortBtns[4] = {nullptr};
+    SortMode sortMode = S_RECENT;
+    struct NodeRow {
+        lv_obj_t *row, *badge, *name, *sub, *sig, *ago;
+    } nodeRows[HOPTICS_NODE_ROWS];
+    std::vector<uint32_t> sortedNodes;
+
+    // stats
+    lv_obj_t *statUtilChart = nullptr, *statRateChart = nullptr, *statSigChart = nullptr, *statHopChart = nullptr;
+    lv_chart_series_t *serChUtil = nullptr, *serAirUtil = nullptr, *serRate = nullptr, *serRssi = nullptr, *serSnr = nullptr,
+                      *serHops = nullptr;
+    lv_obj_t *statSigCaption = nullptr, *statTotals = nullptr, *statHopCaption = nullptr;
+    lv_obj_t *portBars[7] = {nullptr};
+    lv_obj_t *talkName[5] = {nullptr}, *talkBar[5] = {nullptr}, *talkVal[5] = {nullptr};
+    lv_obj_t *portVals[7] = {nullptr};
+
+    // map
+    lv_obj_t *mapArea = nullptr, *mapRange = nullptr, *mapEmpty = nullptr, *mapMe = nullptr;
+    lv_obj_t *mapRings[3] = {nullptr}, *mapRingLbl[3] = {nullptr};
+    lv_obj_t *mapDots[HOPTICS_MAP_MARKERS] = {nullptr};
+    lv_obj_t *mapLinks[HOPTICS_MAP_MARKERS] = {nullptr};
+    lv_point_precise_t mapLinkPts[HOPTICS_MAP_MARKERS][2];
+    int32_t mapCLat = 0, mapCLon = 0;
+    float mapKmPerPx = 0.1f;
+    bool mapHaveCenter = false, mapUserZoom = false, dirtyMap = true;
+    int mapPings = 0;
+
+    // chat overlay
+    lv_obj_t *chatOv = nullptr, *chatTitle = nullptr, *chatMsgs = nullptr, *chatInput = nullptr, *chatInputRow = nullptr;
+    uint32_t chatKey = UINT32_MAX;
+    struct BubbleRef {
+        uint32_t requestId;
+        lv_obj_t *status;
+    };
+    std::vector<BubbleRef> bubbleRefs;
+
+    // node overlay
+    lv_obj_t *nodeOv = nullptr, *nodeOvTitle = nullptr, *nodeOvBadge = nullptr, *nodeOvName = nullptr, *nodeOvId = nullptr;
+    lv_obj_t *nodeOvInfo = nullptr, *nodeOvChart = nullptr, *nodeOvTrace = nullptr;
+    lv_chart_series_t *nodeOvSeries = nullptr;
+    uint32_t nodeOvNum = 0;
+
+    // settings overlay
+    lv_obj_t *setOv = nullptr, *setBright = nullptr, *setTimeout = nullptr, *setBanner = nullptr, *setShort = nullptr,
+             *setLong = nullptr, *setRoleDd = nullptr, *setRegionDd = nullptr, *setPresetDd = nullptr, *setBt = nullptr,
+             *setInfo = nullptr, *setShutdownBtn = nullptr, *setThemeDd = nullptr, *setBtPin = nullptr, *setWebChatSw = nullptr;
+    bool settingsLoading = false;
+
+    // location / city locator
+    lv_obj_t *homeLoc = nullptr, *homeLocCity = nullptr, *homeLocSub = nullptr;
+    int32_t myCityIdx = -2;
+
+    // first-boot wizard
+    lv_obj_t *wizOv = nullptr, *wizPages[3] = {nullptr}, *wizRegion = nullptr, *wizShort = nullptr, *wizLong = nullptr,
+             *wizNext = nullptr, *wizDots = nullptr;
+    int wizStep = 0, wizTheme = 0;
+    bool wizardShown = false;
+    bool regionKnown = false;
+
+    // shared
+    lv_obj_t *keyboard = nullptr;
+    lv_obj_t *kbTarget = nullptr;
+    lv_obj_t *toast = nullptr, *toastLabel = nullptr;
+    lv_timer_t *toastTimer = nullptr;
+};
diff --git a/include/graphics/view/TFT/HopticsView.h b/include/graphics/view/TFT/HopticsView.h
new file mode 100644
index 0000000..44dac28
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsView.h
@@ -0,0 +1,89 @@
+#pragma once
+/**
+ * HopticsView - adapts the device-ui MeshtasticView/ViewController plumbing (node DB, packets,
+ * telemetry, messages, config) to the protobuf-free HopticsUI. Selected by -D HOPTICS_UI.
+ * GPL-3.0, same as device-ui.
+ */
+#include "graphics/common/MeshtasticView.h"
+#include "graphics/view/TFT/HopticsUI.h"
+#include <mutex>
+#include <string>
+
+class HopticsView : public MeshtasticView
+{
+  public:
+    static HopticsView *instance(void);
+    static HopticsView *instance(const DisplayDriverConfig &cfg);
+
+    void init(IClientBase *client) override;
+    void task_handler(void) override;
+    bool setupUIConfig(const meshtastic_DeviceUIConfig &uiconfig) override;
+    void configCompleted(void) override;
+    void notifyMessagesRestored(void) override;
+
+    void setMyInfo(uint32_t nodeNum, meshtastic_MyNodeInfo_device_id_t device_id) override;
+    void setDeviceMetaData(int hw_model, const char *version, bool has_bluetooth, bool has_wifi, bool has_eth,
+                           bool can_shutdown) override;
+    void addOrUpdateNode(uint32_t nodeNum, uint8_t channel, uint32_t lastHeard, const meshtastic_User &cfg) override;
+    void updateNode(uint32_t nodeNum, uint8_t channel, const meshtastic_User &cfg) override;
+    void updatePosition(uint32_t nodeNum, int32_t lat, int32_t lon, int32_t alt, uint32_t sats, uint32_t precision) override;
+    void updateMetrics(uint32_t nodeNum, const meshtastic_DeviceMetrics &metrics) override;
+    void updateSignalStrength(uint32_t nodeNum, int32_t rssi, float snr) override;
+    void updateHopsAway(uint32_t nodeNum, uint8_t hopsAway) override;
+    void updateConnectionStatus(const meshtastic_DeviceConnectionStatus &status) override;
+    void updateLastHeard(uint32_t nodeNum) override;
+    void removeNode(uint32_t nodeNum) override;
+
+    void updateChannelConfig(const meshtastic_Channel &ch) override;
+    void updateDeviceConfig(const meshtastic_Config_DeviceConfig &cfg) override;
+    void updateLoRaConfig(const meshtastic_Config_LoRaConfig &cfg) override;
+    void updateBluetoothConfig(const meshtastic_Config_BluetoothConfig &cfg, uint32_t id = 0) override;
+    void updateNetworkConfig(const meshtastic_Config_NetworkConfig &cfg) override;
+
+    void packetReceived(const meshtastic_MeshPacket &p) override;
+    void newMessage(uint32_t from, uint32_t to, uint8_t ch, const char *msg, uint32_t &msgtime, bool restore = false) override;
+    void restoreMessage(const LogMessage &msg) override;
+    void textMessageStatus(uint32_t requestId, LogMessage::MsgStatus status) override;
+    void handleResponse(uint32_t from, uint32_t id, const meshtastic_RouteDiscovery &route) override;
+
+    void notifyConnected(const char *info) override;
+    void notifyDisconnected(const char *info) override;
