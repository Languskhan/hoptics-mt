diff --git a/include/util/Packet.h b/include/util/Packet.h
index 5ddff3f..b4aa7e3 100644
--- a/include/util/Packet.h
+++ b/include/util/Packet.h
@@ -1,6 +1,11 @@
 #pragma once
 
 #include <memory>
+#include <new>
+#include <utility>
+#if defined(ESP_PLATFORM)
+#include "esp_heap_caps.h"
+#endif
 
 /**
  * Polymorphic packets that can be moved into and out of packet queues.
@@ -38,7 +43,8 @@ class Packet
 template <typename PacketType> class DataPacket : public Packet
 {
   public:
-    template <typename... Args> DataPacket(int id, Args &&...args) : Packet(id), data(new PacketType(std::forward<Args>(args)...))
+    template <typename... Args>
+    DataPacket(int id, Args &&...args) : Packet(id), data(create(std::forward<Args>(args)...))
     {
     }
 
@@ -58,5 +64,33 @@ template <typename PacketType> class DataPacket : public Packet
     DataPacket &operator=(DataPacket &&) = default;
 
   private:
-    std::unique_ptr<PacketType> data;
+    // Hoptics MT: packets pile up in the queue whenever the screen task falls behind (one FromRadio is
+    // 768 bytes; right after boot ~70 of them wait while the screen restores its messages), and on ESP32
+    // anything under 4 KB is placed in internal RAM by default, which Wi-Fi and Bluetooth need: on the
+    // V4-R8 that left Wi-Fi without buffers and no address for two minutes. Keep the packets in PSRAM.
+    // (Don't shorten the queue instead: the firmware treats a full queue as "screen disconnected".)
+    struct Release {
+        void operator()(PacketType *p) const
+        {
+            p->~PacketType();
+#if defined(ESP_PLATFORM)
+            heap_caps_free(p); // also right for the internal-RAM fallback: ESP-IDF's operator new is malloc
+#else
+            ::operator delete(p);
+#endif
+        }
+    };
+
+    template <typename... Args> static PacketType *create(Args &&...args)
+    {
+        void *mem = nullptr;
+#if defined(ESP_PLATFORM)
+        mem = heap_caps_malloc(sizeof(PacketType), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+#endif
+        if (!mem)
+            mem = ::operator new(sizeof(PacketType));
+        return new (mem) PacketType(std::forward<Args>(args)...);
+    }
+
+    std::unique_ptr<PacketType, Release> data;
 };
diff --git a/source/graphics/TFT/HopticsInput.cpp b/source/graphics/TFT/HopticsInput.cpp
new file mode 100644
index 0000000..719d1c6
--- /dev/null
+++ b/source/graphics/TFT/HopticsInput.cpp
@@ -0,0 +1,133 @@
+/**
+ * HopticsInput - see HopticsInput.h. GPL-3.0.
+ */
+#include "graphics/view/TFT/HopticsInput.h"
+#include "graphics/driver/DisplayDriver.h"
+#include "input/DiacriticRotation.h"
+#include "util/ILog.h"
+
+// On the T-Deck the trackball click (GPIO0) is read twice: by the encoder and by the button device that
+// LGFXDriver switches on while the screen is dark. That button "presses" a fixed point on the screen, so a
+// click that only meant to wake the screen would also tap whatever Hoptics shows there. Where the button is
+// a pin of its own (the Heltec kits' USER button) it is left exactly as it was.
+#if defined(INPUTDRIVER_BUTTON_TYPE) && defined(INPUTDRIVER_ENCODER_BTN) && (INPUTDRIVER_BUTTON_TYPE == INPUTDRIVER_ENCODER_BTN)
+#define HOPTICS_GUARD_WAKE_BUTTON 1
+#endif
+
+namespace hoptics
+{
+
+namespace
+{
+struct Wrapped {
+    lv_indev_t *indev;
+    lv_indev_read_cb_t read; // the driver's own read callback
+};
+constexpr int kMaxWrapped = 4; // keyboard, trackball, wake button (+1 spare)
+Wrapped wrapped[kMaxWrapped];
+int wrappedCount = 0;
+DisplayDriver *display = nullptr;
+bool keys = false;
+
+lv_indev_read_cb_t driverRead(lv_indev_t *indev)
+{
+    for (int i = 0; i < wrappedCount; i++)
+        if (wrapped[i].indev == indev)
+            return wrapped[i].read;
+    return nullptr;
+}
+
+// Runs in place of the driver's read callback (on the UI task, inside lv_timer_handler).
+void guardedRead(lv_indev_t *indev, lv_indev_data_t *data)
+{
+    lv_indev_read_cb_t read = driverRead(indev);
+    if (read)
+        read(indev, data);
+    const lv_indev_type_t type = lv_indev_get_type(indev);
+    const bool rolled = type == LV_INDEV_TYPE_ENCODER && data->enc_diff != 0;
+
+    // Screen dark (LGFXDriver power save): the press still counts as activity, which is what wakes the
+    // screen, but LVGL ignores it and its release - otherwise the key that woke the screen would also
+    // type a letter, press the focused button or move the focus. A trackball roll just wakes it.
+    if (display && display->isPowersaving() && (data->state == LV_INDEV_STATE_PRESSED || rolled)) {
+        lv_indev_wait_release(indev);
+        if (rolled) {
+            data->enc_diff = 0;
+            lv_display_trigger_activity(lv_indev_get_display(indev));
+        }
+        return;
+    }
+
+    // The keyboards' accent key (T-Deck Shift+$, M9 dedicated key) arrives as a private key code that a
+    // text area would otherwise insert as a stray character: cycle the accent of the letter before the
+    // cursor instead (a -> ä -> à ...), and nothing anywhere else.
+    if (type != LV_INDEV_TYPE_BUTTON && data->state == LV_INDEV_STATE_PRESSED && data->key == LV_KEY_CUSTOM_DIACRITIC) {
+        lv_group_t *g = lv_indev_get_group(indev);
+        lv_obj_t *focused = g ? lv_group_get_focused(g) : nullptr;
+        if (focused && lv_obj_check_type(focused, &lv_textarea_class))
+            DiacriticRotation::rotatePreviousCharacter(focused);
+        lv_indev_wait_release(indev); // LVGL skips this press and its release
+    }
+}
+
+void wrap(lv_indev_t *indev)
+{
+    if (wrappedCount >= kMaxWrapped || lv_indev_get_read_cb(indev) == guardedRead)
+        return;
+    wrapped[wrappedCount++] = {indev, lv_indev_get_read_cb(indev)};
+    lv_indev_set_read_cb(indev, guardedRead);
+}
+} // namespace
+
+void Input::begin(DisplayDriver *disp)
+{
+    display = disp;
+    for (lv_indev_t *i = lv_indev_get_next(nullptr); i; i = lv_indev_get_next(i)) {
+        switch (lv_indev_get_type(i)) {
+        case LV_INDEV_TYPE_KEYPAD:
+        case LV_INDEV_TYPE_ENCODER:
+            keys = true;
+            wrap(i);
+            break;
+#ifdef HOPTICS_GUARD_WAKE_BUTTON
+        case LV_INDEV_TYPE_BUTTON:
+            wrap(i);
+            break;
+#endif
+        default:
+            break;
+        }
+    }
+    if (keys)
+        ILOG_INFO("Hoptics: keyboard/trackball input on (%d device(s) guarded)", wrappedCount);
+    service();
+}
+
+void Input::service(void)
+{
+    if (!keys)
+        return;
+    lv_group_t *g = lv_group_get_default();
+    if (!g)
+        return;
+    for (lv_indev_t *i = lv_indev_get_next(nullptr); i; i = lv_indev_get_next(i)) {
+        const lv_indev_type_t t = lv_indev_get_type(i);
+        if ((t == LV_INDEV_TYPE_KEYPAD || t == LV_INDEV_TYPE_ENCODER) && lv_indev_get_group(i) != g)
+            lv_indev_set_group(i, g);
+    }
+}
+
+bool Input::hasKeys(void)
+{
+    return keys;
+}
+
+bool Input::hasTouch(void)
+{
+    for (lv_indev_t *i = lv_indev_get_next(nullptr); i; i = lv_indev_get_next(i))
+        if (lv_indev_get_type(i) == LV_INDEV_TYPE_POINTER)
+            return true;
+    return false;
+}
+
+} // namespace hoptics
