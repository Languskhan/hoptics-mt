+void HopticsUI::buildKeyboard(void)
+{
+    keyboard = lv_keyboard_create(mainScreen);
+    lv_obj_set_size(keyboard, W(), H() * 45 / 100);
+    lv_obj_align(keyboard, LV_ALIGN_BOTTOM_MID, 0, 0);
+    lv_obj_set_style_bg_color(keyboard, C_BAR, 0);
+    lv_obj_set_style_pad_all(keyboard, 3, 0);
+    lv_obj_set_style_pad_gap(keyboard, 3, 0);
+    lv_obj_set_style_bg_color(keyboard, C_CARD2, LV_PART_ITEMS);
+    lv_obj_set_style_text_color(keyboard, C_TEXT, LV_PART_ITEMS);
+    lv_obj_set_style_text_font(keyboard, &F14, LV_PART_ITEMS);
+    lv_obj_set_style_border_width(keyboard, 0, LV_PART_ITEMS);
+    lv_obj_set_style_radius(keyboard, 6, LV_PART_ITEMS);
+    lv_obj_set_style_bg_color(keyboard, C_ME, (lv_style_selector_t)LV_PART_ITEMS | LV_STATE_CHECKED);
+    lv_obj_set_style_text_color(keyboard, C_ON_ME, (lv_style_selector_t)LV_PART_ITEMS | LV_STATE_CHECKED);
+    lv_obj_set_style_bg_color(keyboard, C_CYAN, (lv_style_selector_t)LV_PART_ITEMS | LV_STATE_PRESSED);
