diff --git a/include/graphics/view/TFT/HopticsReport.h b/include/graphics/view/TFT/HopticsReport.h
new file mode 100644
index 0000000..3ee18db
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsReport.h
@@ -0,0 +1,99 @@
+#pragma once
+/**
+ * Hoptics MT - problem reports.
+ *
+ * At start-up this works out why the radio restarted. After a crash it reads the crash summary
+ * the ESP32 saved to flash (core dump: crashing task, program counter, backtrace) plus a few
+ * numbers kept in RTC memory that survives the reset (uptime and free memory just before), and
+ * stores a small record in NVS. The UI turns that into a QR code that opens a GitHub bug report
+ * with the details already filled in.
+ *
+ * Nothing here sends data anywhere: the person scans the code and decides whether to submit.
+ * No node number, position or Wi-Fi name is ever put into a report.
+ *
+ * GPL-3.0, same as device-ui.
+ */
+
+#include <stdint.h>
+#include <string>
+
+#ifndef HOPTICS_BUILD
+#define HOPTICS_BUILD 0 // CI passes its run number; 0 = local build
+#endif
+#ifndef HOPTICS_REPORT_URL
+#define HOPTICS_REPORT_URL "https://github.com/Languskhan/hoptics-mt/issues/new"
+#endif
+#ifndef HOPTICS_REPORT_TEMPLATE
+#define HOPTICS_REPORT_TEMPLATE "bug.yml"
+#endif
+
+namespace hoptics
+{
+
+enum CrashKind : uint8_t { CK_NONE = 0, CK_CRASH, CK_WATCHDOG, CK_POWER };
+
+// stored as one NVS blob: keep it plain data, bump `version` if the layout changes
+struct CrashRecord {
+    uint8_t version = 1;
+    uint8_t kind = CK_NONE;
+    uint8_t btDepth = 0;
+    uint8_t streak = 0;             // crashes in a row, each within 2 minutes of starting
+    uint16_t count = 0;             // crashes since the record was last cleared
+    uint16_t build = 0;             // HOPTICS_BUILD of the firmware that crashed
+    uint32_t pc = 0;                // program counter at the crash (0 = no core dump)
+    uint32_t bt[8] = {0};           // backtrace
+    uint32_t upSecs = 0;            // how long it had been running (0 = unknown)
+    uint16_t heapKB = 0xffff;       // free internal RAM shortly before (0xffff = unknown)
+    uint16_t psramKB = 0xffff;      // free PSRAM shortly before
+    char reason[40] = {0};          // "abort()", "LoadProhibited", "Task watchdog", ...
+    char task[16] = {0};            // FreeRTOS task that crashed
+    char ver[12] = {0};             // HOPTICS_VERSION that crashed
+};
+
+class Report
+{
+  public:
+    static Report &get(void);
+
+    void begin(void); // once at start-up
+    void tick(void);  // about once a second: refreshes the numbers that survive a crash
+
+    bool hasCrash(void) const { return rec.kind != CK_NONE; }
+    bool freshCrash(void) const { return fresh; } // this start-up followed a crash
+    void ackFresh(void) { fresh = false; }
+    const CrashRecord &crash(void) const { return rec; }
+    void clearCrash(void);
+    const char *lastStart(void) const { return startText; } // why this start-up happened
+
+    static const char *board(void);
+    static uint32_t uptimeSecs(void);
+    static void memoryKB(uint32_t &heap, uint32_t &psram);
+    static std::string duration(uint32_t secs); // "12 s", "4 min", "2 h 13 min"
+
+    // "abort() in loopTask, 12 s after start" (for the screen)
+    std::string crashLine(void) const;
+    // compact lines for the bug report; `fw` = Meshtastic version, `status` = live UI state
+    std::string details(const char *fw, const std::string &status) const;
+    // GitHub "new issue" link with the form filled in (kept short so the QR code stays scannable)
+    std::string issueUrl(bool crashTitle, const std::string &details) const;
+
+    // host harness / tests: pretend a crash happened
+    void inject(const CrashRecord &r, bool isFresh)
+    {
+        rec = r;
+        fresh = isFresh;
+    }
+
+  private:
+    void save(void);
+    void load(void);
+
+    CrashRecord rec;
+    bool fresh = false;
+    bool begun = false;
+    char startText[20] = "power on";
+};
+
+std::string urlEncode(const std::string &s);
+
+} // namespace hoptics
diff --git a/include/graphics/view/TFT/HopticsTiles.h b/include/graphics/view/TFT/HopticsTiles.h
new file mode 100644
index 0000000..3e6006c
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsTiles.h
@@ -0,0 +1,199 @@
+#pragma once
+/**
+ * Hoptics MT street map - OpenStreetMap raster tiles drawn into one RGB565 view buffer.
+ *
+ * The map tab hands this engine a view (zoom level + a window in world pixels). A worker task
+ * fills the buffer: tiles already saved on flash first, then - only while Wi-Fi is up - downloads
+ * of the tiles that are actually in view (HTTPS, server checked against pinned root CAs), each one
+ * saved so the same area still shows later without Wi-Fi.
+ *
+ * tile.openstreetmap.org usage policy, which this follows: no prefetching or "download an area for
+ * offline", only tiles in view; a distinct User-Agent; keep tiles at least 7 days (or what the
+ * server's Cache-Control says) and re-check expired ones with a conditional request; show
+ * "(c) OpenStreetMap" on the map. https://operations.osmfoundation.org/policies/tiles/
+ *
+ * The engine never touches LVGL objects: the UI shows the buffer as an image and polls takeDirty().
+ * Apart from a thin platform layer it is plain C++, so the PC harness runs the same code.
+ * GPL-3.0, same as device-ui.
+ */
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#ifndef HOPTICS_MAP_URL
+#define HOPTICS_MAP_URL "https://tile.openstreetmap.org/%u/%u/%u.png" // z, x, y
+#endif
+#ifndef HOPTICS_MAP_CACHE_KB
+#define HOPTICS_MAP_CACHE_KB 1536 // flash used for saved tiles at most
+#endif
+#ifndef HOPTICS_MAP_FS_RESERVE_KB
+#define HOPTICS_MAP_FS_RESERVE_KB 1024 // the node's own files always keep at least this much free space
+#endif
+#ifndef HOPTICS_MAP_MIN_ZOOM
+#define HOPTICS_MAP_MIN_ZOOM 3
+#endif
+#ifndef HOPTICS_MAP_MAX_ZOOM
+#define HOPTICS_MAP_MAX_ZOOM 18
+#endif
+
+class PNG;
+struct png_draw_tag;
+
+namespace hoptics
+{
+
+enum class MapStyle : uint8_t { Light, Dark, Red, Amber };
+
+// One window onto the map. World size at zoom z is (256 << z) pixels square (Web Mercator).
+struct MapView {
+    uint8_t z = 0;
+    int32_t ox = 0, oy = 0; // world pixel of the view's top-left corner
+    int16_t w = 0, h = 0;
+    MapStyle style = MapStyle::Dark;
+    uint16_t bg = 0; // RGB565 colour where there is no tile
+    bool same(const MapView &o) const
+    {
+        return z == o.z && ox == o.ox && oy == o.oy && w == o.w && h == o.h && style == o.style && bg == o.bg;
+    }
+};
+
+// growable byte buffer for one tile (PSRAM when there is some)
+struct Blob {
+    uint8_t *data = nullptr;
+    size_t len = 0, cap = 0;
+    bool overflow = false;
+    Blob() = default;
+    Blob(const Blob &) = delete;
+    Blob &operator=(const Blob &) = delete;
+    ~Blob();
+    bool reserve(size_t n);
+    bool append(const uint8_t *p, size_t n, size_t max);
+    void reset(void);
+};
+
+struct MapStatus {
+    enum Problem : uint8_t { NONE, OFFLINE, BUSY, NO_LINK };
+    bool enabled = true;
+    bool online = false;
+    uint8_t need = 0;    // tiles covering the view
+    uint8_t shown = 0;   // ...of those drawn
+    uint8_t pending = 0; // ...still to download
+    Problem problem = NONE;
+    bool storageFull = false; // the last tile could not be saved (still shown)
+    uint32_t savedTiles = 0;
+    uint32_t savedKB = 0;
+};
+
+class TileMap
+{
+  public:
+    static TileMap &get(void);
+
+    // ---- UI task ----
+    // allocator for the two long-lived blocks (view buffer, PNG decoder), e.g. lv_malloc; default malloc
+    void setAllocator(void *(*alloc)(size_t), void (*release)(void *));
+    // the view buffer: RGB565, row stride = w. Allocated on first use and again only if the size changes.
+    uint16_t *buffer(int16_t w, int16_t h);
+    // draw this view (cheap when nothing changed)
+    void request(const MapView &v);
+    // after a drag: move what is drawn by (dx, dy), fill the uncovered edges, then draw view v
+    void shiftAndRequest(int32_t dx, int32_t dy, const MapView &v);
+    // true once each time the worker changed the buffer
+    bool takeDirty(void) { return dirty.exchange(false); }
+    void setEnabled(bool on);
+    bool isEnabled(void) const { return enabled.load(); }
+    MapStatus status(void);
+    void clearSaved(void);
+    // start the worker (it reads the saved-tile index) without drawing anything yet
+    void wake(void) { startWorker(); }
+
+    // ---- PC harness ----
+    // tiles are read from sourceDir/z/x/y.png instead of the internet; saved ones go to cacheDir
+    static void hostSetup(const char *cacheDir, const char *sourceDir);
+    static void hostSetOnline(bool on);
+    // the worker has finished everything it can do for the current view
+    bool idle(void) const { return idleGen.load() == gen.load() && !working.load(); }
+
+  private:
+    struct Tile {
+        int32_t tx, ty;   // unwrapped tile coordinates (screen position = tx * 256 - ox)
+        uint32_t x, y;    // wrapped server coordinates
+        bool inWorld;     // ty is inside the map (no tile above the north / below the south edge)
+        bool shown;       // drawn for this view
+        bool gone;        // the server has no such tile (404) - nothing to wait for
+        bool stale;       // drawn from flash but due for a re-check
+        char etag[48];
+    };
+    struct Saved {
+        uint8_t z;
+        uint32_t x, y;
+        uint32_t bytes; // space on flash, rounded up to whole blocks
+    };
+    struct DrawCtx {
+        TileMap *self;
+        const MapView *v;
+        int32_t dx, dy; // tile's top-left corner in the view
+        uint32_t gen;
+        bool aborted;
+        bool complete;
+    };
+
+    TileMap() = default;
+    void startWorker(void);
+    void workerLoop(void);
+    void renderView(uint32_t g);
