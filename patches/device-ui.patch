+void HopticsUI::openNode(uint32_t num)
+{
+    if (!findNode(num))
+        return;
+    nodeOvNum = num;
+    lv_obj_add_flag(lv_obj_get_parent(nodeOvTrace), LV_OBJ_FLAG_HIDDEN);
+    dirtyNodeOv = true;
+    refreshNodeOverlay();
+    lv_obj_t *body = lv_obj_get_child(nodeOv, 1);
+    lv_obj_scroll_to_y(body, 0, LV_ANIM_OFF);
+    lv_obj_remove_flag(nodeOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(nodeOv, -1);
+    lv_obj_move_to_index(toast, -1);
+}
+
+void HopticsUI::closeNode(void)
+{
+    lv_obj_add_flag(nodeOv, LV_OBJ_FLAG_HIDDEN);
+    nodeOvNum = 0;
+}
+
+void HopticsUI::refreshNodeOverlay(void)
+{
+    dirtyNodeOv = false;
+    const Node *n = findNode(nodeOvNum);
+    if (!n)
+        return;
+    char buf[400], tmp[64], ago[12];
+    lv_label_set_text(nodeOvTitle, n->shortName);
+    setBadge(nodeOvBadge, n->num);
+    lv_label_set_text(nodeOvName, nodeLong(n->num, tmp, sizeof(tmp)));
+    snprintf(buf, sizeof(buf), "!%08x  -  %s%s", (unsigned)n->num, roleName(n->role), n->hasKey ? "  -  " LV_SYMBOL_EYE_CLOSE : "");
+    lv_label_set_text(nodeOvId, buf);
+
+    std::string s;
+    agoString((n->lastHeard > nowTs + 60) ? 0 : n->lastHeard, ago, sizeof(ago));
+    snprintf(tmp, sizeof(tmp), "Last heard: %s ago   Packets: %u\n", ago, (unsigned)n->packets);
+    s += tmp;
+    if (n->viaMqtt)
+        s += "Route: via MQTT\n";
+    else if (n->hops == 0)
+        s += "Route: direct neighbour\n";
+    else if (n->hops > 0) {
+        snprintf(tmp, sizeof(tmp), "Route: %d hop%s away\n", n->hops, n->hops == 1 ? "" : "s");
+        s += tmp;
+    }
+    if (n->hasSignal) {
+        snprintf(tmp, sizeof(tmp), "Signal: %d dBm   SNR %+.1f dB\n", n->rssi, n->snr);
+        s += tmp;
+    }
+    if (n->battery <= 100) {
+        snprintf(tmp, sizeof(tmp), "Battery: %u%%  (%.2f V)\n", n->battery, n->voltage);
+        s += tmp;
+    } else if (n->battery == 101)
+        s += "Battery: external power\n";
+    if (n->chUtil >= 0) {
+        snprintf(tmp, sizeof(tmp), "Ch util: %.1f%%   Air TX: %.1f%%\n", n->chUtil, n->airUtil >= 0 ? n->airUtil : 0.0f);
+        s += tmp;
+    }
+    if (n->hasPos) {
+        char cb[80];
+        if (cityLabel(n->num, cb, sizeof(cb))) {
+            s += (n->cityKm < IN_CITY_KM) ? "In: " : "Near: ";
+            s += std::string(cb) + "\n";
+        }
+        snprintf(tmp, sizeof(tmp), "Position: %.5f, %.5f", n->lat / 1e7, n->lon / 1e7);
+        s += tmp;
+        if (n->alt)
+            s += "  " + std::to_string(n->alt) + " m";
+        s += "\n";
+        const Node *me = findNode(myNode);
+        if (me && me->num != n->num) {
+            double d = distanceKm(*me, *n);
+            if (d >= 0) {
+                snprintf(tmp, sizeof(tmp), "Distance: %.2f km (%.1f mi)\n", d, d * 0.621371);
+                s += tmp;
+            }
+        }
+    }
+    if (!s.empty() && s.back() == '\n')
+        s.pop_back();
+    lv_label_set_text(nodeOvInfo, s.c_str());
+
+    lv_chart_set_all_values(nodeOvChart, nodeOvSeries, LV_CHART_POINT_NONE);
+    for (uint8_t i = 0; i < n->snrCount; i++) {
+        uint8_t idx = (uint8_t)((n->snrIdx + 16 - n->snrCount + i) % 16);
+        lv_chart_set_series_value_by_id(nodeOvChart, nodeOvSeries, 16 - n->snrCount + i, n->snrHist[idx]);
+    }
+    lv_chart_refresh(nodeOvChart);
+}
+
+void HopticsUI::showTraceRoute(uint32_t target, const std::string &text)
+{
+    if (!mainScreen)
+        return;
+    if (nodeOvNum == target && !lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN)) {
+        lv_label_set_text(nodeOvTrace, text.c_str());
+        lv_obj_remove_flag(lv_obj_get_parent(nodeOvTrace), LV_OBJ_FLAG_HIDDEN);
+    } else {
+        char buf[16];
+        std::string t = std::string(LV_SYMBOL_SHUFFLE " Route to ") + nodeShort(target, buf, sizeof(buf)) + ": " + text;
+        showToast(t.c_str(), 6000);
+    }
+}
