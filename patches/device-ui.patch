+// ================================================================= phone app mode
+// With Bluetooth on, the firmware's PacketAPI stops feeding the built-in screen ("programming mode") so the
+// phone app owns the radio. This page says so, shows the pairing PIN and offers the way back.
+void HopticsUI::showPhoneMode(uint32_t pin, bool restarting)
+{
+    if (!phoneScreen) {
+        initFonts();
+        applyLayout();
+        keysInit();
+        NoAutoGroup noAuto(keysOn);
+        phoneScreen = lv_obj_create(NULL);
+        lv_obj_remove_flag(phoneScreen, LV_OBJ_FLAG_SCROLLABLE);
+        lv_obj_set_style_bg_color(phoneScreen, C_BG, 0);
+        lv_obj_set_style_bg_grad_color(phoneScreen, C_CARD2, 0);
+        lv_obj_set_style_bg_grad_dir(phoneScreen, LV_GRAD_DIR_VER, 0);
+        lv_obj_set_style_pad_all(phoneScreen, LAND ? 10 : 14, 0);
+        lv_obj_set_flex_flow(phoneScreen, LV_FLEX_FLOW_COLUMN);
+        lv_obj_set_flex_align(phoneScreen, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+        lv_obj_set_style_pad_row(phoneScreen, LAND ? 5 : 10, 0);
+
+        lv_obj_t *icon = label(phoneScreen, &F20, C_BLUE, LV_SYMBOL_BLUETOOTH);
+        lv_obj_set_style_text_font(icon, &lv_font_montserrat_28, 0);
+        lv_obj_t *title = label(phoneScreen, &F20, C_TEXT, "Phone app mode");
+        (void)title;
+        phoneMsg = label(phoneScreen, &F14, C_DIM, "");
+        lv_obj_set_width(phoneMsg, LV_PCT(100));
+        lv_label_set_long_mode(phoneMsg, LV_LABEL_LONG_MODE_WRAP);
+        lv_obj_set_style_text_align(phoneMsg, LV_TEXT_ALIGN_CENTER, 0);
+        phonePin = label(phoneScreen, &F20, C_BLUE, "");
+        lv_obj_set_style_text_font(phonePin, &lv_font_montserrat_28, 0);
+        phoneBtn = flatButton(phoneScreen, touchInput ? LV_SYMBOL_HOME " Back to touch screen" : LV_SYMBOL_HOME " Back to this screen",
+                              C_GREEN, LAND ? 240 : W() - 28, LAND ? 38 : 44);
+        stop(phoneBtn);
+        // two-tap confirm, like Reboot: the first tap arms the button for 3 s
+        lv_obj_add_event_cb(
+            phoneBtn,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                lv_obj_t *b = (lv_obj_t *)lv_event_get_current_target(e);
+                if (lv_obj_has_state(b, LV_STATE_USER_1)) {
+                    if (ui->cbs.leavePhoneMode)
+                        ui->cbs.leavePhoneMode();
+                    ui->showPhoneMode(0, true);
+                    return;
+                }
+                lv_obj_add_state(b, LV_STATE_USER_1);
+                setButtonText(b, ui->touchInput ? "Tap again to restart" : "Press again to restart");
+                lv_timer_t *t = lv_timer_create(
+                    [](lv_timer_t *t) {
+                        HopticsUI *u = (HopticsUI *)lv_timer_get_user_data(t);
+                        lv_obj_remove_state(u->phoneBtn, LV_STATE_USER_1);
+                        setButtonText(u->phoneBtn, u->touchInput ? LV_SYMBOL_HOME " Back to touch screen"
+                                                                 : LV_SYMBOL_HOME " Back to this screen");
+                    },
+                    3000, ui);
+                lv_timer_set_repeat_count(t, 1);
+            },
+            LV_EVENT_CLICKED, this);
+        lv_screen_load(phoneScreen);
+        // the boot and main screens stay alive underneath; the radio restarts out of this mode anyway
+    }
+    if (restarting) {
+        lv_label_set_text(phoneMsg, pin ? "Restarting with Bluetooth on for the Meshtastic app..."
+                                        : (touchInput ? "Restarting back to the touch screen..." : "Restarting back to this screen..."));
+        lv_obj_add_flag(phoneBtn, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_label_set_text(phoneMsg, touchInput ? "Bluetooth is on for the Meshtastic app. The touch screen is paused while the "
+                                                 "app is in charge. Pair the app with this PIN:"
+                                               : "Bluetooth is on for the Meshtastic app. This screen is paused while the app "
+                                                 "is in charge. Pair the app with this PIN:");
+        lv_obj_remove_flag(phoneBtn, LV_OBJ_FLAG_HIDDEN);
+    }
+    keyScope(phoneBtn);
+    if (pin)
+        lv_label_set_text_fmt(phonePin, "%06u", (unsigned)pin);
+    else if (!restarting)
+        lv_label_set_text(phonePin, "------");
+    else
+        lv_label_set_text(phonePin, "");
+}
