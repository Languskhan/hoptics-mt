+void HopticsUI::mapZoom(int dir)
+{
+    if (dir == 0) {
+        mapUserZoom = false;
+        mapUserPan = false;
+        mapFit();
+    } else {
+        // whole zoom steps keep the tiles pixel-sharp; zoom about the middle of the view
+        int nz = std::max(HOPTICS_MAP_MIN_ZOOM, std::min(HOPTICS_MAP_MAX_ZOOM, mapZ + dir));
+        if (nz > mapZ) {
+            mapCX *= 2;
+            mapCY *= 2;
+        } else if (nz < mapZ) {
+            mapCX /= 2;
+            mapCY /= 2;
+        }
+        mapZ = nz;
+        mapUserZoom = true;
+    }
+    refreshMap();
+}
+
+void HopticsUI::mapTouch(lv_event_t *e)
+{
+    const lv_event_code_t code = lv_event_get_code(e);
+    if (code != LV_EVENT_PRESSED && code != LV_EVENT_PRESSING && code != LV_EVENT_RELEASED && code != LV_EVENT_PRESS_LOST)
+        return;
+    lv_indev_t *indev = lv_indev_active();
+    if (!indev || lv_indev_get_type(indev) != LV_INDEV_TYPE_POINTER)
+        return; // a finger drag; keys pan with mapPanKey()
+    lv_point_t pt;
+    lv_indev_get_point(indev, &pt);
+    switch (code) {
+    case LV_EVENT_PRESSED:
+        mapPressAt = pt;
+        mapDragging = false;
+        mapJustDragged = false;
+        break;
+    case LV_EVENT_PRESSING: {
+        const int32_t dx = pt.x - mapPressAt.x, dy = pt.y - mapPressAt.y;
+        if (!mapDragging && (std::abs(dx) > 8 || std::abs(dy) > 8) && mapHaveCenter)
+            mapDragging = true;
+        if (mapDragging) {
+            mapDragDx = dx;
+            mapDragDy = dy;
+            lv_obj_set_pos(mapLayer, dx, dy);
+        }
+        break;
+    }
+    default: // released / press lost
+        if (mapDragging) {
+            mapDragging = false;
+            mapJustDragged = true; // the CLICKED that follows on a dot is ignored
+            mapCommitPan(mapDragDx, mapDragDy);
+        }
+        break;
+    }
+}
+
+void HopticsUI::mapCommitPan(int32_t dx, int32_t dy)
+{
+    lv_obj_set_pos(mapLayer, 0, 0);
+    if (!dx && !dy)
+        return;
+    mapUserPan = true;
+    mapCX -= dx;
+    mapCY -= dy;
+    if (mapTiles && mapDsc.data) {
+        // move what is already drawn with the finger, then let the worker fill the edges
+        hoptics::MapView v;
+        v.z = (uint8_t)mapZ;
+        v.ox = mapOx - dx;
+        v.oy = mapOy - dy;
+        v.w = (int16_t)mapW;
+        v.h = (int16_t)mapH;
+        v.style = mapStyle();
+        v.bg = lv_color_to_u16(C_CARD);
+        hoptics::TileMap::get().shiftAndRequest(dx, dy, v);
+    }
+    refreshMap();
+}
+
+bool HopticsUI::mapProject(int32_t lat, int32_t lon, int32_t &x, int32_t &y) const
+{
+    double wx, wy;
+    geoToWorld(lat / 1e7, lon / 1e7, mapZ, wx, wy);
+    const double world = 256.0 * (double)(1u << mapZ);
+    if (wx - mapCX > world / 2) // use the copy of the world nearest the view (date line)
+        wx -= world;
+    else if (mapCX - wx > world / 2)
+        wx += world;
+    x = (int32_t)floor(wx) - mapOx;
+    y = (int32_t)floor(wy) - mapOy;
+    return x >= -6 && y >= -6 && x <= mapW + 6 && y <= mapH + 6;
+}
+
+void HopticsUI::mapFit(void)
+{
+    if (!mapArea)
+        return;
+    lv_obj_update_layout(mapArea);
+    const Node *me = findNode(myNode);
+    // centre on our own fix, otherwise on the middle of everyone we know about
+    int32_t cLat = 0, cLon = 0;
+    if (me && me->hasPos) {
+        cLat = me->lat;
+        cLon = me->lon;
+        mapHaveCenter = true;
+    } else {
+        double sLat = 0, sLon = 0;
+        int n = 0;
+        for (const auto &nd : nodes)
+            if (nd.hasPos) {
+                sLat += nd.lat;
+                sLon += nd.lon;
+                n++;
+            }
+        mapHaveCenter = n > 0;
+        if (n) {
+            cLat = (int32_t)(sLat / n);
+            cLon = (int32_t)(sLon / n);
+        }
+    }
+    // zoom so the farthest recently-heard node fits (ignore stale nodes far away)
+    double maxKm = 0.5;
+    Node c{};
+    c.hasPos = true;
+    c.lat = cLat;
+    c.lon = cLon;
+    for (const auto &nd : nodes) {
+        if (!nd.hasPos || nd.num == myNode || nd.viaMqtt) // MQTT brings in nodes from far away; zoom out by hand for them
+            continue;
+        bool recent = nd.lastHeard && nd.lastHeard <= nowTs + 60 && nowTs - std::min(nowTs, nd.lastHeard) < 24 * 3600;
+        if (!recent && clockValid)
+            continue;
+        double d = distanceKm(c, nd);
+        if (d < 400) // a node reporting a position on another continent shouldn't zoom us out to nothing
+            maxKm = std::max(maxKm, d);
+    }
+    const int32_t w = lv_obj_get_content_width(mapArea), h = lv_obj_get_content_height(mapArea);
+    const double radiusPx = std::max<int32_t>(20, std::min(w, h) / 2 - 14);
+    const double z = log2(radiusPx * kmPerPx(cLat / 1e7, 0) / (maxKm * 1.08));
+    mapZ = std::max(HOPTICS_MAP_MIN_ZOOM, std::min(16, (int)floor(z)));
+    geoToWorld(cLat / 1e7, cLon / 1e7, mapZ, mapCX, mapCY);
+    dirtyMap = true;
+}
+
+void HopticsUI::mapUpdateTiles(void)
+{
+    if (!mapImg)
+        return;
+    uint16_t *buf = (mapTiles && mapHaveCenter) ? hoptics::TileMap::get().buffer((int16_t)mapW, (int16_t)mapH) : nullptr;
+    if (!buf) {
+        lv_obj_add_flag(mapImg, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(mapAttr, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(mapNote, LV_OBJ_FLAG_HIDDEN);
+        return;
+    }
+    if (mapDsc.data != (const uint8_t *)buf || (int32_t)mapDsc.header.w != mapW || (int32_t)mapDsc.header.h != mapH) {
+        std::fill_n(buf, (size_t)mapW * mapH, lv_color_to_u16(C_CARD)); // new buffer: blank until tiles arrive
+        HOPTICS_IMAGE_CHANGED(&mapDsc);
+        mapDsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+        mapDsc.header.cf = LV_COLOR_FORMAT_RGB565;
+        mapDsc.header.flags = 0;
+        mapDsc.header.w = (uint32_t)mapW;
+        mapDsc.header.h = (uint32_t)mapH;
+        mapDsc.header.stride = (uint32_t)mapW * 2;
+        mapDsc.data_size = (uint32_t)mapW * mapH * 2;
+        mapDsc.data = (const uint8_t *)buf;
+        lv_image_set_src(mapImg, &mapDsc);
+    }
+    lv_obj_remove_flag(mapImg, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_remove_flag(mapAttr, LV_OBJ_FLAG_HIDDEN);
+    hoptics::MapView v;
+    v.z = (uint8_t)mapZ;
+    v.ox = mapOx;
+    v.oy = mapOy;
+    v.w = (int16_t)mapW;
+    v.h = (int16_t)mapH;
+    v.style = mapStyle();
+    v.bg = lv_color_to_u16(C_CARD);
+    hoptics::TileMap::get().request(v);
+}
+
+void HopticsUI::refreshMapNote(void)
+{
+    if (!mapNote)
+        return;
+    const char *t = nullptr;
+    if (mapTiles && mapHaveCenter) {
+        hoptics::MapStatus s = hoptics::TileMap::get().status();
+        if (s.pending && s.problem == hoptics::MapStatus::BUSY)
+            t = LV_SYMBOL_WARNING " Map server busy, retrying";
+        else if (s.pending && s.problem == hoptics::MapStatus::NO_LINK)
+            t = LV_SYMBOL_WARNING " Can't reach the map server";
+        else if (s.pending && !s.online)
+            t = LV_SYMBOL_WIFI " Map tiles need Wi-Fi";
+        else if (s.pending)
+            t = LV_SYMBOL_DOWNLOAD " Loading map...";
+    }
+    if (t) {
+        if (strcmp(lv_label_get_text(mapNote), t) != 0)
+            lv_label_set_text(mapNote, t);
+        lv_obj_remove_flag(mapNote, LV_OBJ_FLAG_HIDDEN);
+    } else {
+        lv_obj_add_flag(mapNote, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void HopticsUI::setMapTiles(bool on)
+{
+    if (on == mapTiles)
+        return;
+    mapTiles = on;
+    saveMapPref(on);
+    hoptics::TileMap::get().setEnabled(on);
+    dirtyMap = true;
+    if (activeTab == T_MAP)
+        refreshMap();
+}
+
+void HopticsUI::service(void)
+{
+    if (!mainScreen)
+        return;
+    hoptics::TileMap &tm = hoptics::TileMap::get();
+    if (tm.takeDirty() && mapImg && mapDsc.data) {
+        HOPTICS_IMAGE_CHANGED(&mapDsc); // same pixels pointer, new pixels
+        lv_obj_invalidate(mapImg);
+    }
+    if (lv_tick_elaps(mapNoteTick) < 400)
+        return;
+    mapNoteTick = lv_tick_get();
+    if (activeTab == T_MAP)
+        refreshMapNote();
+    if (setOv && setMapInfo && !lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN)) {
+        hoptics::MapStatus s = tm.status();
+        char b[48];
+        snprintf(b, sizeof(b), "Saved: %u tiles, %u KB", (unsigned)s.savedTiles, (unsigned)s.savedKB);
+        if (strcmp(lv_label_get_text(setMapInfo), b) != 0)
+            lv_label_set_text(setMapInfo, b);
+    }
+}
+
+void HopticsUI::refreshMap(void)
+{
+    if (!mainScreen || !mapArea)
+        return;
+    if (mapDragging) { // redrawn when the finger lifts
+        dirtyMap = true;
+        return;
+    }
+    dirtyMap = false;
+    lv_obj_update_layout(mapArea);
+    if (!mapHaveCenter)
+        mapFit();
+    const int32_t w = lv_obj_get_content_width(mapArea), h = lv_obj_get_content_height(mapArea);
+    const Node *me = findNode(myNode);
+    const bool meOn = me && me->hasPos;
+    // follow our own fix as it moves, unless the map has been dragged somewhere else
+    if (meOn && !mapUserPan) {
+        double wx, wy;
+        geoToWorld(me->lat / 1e7, me->lon / 1e7, mapZ, wx, wy);
+        if (fabs(wx - mapCX) > 6 || fabs(wy - mapCY) > 6) {
+            mapCX = wx;
+            mapCY = wy;
+        }
+    }
+    const double world = 256.0 * (double)(1u << mapZ);
+    mapCX = fmod(fmod(mapCX, world) + world, world);              // round the world past the date line
+    mapCY = std::max(h / 2.0, std::min(world - h / 2.0, mapCY)); // not past the top or bottom of the map
+    mapW = w;
+    mapH = h;
+    mapOx = (int32_t)floor(mapCX) - w / 2;
+    mapOy = (int32_t)floor(mapCY) - h / 2;
+    lv_obj_set_size(mapLayer, w, h);
+    lv_obj_set_pos(mapLayer, 0, 0);
+    mapUpdateTiles();
+    const bool tilesOn = mapTiles && mapHaveCenter && mapDsc.data && !lv_obj_has_flag(mapImg, LV_OBJ_FLAG_HIDDEN);
+
+    // range rings around the middle of the view
+    const float kpp = (float)kmPerPx(worldLat(mapCY, mapZ), mapZ);
+    float viewKm = kpp * std::min(w, h) / 2;
+    float step = niceStep(viewKm / 3);
+    for (int i = 0; i < 3; i++) {
+        float km = step * (i + 1);
+        int32_t r = (int32_t)(km / kpp);
+        lv_obj_set_size(mapRings[i], r * 2, r * 2);
+        lv_obj_set_pos(mapRings[i], w / 2 - r, h / 2 - r);
+        lv_obj_set_style_border_color(mapRings[i], tilesOn ? C_MUTED : C_LINE, 0);
+        lv_obj_set_style_border_opa(mapRings[i], tilesOn ? LV_OPA_50 : LV_OPA_COVER, 0);
+        char b[16];
+        if (km < 1)
+            snprintf(b, sizeof(b), "%.0f m", km * 1000);
+        else
+            snprintf(b, sizeof(b), "%g km", km);
+        lv_label_set_text(mapRingLbl[i], b);
+        lv_obj_set_style_text_color(mapRingLbl[i], tilesOn ? C_MUTED : C_DIM, 0);
+        lv_obj_set_pos(mapRingLbl[i], w / 2 + 3, h / 2 - r + 1);
+        bool vis = r > 8 && r < std::max(w, h);
+        if (vis) {
+            lv_obj_remove_flag(mapRings[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_remove_flag(mapRingLbl[i], LV_OBJ_FLAG_HIDDEN);
+        } else {
+            lv_obj_add_flag(mapRings[i], LV_OBJ_FLAG_HIDDEN);
+            lv_obj_add_flag(mapRingLbl[i], LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    int32_t mx = w / 2, my = h / 2;
+    bool meVisible = meOn && mapProject(me->lat, me->lon, mx, my);
+    if (meVisible) {
+        lv_obj_set_pos(mapMe, mx - 7, my - 7);
+        lv_obj_remove_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+    } else
+        lv_obj_add_flag(mapMe, LV_OBJ_FLAG_HIDDEN);
+
+    // newest first, so the most relevant nodes win when there are more than we can draw
+    std::vector<const Node *> pos;
+    for (const auto &nd : nodes)
+        if (nd.hasPos && nd.num != myNode)
+            pos.push_back(&nd);
+    std::sort(pos.begin(), pos.end(), [](const Node *a, const Node *b) { return a->lastHeard > b->lastHeard; });
+
+    int shown = 0, offscreen = 0;
+    for (const Node *nd : pos) {
+        if (shown >= HOPTICS_MAP_MARKERS)
+            break;
+        int32_t x, y;
+        if (!mapProject(nd->lat, nd->lon, x, y)) {
+            offscreen++;
+            continue;
+        }
+        lv_obj_t *d = mapDots[shown];
+        bool online = nd->lastHeard && nd->lastHeard <= nowTs + 60 && nowTs - std::min(nowTs, nd->lastHeard) <= kOnlineSecs;
+        lv_obj_set_style_bg_color(d, nodeColor(nd->num), 0);
+        lv_obj_set_style_opa(d, online ? LV_OPA_COVER : LV_OPA_40, 0);
+        lv_obj_set_pos(d, x - 5, y - 5);
+        lv_obj_set_user_data(d, (void *)(uintptr_t)nd->num);
+        lv_label_set_text(lv_obj_get_child(d, 0), nd->shortName);
+        lv_obj_remove_flag(d, LV_OBJ_FLAG_HIDDEN);
+
+        lv_obj_t *ln = mapLinks[shown];
+        if (meOn && nd->hops == 0 && nd->hasSignal && !nd->viaMqtt) {
+            int32_t ax, ay;
+            mapProject(me->lat, me->lon, ax, ay);
+            mapLinkPts[shown][0] = {(lv_value_precise_t)ax, (lv_value_precise_t)ay};
+            mapLinkPts[shown][1] = {(lv_value_precise_t)x, (lv_value_precise_t)y};
+            lv_line_set_points(ln, mapLinkPts[shown], 2);
+            lv_obj_set_style_line_color(ln, snrColor(nd->snr), 0);
+            lv_obj_remove_flag(ln, LV_OBJ_FLAG_HIDDEN);
+        } else
+            lv_obj_add_flag(ln, LV_OBJ_FLAG_HIDDEN);
+        shown++;
+    }
+    for (int i = shown; i < HOPTICS_MAP_MARKERS; i++) {
+        lv_obj_add_flag(mapDots[i], LV_OBJ_FLAG_HIDDEN);
+        lv_obj_add_flag(mapLinks[i], LV_OBJ_FLAG_HIDDEN);
+    }
+    lv_obj_move_to_index(mapMe, -1);
+
+    if (pos.empty() && !meOn)
+        lv_obj_remove_flag(mapEmpty, LV_OBJ_FLAG_HIDDEN);
+    else
+        lv_obj_add_flag(mapEmpty, LV_OBJ_FLAG_HIDDEN);
+
+    char b[64];
+    lv_obj_set_style_text_color(mapRange, mapPan ? C_AMBER : C_MUTED, 0);
+    if (mapPan)
+        snprintf(b, sizeof(b), LV_SYMBOL_GPS " moving - Enter ends");
+    else if (!meOn && !pos.empty())
+        snprintf(b, sizeof(b), "no GPS fix - centred on mesh");
+    else if (offscreen)
+        snprintf(b, sizeof(b), "%d here, %d off map", shown, offscreen);
+    else
+        snprintf(b, sizeof(b), "%d nodes with GPS", shown);
+    lv_label_set_text(mapRange, b);
+    refreshMapNote();
+}
+
+void HopticsUI::mapPing(uint32_t num, uint16_t port, bool viaMqtt, int8_t hops)
+{
+    if (!mainScreen || activeTab != T_MAP || mapPings >= 12 || mapDragging || !lv_obj_has_flag(chatOv, LV_OBJ_FLAG_HIDDEN) ||
+        !lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN) || !lv_obj_has_flag(setOv, LV_OBJ_FLAG_HIDDEN))
+        return;
+    const Node *n = findNode(num);
+    if (!n || !n->hasPos)
+        return;
+    int32_t x, y;
+    if (!mapProject(n->lat, n->lon, x, y))
+        return;
+    lv_color_t col = viaMqtt ? C_VIOLET : portColor(port);
+
+    // expanding ring at the sender
+    lv_obj_t *ring = plain(mapLayer);
+    lv_obj_set_style_radius(ring, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_border_width(ring, viaMqtt ? 1 : 2, 0);
+    lv_obj_set_style_border_color(ring, col, 0);
+    lv_obj_remove_flag(ring, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_set_pos(ring, x, y);
+    lv_obj_set_size(ring, 1, 1);
+    mapPings++;
+
+    lv_anim_t a;
+    lv_anim_init(&a);
+    lv_anim_set_var(&a, ring);
+    lv_anim_set_values(&a, 4, 46);
+    lv_anim_set_duration(&a, 1300);
+    lv_anim_set_path_cb(&a, lv_anim_path_ease_out);
+    lv_obj_set_user_data(ring, (void *)(intptr_t)(((x & 0xffff) << 16) | (y & 0xffff)));
+    lv_anim_set_user_data(&a, ring);
+    lv_anim_set_exec_cb(&a, [](void *obj, int32_t v) {
+        lv_obj_t *o = (lv_obj_t *)obj;
+        intptr_t packed = (intptr_t)lv_obj_get_user_data(o);
+        int32_t cx = (int16_t)((packed >> 16) & 0xffff), cy = (int16_t)(packed & 0xffff);
+        lv_obj_set_size(o, v, v);
+        lv_obj_set_pos(o, cx - v / 2, cy - v / 2);
+        lv_obj_set_style_opa(o, (lv_opa_t)(255 - (v - 4) * 255 / 42), 0);
+    });
+    lv_anim_set_completed_cb(&a, [](lv_anim_t *an) { lv_obj_delete_async((lv_obj_t *)lv_anim_get_user_data(an)); });
+    lv_anim_start(&a);
+    // decrement the in-flight counter when the ring is gone
+    lv_obj_add_event_cb(
+        ring, [](lv_event_t *e) { ((HopticsUI *)lv_event_get_user_data(e))->mapPings--; }, LV_EVENT_DELETE, this);
+
+    // a direct RF packet also flashes a beam to us
+    const Node *me = findNode(myNode);
+    int32_t mx, my;
+    if (hops == 0 && !viaMqtt && me && me->hasPos && mapProject(me->lat, me->lon, mx, my)) {
+        lv_point_precise_t *pts = (lv_point_precise_t *)lv_malloc(sizeof(lv_point_precise_t) * 2);
+        if (!pts)
+            return;
+        pts[0] = {(lv_value_precise_t)x, (lv_value_precise_t)y};
+        pts[1] = {(lv_value_precise_t)mx, (lv_value_precise_t)my};
+        lv_obj_t *beam = lv_line_create(mapLayer);
+        lv_line_set_points(beam, pts, 2);
+        lv_obj_set_style_line_width(beam, 3, 0);
+        lv_obj_set_style_line_color(beam, col, 0);
+        lv_obj_set_style_line_rounded(beam, true, 0);
+        lv_obj_remove_flag(beam, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_user_data(beam, pts);
+        lv_obj_add_event_cb(
+            beam, [](lv_event_t *e) { lv_free(lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e))); },
+            LV_EVENT_DELETE, nullptr);
+        lv_anim_t b;
+        lv_anim_init(&b);
+        lv_anim_set_var(&b, beam);
+        lv_anim_set_values(&b, 255, 0);
+        lv_anim_set_duration(&b, 900);
+        lv_anim_set_user_data(&b, beam);
+        lv_anim_set_exec_cb(&b, [](void *obj, int32_t v) { lv_obj_set_style_line_opa((lv_obj_t *)obj, (lv_opa_t)v, 0); });
+        lv_anim_set_completed_cb(&b, [](lv_anim_t *an) { lv_obj_delete_async((lv_obj_t *)lv_anim_get_user_data(an)); });
+        lv_anim_start(&b);
+        lv_obj_move_to_index(mapMe, -1);
+    }
+}
