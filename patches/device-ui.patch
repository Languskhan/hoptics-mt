diff --git a/include/graphics/view/TFT/HopticsBoard.h b/include/graphics/view/TFT/HopticsBoard.h
new file mode 100644
index 0000000..1eff63a
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsBoard.h
@@ -0,0 +1,49 @@
+#pragma once
+/**
+ * Hoptics MT - board facts the UI cannot find out at run time. GPL-3.0, same as device-ui.
+ * (Touch screen, keyboard and trackball are known at run time: see HopticsInput.h.)
+ */
+
+namespace hoptics
+{
+namespace board
+{
+
+// Short name for problem reports. One word: the report's details line is space-separated.
+#if defined(HELTEC_V4_R8)
+constexpr const char *kName = "V4-R8";
+#elif defined(HELTEC_V4)
+constexpr const char *kName = "V4";
+#elif defined(T_DECK_PLUS)
+constexpr const char *kName = "T-Deck-Plus";
+#elif defined(T_DECK)
+constexpr const char *kName = "T-Deck";
+#elif defined(ELECROW_ThinkNode_M9)
+constexpr const char *kName = "M9";
+#elif defined(ARDUINO_ARCH_ESP32)
+constexpr const char *kName = "ESP32";
+#else
+constexpr const char *kName = "host";
+#endif
+
+// The board takes plug-in environment sensors (the Heltec kits' expansion board slots). The T-Deck Plus
+// (its Grove port carries the GPS) and the ThinkNode M9 have no sensor and no free connector: a sensor
+// there would have to be wired to the I2C bus by hand, so hints like "is the sensor board seated?" do not
+// apply and an empty Environment card can be left out.
+#if defined(T_DECK) || defined(ELECROW_ThinkNode_M9)
+constexpr bool kSensorSlots = false;
+#else
+constexpr bool kSensorSlots = true;
+#endif
+
+// The board has a GPS receiver, so Settings offers the GPS switch even when the stored config says "not
+// present" (a node updated from a stock build without erasing keeps that). Elsewhere the switch only
+// shows when the radio reports a GPS mode other than "not present".
+#if defined(T_DECK_PLUS) || defined(ELECROW_ThinkNode_M9) || defined(HELTEC_V4_R8)
+constexpr bool kGps = true;
+#else
+constexpr bool kGps = false;
+#endif
+
+} // namespace board
+} // namespace hoptics
diff --git a/include/graphics/view/TFT/HopticsInput.h b/include/graphics/view/TFT/HopticsInput.h
new file mode 100644
index 0000000..ec1d1d3
--- /dev/null
+++ b/include/graphics/view/TFT/HopticsInput.h
@@ -0,0 +1,36 @@
+#pragma once
+/**
+ * Hoptics MT - keyboard and trackball (LilyGO T-Deck Plus, Elecrow ThinkNode M9) on top of device-ui's
+ * input drivers. GPL-3.0, same as device-ui.
+ *
+ * device-ui creates the input devices in DeviceGUI::init(), before any Hoptics screen exists:
+ *  - I2C keyboards (T-Deck 0x55, ThinkNode M9 0x6C/0x6D, CardKB...) as an LV_INDEV_TYPE_KEYPAD
+ *  - the T-Deck trackball as an LV_INDEV_TYPE_ENCODER (roll up/down = enc_diff -1/+1, roll left/right =
+ *    LV_KEY_DOWN/LV_KEY_UP sent to the focused widget, click = LV_KEY_ENTER)
+ *  - on the T-Deck also a LV_INDEV_TYPE_BUTTON (trackball click) that LGFXDriver only enables while the
+ *    screen is dark
+ * Those drivers put the keypad and encoder on a group they create and make the default. This class keeps
+ * them on whatever group the UI makes the default later, and makes sure the key that wakes a dark screen
+ * only wakes it.
+ */
+#include "lvgl.h"
+
+class DisplayDriver;
+
+namespace hoptics
+{
+
+class Input
+{
+  public:
+    // once, after MeshtasticView::init() has created the input devices
+    static void begin(DisplayDriver *display);
+    // every UI loop: keypad and encoder follow lv_group_get_default() (cheap: a pointer compare per device)
+    static void service(void);
+    // a keyboard or trackball is attached, so the UI is also driven by focus, not only by touch
+    static bool hasKeys(void);
+    // a touch screen is attached (false on the ThinkNode M9: everything must be reachable by keys)
+    static bool hasTouch(void);
+};
+
+} // namespace hoptics
