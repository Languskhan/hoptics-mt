+void applyPalette(int t)
+{
+    T_IDX = t;
+    T_BORDERS = false;
+    auto set = [](uint32_t bg, uint32_t bar, uint32_t card, uint32_t card2, uint32_t line, uint32_t text, uint32_t muted,
+                  uint32_t dim, uint32_t cyan, uint32_t green, uint32_t amber, uint32_t red, uint32_t violet, uint32_t pink,
+                  uint32_t blue, uint32_t me, uint32_t onMe, uint32_t meMeta, uint32_t onAccent) {
+        C_BG = lv_color_hex(bg);
+        C_BAR = lv_color_hex(bar);
+        C_CARD = lv_color_hex(card);
+        C_CARD2 = lv_color_hex(card2);
+        C_LINE = lv_color_hex(line);
+        C_TEXT = lv_color_hex(text);
+        C_MUTED = lv_color_hex(muted);
+        C_DIM = lv_color_hex(dim);
+        C_CYAN = lv_color_hex(cyan);
+        C_GREEN = lv_color_hex(green);
+        C_AMBER = lv_color_hex(amber);
+        C_RED = lv_color_hex(red);
+        C_VIOLET = lv_color_hex(violet);
+        C_PINK = lv_color_hex(pink);
+        C_BLUE = lv_color_hex(blue);
+        C_ME = lv_color_hex(me);
+        C_ON_ME = lv_color_hex(onMe);
+        C_ME_META = lv_color_hex(meMeta);
+        C_ON_ACCENT = lv_color_hex(onAccent);
+    };
+    switch (t) {
+    case 1: // Daylight - high contrast for direct sun: dark text on white, saturated dark accents
+        set(0xF2F4F7, 0xFFFFFF, 0xFFFFFF, 0xE3E8EE, 0xB8C2CE, 0x05090F, 0x2E3A48, 0x5A6675, 0x0369A1, 0x047857, 0xB45309,
