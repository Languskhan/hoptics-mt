+// ---------------------------------------------------------------- user actions -> radio
+void HopticsView::wireCallbacks(void)
+{
+    HopticsUI::Callbacks cb;
+    cb.sendText = [this](uint32_t key, const char *text) -> uint32_t {
+        uint32_t to = UINT32_MAX;
+        uint8_t ch = 0;
+        bool usePkc = false;
+        uint8_t hopLimit = haveLora ? lora.hop_limit : 3;
+        uint32_t requestId;
+        if (key < HopticsUI::kMaxChannels) {
+            ch = (uint8_t)key;
+            requestId = requests.addRequest(ch, ResponseHandler::TextMessageRequest, (void *)(intptr_t)ch);
+        } else {
+            to = key;
+            ch = nodeChannel(to);
+            auto it = nodeHasKey.find(to);
+            usePkc = it != nodeHasKey.end() && it->second; // end-to-end encrypted DM when the peer has a public key
+            requestId = requests.addRequest(to, ResponseHandler::TextMessageRequest, (void *)(uintptr_t)to);
+        }
+        controller->sendTextMessage(to, ch, hopLimit, (uint32_t)time(nullptr), requestId, usePkc, text);
+        return requestId;
+    };
+    cb.traceRoute = [this](uint32_t node) {
+        uint32_t id = requests.addRequest(node, ResponseHandler::TraceRouteRequest, (void *)(uintptr_t)node);
+        controller->traceRoute(node, nodeChannel(node), haveLora ? lora.hop_limit : 3, id);
+    };
+    cb.requestPosition = [this](uint32_t node) {
+        uint32_t id = requests.addRequest(node, ResponseHandler::PositionRequest, (void *)(uintptr_t)node);
+        controller->requestPosition(node, nodeChannel(node), id);
+    };
+    cb.setBrightness = [this](uint8_t b) {
+        uiCfg.screen_brightness = b;
+        if (displaydriver->hasLight())
+            displaydriver->setBrightness(b);
+        storeUI();
+    };
+    cb.setScreenTimeout = [this](uint16_t t) {
+        uiCfg.screen_timeout = t;
+        displaydriver->setScreenTimeout(t);
+        storeUI();
+    };
+    cb.setBanner = [this](bool on) {
+        uiCfg.banner_enabled = on;
+        storeUI();
+    };
+    cb.setTheme = [this](int t) {
+        uiCfg.theme = (meshtastic_Theme)t;
+        storeUI();
+    };
+    cb.setWebChat = [this](bool on) {
+        uiCfg.has_node_highlight = true;
+        uiCfg.node_highlight.chat_switch = on;
+        storeUI();
+    };
+    cb.saveUser = [this](const char *s, const char *l) {
+        meshtastic_User u = myUser;
+        strncpy(u.short_name, s, sizeof(u.short_name) - 1);
+        u.short_name[sizeof(u.short_name) - 1] = 0;
+        strncpy(u.long_name, l, sizeof(u.long_name) - 1);
+        u.long_name[sizeof(u.long_name) - 1] = 0;
+        controller->sendConfig(u, ownNode);
+    };
+    cb.setRole = [this](int r) {
+        if (!haveDevice)
+            return;
+        meshtastic_Config_DeviceConfig d = device;
+        d.role = (meshtastic_Config_DeviceConfig_Role)r;
+        controller->sendConfig(std::move(d), ownNode);
+    };
+    cb.setRegion = [this](int r) {
+        if (!haveLora)
+            return;
+        meshtastic_Config_LoRaConfig l = lora;
+        l.region = (meshtastic_Config_LoRaConfig_RegionCode)r;
+        l.use_preset = true;
+        l.tx_enabled = true;
+        controller->sendConfig(std::move(l), ownNode);
+    };
+    cb.setPreset = [this](int p) {
+        if (!haveLora)
+            return;
+        meshtastic_Config_LoRaConfig l = lora;
+        l.use_preset = true;
+        l.modem_preset = (meshtastic_Config_LoRaConfig_ModemPreset)p;
+        l.channel_num = 0; // back to the preset's default slot
+        controller->sendConfig(std::move(l), ownNode);
+    };
+    cb.setBluetooth = [this](bool on) {
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = on;
+        if (on) {
+            // a fresh random PIN each time, shown on the phone-mode page - never the well-known default
+            b.mode = meshtastic_Config_BluetoothConfig_PairingMode_FIXED_PIN;
+            b.fixed_pin = randomPin();
+        }
+        controller->sendConfig(std::move(b), ownNode);
+    };
+    // Bluetooth on hands the radio to the phone app: PacketAPI stops feeding this screen until it is off again
+    // (firmware src/mesh/api/PacketAPI.cpp runOnce). Same sequence as the stock MUI enterProgrammingMode().
+    cb.enterPhoneMode = [this]() {
+        if (haveNetwork && network.wifi_enabled) {
+            meshtastic_Config_NetworkConfig n = network;
+            n.wifi_enabled = false; // Wi-Fi and Bluetooth exclude each other on ESP32 Meshtastic
+            controller->sendConfig(std::move(n), ownNode);
+        }
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = true;
+        b.mode = meshtastic_Config_BluetoothConfig_PairingMode_FIXED_PIN;
+        b.fixed_pin = randomPin();
+        bluetooth = b;
+        controller->sendConfig(meshtastic_Config_BluetoothConfig{b}, ownNode);
+        state = eWaitingForReboot;
+        ui.showPhoneMode(b.fixed_pin, true);
+        armRebootFallback();
+    };
+    cb.leavePhoneMode = [this]() {
+        meshtastic_Config_BluetoothConfig b = bluetooth;
+        b.enabled = false;
+        bluetooth = b;
+        controller->sendConfig(meshtastic_Config_BluetoothConfig{b}, ownNode); // the firmware saves and reboots
+        state = eWaitingForReboot;
+        armRebootFallback();
+    };
+    cb.reboot = [this]() { controller->requestReboot(5, ownNode); };
+    cb.shutdown = [this]() { controller->requestShutdown(5, ownNode); };
+    ui.setCallbacks(cb);
+}
