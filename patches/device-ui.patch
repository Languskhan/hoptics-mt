+// ================================================================= boot
+#ifdef HOPTICS_HAS_BOOT_BG
+// Which background to show this boot: 0, 1, 2, 0, ... kept in NVS so it rotates across power cycles too
+// (one tiny write per boot - NVS wear-levels it).
+static int nextBootBackground(int count)
+{
+    if (count <= 1)
+        return 0;
+#if defined(ARDUINO_ARCH_ESP32)
+    uint8_t idx = 0;
+    nvs_handle_t h;
+    if (nvs_open("hoptics", NVS_READWRITE, &h) == ESP_OK) {
+        nvs_get_u8(h, "bootbg", &idx); // stays 0 when not stored yet
+        nvs_set_u8(h, "bootbg", (uint8_t)((idx + 1) % count));
+        nvs_commit(h);
+        nvs_close(h);
+    }
+    return idx % count;
+#else
+    static int n = 0;
+    return n++ % count;
+#endif
+}
+#endif
