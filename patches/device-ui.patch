+// ================================================================= TOAST
+void HopticsUI::showToast(const char *text, uint32_t ms)
+{
+    if (!mainScreen)
+        return;
+    lv_label_set_text(toastLabel, text);
+    lv_obj_set_user_data(toast, nullptr);
+    lv_obj_remove_flag(toast, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(toast, -1);
