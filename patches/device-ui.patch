+void HopticsUI::refreshStats(void)
+{
+    if (!mainScreen)
+        return;
+    dirtyStats = false;
+
+    // autoscale packet-rate axes
+    int32_t maxRate = 5;
+    for (int i = 0; i < HOPTICS_HISTORY; i++)
+        if (histPktRate[i] != LV_CHART_POINT_NONE)
+            maxRate = std::max<int32_t>(maxRate, histPktRate[i]);
+    int32_t top = ((maxRate + 4) / 5) * 5;
+    lv_chart_set_axis_range(statRateChart, LV_CHART_AXIS_PRIMARY_Y, 0, top);
+
+    int32_t maxUtil = 10;
+    for (int i = 0; i < HOPTICS_HISTORY; i++) {
+        if (histChUtil[i] != LV_CHART_POINT_NONE)
+            maxUtil = std::max<int32_t>(maxUtil, histChUtil[i]);
+    }
+    lv_chart_set_axis_range(statUtilChart, LV_CHART_AXIS_PRIMARY_Y, 0, maxUtil <= 20 ? 20 : maxUtil <= 40 ? 40 : 100);
+
+    // hops histogram over online nodes
+    uint32_t hops[8] = {0};
+    uint32_t maxH = 1, unknown = 0;
+    for (const auto &n : nodes) {
+        if (n.num == myNode)
+            continue;
+        if (n.hops >= 0 && n.hops < 8)
+            hops[n.hops]++;
+        else
+            unknown++;
+    }
+    for (int i = 0; i < 8; i++) {
+        maxH = std::max(maxH, hops[i]);
+        lv_chart_set_series_value_by_id(statHopChart, serHops, i, (int32_t)hops[i]);
+    }
+    lv_chart_set_axis_range(statHopChart, LV_CHART_AXIS_PRIMARY_Y, 0, (int32_t)maxH);
+    lv_chart_refresh(statHopChart);
+    char buf[200];
+    snprintf(buf, sizeof(buf), "NODES BY HOPS AWAY  -  0 = direct  -  %u unknown", (unsigned)unknown);
+    lv_label_set_text(statHopCaption, buf);
+
+    // traffic mix
+    uint32_t total = 0;
+    for (int i = 0; i < 7; i++)
+        total += portCounts[i];
+    for (int i = 0; i < 7; i++) {
+        lv_bar_set_value(portBars[i], total ? (int32_t)(portCounts[i] * 100 / total) : 0, LV_ANIM_OFF);
+        lv_label_set_text_fmt(portVals[i], "%u", (unsigned)portCounts[i]);
+    }
+
+    // top talkers: who is using the airtime (a chatty node hurts everyone on a flooding mesh)
+    {
+        std::vector<const Node *> tk;
+        for (const auto &n : nodes)
+            if (n.num != myNode && n.packets)
+                tk.push_back(&n);
+        std::sort(tk.begin(), tk.end(), [](const Node *a, const Node *b) { return a->packets > b->packets; });
+        for (int i = 0; i < 5; i++) {
+            lv_obj_t *r = lv_obj_get_parent(talkBar[i]);
+            if (i >= (int)tk.size()) {
+                lv_obj_add_flag(r, LV_OBJ_FLAG_HIDDEN);
+                continue;
+            }
+            setBadge(talkName[i], tk[i]->num);
+            lv_bar_set_value(talkBar[i], (int32_t)(tk[i]->packets * 100 / std::max<uint32_t>(1, tk[0]->packets)), LV_ANIM_OFF);
+            lv_label_set_text_fmt(talkVal[i], "%u  %u%%", (unsigned)tk[i]->packets,
+                                  (unsigned)(pktTotal ? tk[i]->packets * 100 / pktTotal : 0));
+            lv_obj_remove_flag(r, LV_OBJ_FLAG_HIDDEN);
+        }
+    }
+
+    // best / worst direct neighbour
+    const Node *best = nullptr, *worst = nullptr;
+    uint32_t direct = 0;
+    for (const auto &n : nodes) {
+        if (n.num == myNode || !n.hasSignal || n.hops != 0)
+            continue;
+        direct++;
+        if (!best || n.snr > best->snr)
+            best = &n;
+        if (!worst || n.snr < worst->snr)
+            worst = &n;
+    }
+    char b1[12] = "-", b2[12] = "-";
+    if (best)
+        nodeShort(best->num, b1, sizeof(b1));
+    if (worst)
+        nodeShort(worst->num, b2, sizeof(b2));
+    snprintf(buf, sizeof(buf),
+             "Packets heard: %u  (direct %u, MQTT %u)\nDirect neighbours: %u\nBest: %s %+.1f dB   Worst: %s %+.1f dB",
+             (unsigned)pktTotal, (unsigned)pktDirect, (unsigned)pktMqtt, (unsigned)direct, b1, best ? best->snr : 0.0f, b2,
+             worst ? worst->snr : 0.0f);
+    lv_label_set_text(statTotals, buf);
+}
