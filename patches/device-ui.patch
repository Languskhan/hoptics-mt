+void HopticsUI::createBootScreen(const char *firmwareVersion)
+{
+    initFonts();
+    applyPalette(themeIdx);
+    applyLayout();
+    keysInit();
+    snprintf(fwVersion, sizeof(fwVersion), "%s", firmwareVersion ? firmwareVersion : "");
+    bootScreen = lv_obj_create(NULL);
+    lv_obj_remove_flag(bootScreen, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_color(bootScreen, C_BG, 0);
+    lv_obj_set_style_bg_grad_color(bootScreen, C_CARD2, 0);
+    lv_obj_set_style_bg_grad_dir(bootScreen, LV_GRAD_DIR_VER, 0);
+#ifdef HOPTICS_HAS_BOOT_BG
+    // background art (flash-resident RGB565, drawn straight from flash), a different one each boot;
+    // only when it matches the panel exactly
+    if (W() == HOPTICS_BOOT_BG_W && H() == HOPTICS_BOOT_BG_H) {
+        static lv_image_dsc_t bootBg;
+        bootBg.header.magic = LV_IMAGE_HEADER_MAGIC;
+        bootBg.header.cf = LV_COLOR_FORMAT_RGB565;
+        bootBg.header.flags = 0;
+        bootBg.header.w = HOPTICS_BOOT_BG_W;
+        bootBg.header.h = HOPTICS_BOOT_BG_H;
+        bootBg.header.stride = HOPTICS_BOOT_BG_W * 2;
+        bootBg.data_size = HOPTICS_BOOT_BG_W * HOPTICS_BOOT_BG_H * 2;
+        bootBg.data = hoptics_boot_bgs[nextBootBackground(HOPTICS_BOOT_BG_COUNT)];
+        lv_obj_t *bg = lv_image_create(bootScreen);
+        lv_image_set_src(bg, &bootBg);
+        lv_obj_set_pos(bg, 0, 0);
+        lv_obj_remove_flag(bg, LV_OBJ_FLAG_CLICKABLE);
+    }
+#endif
+
+    // logo: a node with three expanding radio arcs (smaller and higher on a landscape panel, where the
+    // title, spinner and status lines need the lower half)
+    const int32_t cx = W() / 2, cy = LAND ? 66 : H() / 2 - 40;
+    const int32_t radii[3] = {LAND ? 20 : 26, LAND ? 34 : 44, LAND ? 48 : 62};
+    for (int i = 0; i < 3; i++) {
+        lv_obj_t *a = lv_arc_create(bootScreen);
+        lv_obj_remove_style(a, NULL, LV_PART_KNOB);
+        lv_obj_remove_flag(a, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_size(a, radii[i] * 2, radii[i] * 2);
+        lv_obj_set_pos(a, cx - radii[i], cy - radii[i]);
+        lv_arc_set_bg_angles(a, 0, 360);
+        lv_arc_set_angles(a, 220, 320);
+        lv_obj_set_style_arc_opa(a, LV_OPA_TRANSP, LV_PART_MAIN);
+        lv_obj_set_style_arc_width(a, 4, LV_PART_INDICATOR);
+        lv_obj_set_style_arc_color(a, i == 0 ? C_CYAN : (i == 1 ? C_GREEN : C_VIOLET), LV_PART_INDICATOR);
+        lv_obj_set_style_arc_rounded(a, true, LV_PART_INDICATOR);
+    }
+    lv_obj_t *dot = plain(bootScreen);
+    lv_obj_set_size(dot, 16, 16);
+    lv_obj_set_pos(dot, cx - 8, cy - 8);
+    lv_obj_set_style_radius(dot, LV_RADIUS_CIRCLE, 0);
+    lv_obj_set_style_bg_color(dot, C_CYAN, 0);
+    lv_obj_set_style_bg_opa(dot, LV_OPA_COVER, 0);
+    lv_obj_set_style_shadow_color(dot, C_CYAN, 0);
+    lv_obj_set_style_shadow_width(dot, 18, 0);
+    lv_obj_set_style_shadow_opa(dot, LV_OPA_60, 0);
+
+    lv_obj_t *title = label(bootScreen, &lv_font_montserrat_28, C_TEXT, HOPTICS_NAME);
+    lv_obj_align(title, LV_ALIGN_CENTER, 0, LAND ? -8 : 34);
+    lv_obj_set_style_text_letter_space(title, 2, 0);
+    lv_obj_t *tag = label(bootScreen, &F12, C_MUTED, "mesh, made visible");
+    lv_obj_align_to(tag, title, LV_ALIGN_OUT_BOTTOM_MID, 0, 2);
+
+    lv_obj_t *spin = lv_spinner_create(bootScreen);
+    lv_obj_set_size(spin, 22, 22);
+    lv_spinner_set_anim_params(spin, 1000, 90);
+    lv_obj_set_style_arc_width(spin, 3, LV_PART_MAIN);
+    lv_obj_set_style_arc_width(spin, 3, LV_PART_INDICATOR);
+    lv_obj_set_style_arc_color(spin, C_LINE, LV_PART_MAIN);
+    lv_obj_set_style_arc_color(spin, C_CYAN, LV_PART_INDICATOR);
+    lv_obj_align(spin, LV_ALIGN_BOTTOM_MID, 0, LAND ? -64 : -52);
+
+    bootStatus = label(bootScreen, &F12, C_MUTED, "Starting radio...");
+    lv_obj_align(bootStatus, LV_ALIGN_BOTTOM_MID, 0, LAND ? -36 : -28);
+    char buf[64];
+    snprintf(buf, sizeof(buf), "v" HOPTICS_VERSION "  -  Meshtastic %s", fwVersion);
+    lv_obj_t *ver = label(bootScreen, FSMALL, C_DIM, buf);
+    lv_obj_align(ver, LV_ALIGN_BOTTOM_MID, 0, -8);
+
+    lv_screen_load(bootScreen);
+}
