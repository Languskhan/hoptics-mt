+void HopticsUI::openEnv(void)
+{
+    if (!envOv)
+        return;
+    envDirty |= 2;
+    refreshEnvOverlay();
+    lv_obj_scroll_to_y(lv_obj_get_child(envOv, 1), 0, LV_ANIM_OFF);
+    lv_obj_remove_flag(envOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(envOv, -1);
+    lv_obj_move_to_index(toast, -1);
+    keyScope(lv_obj_get_child(lv_obj_get_child(envOv, 1), 0)); // "NOW", at the top
+}
+
+void HopticsUI::closeEnv(void)
+{
+    if (!envOv)
+        return;
+    lv_obj_add_flag(envOv, LV_OBJ_FLAG_HIDDEN);
+    keyScope();
+}
+
+void HopticsUI::refreshEnvOverlay(void)
+{
+    if (!envOv)
+        return;
+    char a[32], b[32], ago[12];
+    std::string meta;
+    if (!envHasData()) {
+        lv_label_set_text(envOvNow, "No readings yet");
+        if (!hoptics::board::kSensorSlots)
+            meta = "This radio has no environment sensor. Readings that other nodes share are listed below.";
+        else
+            meta = minutesUp >= 5 ? "Nothing from the sensors so far. Check that the expansion board is seated; the log "
+                                    "lists the sensors found at start-up."
+                                  : "The sensors are read about once a minute.";
+    } else {
+        fmtTemp(a, sizeof(a), envNow.temp);
+        if (std::isnan(envNow.hum))
+            lv_label_set_text(envOvNow, a);
+        else
+            lv_label_set_text_fmt(envOvNow, "%s   %.0f%%", a, envNow.hum);
+        if (!std::isnan(envNow.temp) && !std::isnan(envNow.hum)) {
+            fmtTemp(b, sizeof(b), dewPointC(envNow.temp, envNow.hum));
+            meta += std::string("Dew point ") + b + "\n";
+        }
+        if (!std::isnan(envNow.press)) {
+            fmtPress(b, sizeof(b), envNow.press);
+            meta += std::string("Pressure ") + b;
+            const char *tr = pressTrend();
+            if (tr)
+                meta += std::string("   ") + tr;
+            meta += "\n";
+        }
+        if (!std::isnan(envNow.lux)) {
+            snprintf(b, sizeof(b), "Light %.0f lux\n", envNow.lux);
+            meta += b;
+        }
+        if (envNow.iaq >= 0) {
+            snprintf(b, sizeof(b), "Air quality (IAQ) %d\n", envNow.iaq);
+            meta += b;
+        }
+        agoString(envNowTime, ago, sizeof(ago));
+        meta += std::string("Updated ") + ago + " ago";
+    }
+    if (envCfgKnown)
+        meta += envShare ? std::string("\nShared on the mesh every ") + shareEveryText(envShareSecs)
+                         : std::string("\nNot shared - shown here and on the web page only");
+    lv_label_set_text(envOvMeta, meta.c_str());
+
+    if (envDirty & 2) {
+        for (int k = 0; k < 3; k++)
+            fillEnvChart(envOvChart[k], envOvSer[k], k, envOvCap[k]);
+    }
+    envDirty &= ~2;
+
+    // other nodes that shared readings, newest first
+    std::vector<const Node *> list;
+    for (const auto &n : nodes)
+        if (n.envTime && n.num != myNode && n.envTime <= nowTs + 60)
+            list.push_back(&n);
+    std::sort(list.begin(), list.end(), [](const Node *x, const Node *y) { return x->envTime > y->envTime; });
+    if (list.size() > 8)
+        list.resize(8);
+    if (keysOn) {
+        lv_obj_t *f = lv_group_get_focused(keyGroup);
+        envFocusNode = (f && lv_obj_get_parent(f) == envOvNearby) ? (uint32_t)(uintptr_t)lv_obj_get_user_data(f) : 0;
+    }
+    lv_obj_t *focusRow = nullptr;
+    lv_obj_clean(envOvNearby);
+    if (list.empty()) {
+        lv_obj_t *l = label(envOvNearby, &F12, C_MUTED, "No other node has shared readings yet.");
+        lv_obj_set_width(l, LV_PCT(100));
+        lv_label_set_long_mode(l, LV_LABEL_LONG_MODE_WRAP);
+        keyScope();
+        return;
+    }
+    for (const Node *n : list) {
+        lv_obj_t *r = plain(envOvNearby);
+        stop(r);
+        if (n->num == envFocusNode)
+            focusRow = r;
+        lv_obj_set_size(r, LV_PCT(100), 26);
+        row(r, 6);
+        lv_obj_add_flag(r, LV_OBJ_FLAG_CLICKABLE);
+        lv_obj_set_style_bg_color(r, C_CARD2, LV_STATE_PRESSED);
+        lv_obj_set_style_bg_opa(r, LV_OPA_COVER, LV_STATE_PRESSED);
+        lv_obj_set_style_radius(r, 6, 0);
+        lv_obj_t *bd = makeBadge(r, 40, 20, &F12);
+        setBadge(bd, n->num);
+        char nm[48];
+        lv_obj_t *name = label(r, &F12, C_TEXT, nodeLong(n->num, nm, sizeof(nm)));
+        lv_obj_set_flex_grow(name, 1);
+        oneLine(name);
+        std::string v;
+        if (!std::isnan(n->envTemp)) {
+            fmtTemp(a, sizeof(a), n->envTemp);
+            v += a;
+        }
+        if (!std::isnan(n->envHum)) {
+            snprintf(b, sizeof(b), "%s%.0f%%", v.empty() ? "" : "  ", n->envHum);
+            v += b;
+        }
+        if (v.empty() && !std::isnan(n->envPress)) {
+            fmtPress(a, sizeof(a), n->envPress);
+            v = a;
+        }
+        label(r, &F12, C_AMBER, v.c_str());
+        agoString(n->envTime, ago, sizeof(ago));
+        label(r, FSMALL, C_DIM, ago);
+        lv_obj_set_user_data(r, (void *)(uintptr_t)n->num);
+        lv_obj_add_event_cb(
+            r,
+            [](lv_event_t *e) {
+                HopticsUI *ui = (HopticsUI *)lv_event_get_user_data(e);
+                uint32_t num = (uint32_t)(uintptr_t)lv_obj_get_user_data((lv_obj_t *)lv_event_get_current_target(e));
+                if (num)
+                    ui->openNode(num);
+            },
+            LV_EVENT_CLICKED, this);
+    }
+    if (keysOn && !lv_obj_has_flag(envOv, LV_OBJ_FLAG_HIDDEN))
+        keyScope(focusRow);
+}
