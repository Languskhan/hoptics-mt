+void HopticsUI::appendBubble(const Msg &m)
+{
+    const bool mine = (m.from == myNode);
+    lv_obj_t *line = plain(chatMsgs);
+    lv_obj_set_size(line, LV_PCT(100), LV_SIZE_CONTENT);
+    lv_obj_set_flex_flow(line, LV_FLEX_FLOW_ROW);
+    lv_obj_set_flex_align(line, mine ? LV_FLEX_ALIGN_END : LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START);
+
+    lv_obj_t *b = plain(line);
+    lv_obj_set_size(b, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+    lv_obj_set_style_max_width(b, (W() * 4) / 5, 0);
+    lv_obj_set_style_bg_color(b, mine ? C_ME : C_CARD2, 0);
+    if (T_BORDERS && !mine) {
+        lv_obj_set_style_border_width(b, 1, 0);
+        lv_obj_set_style_border_color(b, C_LINE, 0);
+    }
+    lv_obj_set_style_bg_opa(b, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(b, 12, 0);
+    lv_obj_set_style_pad_hor(b, 9, 0);
+    lv_obj_set_style_pad_ver(b, 6, 0);
+    column(b, 2);
+
+    char buf[48];
+    if (!mine && chatKey < kMaxChannels) {
+        lv_obj_t *who = label(b, &F12, nodeColor(m.from), nodeLong(m.from, buf, sizeof(buf)));
+        oneLine(who);
+        lv_obj_set_style_max_width(who, (W() * 4) / 5 - 18, 0);
+    }
+    lv_obj_t *t = label(b, &F14, mine ? C_ON_ME : C_TEXT, m.text.c_str());
+    lv_label_set_long_mode(t, LV_LABEL_LONG_MODE_WRAP);
+    lv_obj_set_style_max_width(t, (W() * 4) / 5 - 18, 0);
+
+    char ts[24] = "";
+    if (m.time && m.time <= nowTs + 60) {
+        if (clockValid && m.time > 1600000000) {
+            time_t tt = m.time;
+            struct tm tmv;
+            localtime_r(&tt, &tmv);
+            snprintf(ts, sizeof(ts), "%02d:%02d", tmv.tm_hour, tmv.tm_min);
+        } else
+            agoString(m.time, ts, sizeof(ts));
+    }
+    lv_obj_t *meta = plain(b);
+    lv_obj_set_size(meta, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+    row(meta, 4);
+    label(meta, FSMALL, mine ? C_ME_META : C_DIM, ts);
+    if (mine) {
+        lv_obj_t *st = label(meta, FSMALL, m.status == eFailed || m.status == eNoResponse ? C_RED : C_ME_META,
+                             statusGlyph(m.status));
+        bubbleRefs.push_back({m.requestId, st});
+    }
+}
+
+void HopticsUI::rebuildChatMessages(void)
+{
+    lv_obj_clean(chatMsgs);
+    bubbleRefs.clear();
+    Conv *c = convPtr(chatKey);
+    if (!c || c->msgs.empty()) {
+        lv_obj_t *l = label(chatMsgs, &F12, C_DIM, chatKey < kMaxChannels ? "No messages on this channel yet." : "Say hello!");
+        lv_obj_set_width(l, LV_PCT(100));
+        lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+        lv_obj_set_style_pad_top(l, 40, 0);
+        return;
+    }
+    for (const auto &m : c->msgs)
+        appendBubble(m);
+    lv_obj_update_layout(chatMsgs);
+    lv_obj_scroll_to_y(chatMsgs, LV_COORD_MAX, LV_ANIM_OFF);
+}
+
+void HopticsUI::openChat(uint32_t key)
+{
+    chatKey = key;
+    char buf[64];
+    lv_label_set_text(chatTitle, convTitle(key, buf, sizeof(buf)));
+    Conv &c = convRef(key);
+    c.unread = 0;
+    if (cbs.conversationRead)
+        cbs.conversationRead(key);
+    rebuildChatMessages();
+    lv_obj_remove_flag(chatOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(chatOv, -1);
+    if (!lv_obj_has_flag(nodeOv, LV_OBJ_FLAG_HIDDEN))
+        lv_obj_add_flag(nodeOv, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_move_to_index(toast, -1);
+    dirtyChats = true;
+    refreshStatusBar();
+}
+
+void HopticsUI::closeChat(void)
+{
+    hideKeyboard();
+    lv_obj_add_flag(chatOv, LV_OBJ_FLAG_HIDDEN);
+    chatKey = UINT32_MAX;
+    lv_obj_clean(chatMsgs);
+    bubbleRefs.clear();
+    if (activeTab == T_CHAT)
+        refreshChatList();
+}
+
+void HopticsUI::sendFromChat(void)
+{
+    const char *txt = lv_textarea_get_text(chatInput);
+    if (!txt || !txt[0] || chatKey == UINT32_MAX)
+        return;
+    std::string text(txt);
+    uint32_t reqId = cbs.sendText ? cbs.sendText(chatKey, text.c_str()) : 0;
+    lv_textarea_set_text(chatInput, "");
+    addMessage(chatKey, myNode, nowTs, text.c_str(), reqId, eNone, false);
+}
